theorem OAI.CirculantHadamard.exists_iff_order_one_or_four : ∀ (n : ℕ),
  0 < n → (OAI.CirculantHadamard.ExistsRealCirculantHadamard n ↔ n = 1 ∨ n = 4) :=
fun n hn =>
  {
    mp := fun hH =>
      if hn1 : n = 1 then Or.inl hn1
      else
        have hnlarge :=
          Decidable.byContradiction fun a => OAI.CirculantHadamard.exists_iff_order_one_or_four._proof_1_1 n hn hn1 a;
        Exists.casesOn (OAI.CirculantHadamard.order_reduction hnlarge hH) fun u h =>
          And.casesOn h fun hu right =>
            And.casesOn right fun hodd right =>
              Eq.ndrec (motive := fun n =>
                0 < n → OAI.CirculantHadamard.ExistsRealCirculantHadamard n → ¬n = 1 → 1 < n → n = 1 ∨ n = 4)
                (fun hn hH hn1 hnlarge =>
                  if hu1 : u = 1 then
                    Or.inr
                      (of_eq_true
                        (Eq.trans
                          (congrFun'
                            (congrArg Eq
                              (Eq.trans
                                (congrArg (HMul.hMul 4) (Eq.trans (congrFun' (congrArg HPow.hPow hu1) 2) (one_pow 2)))
                                (mul_one 4)))
                            4)
                          (eq_self 4)))
                  else
                    have hul :=
                      Decidable.byContradiction fun a =>
                        OAI.CirculantHadamard.exists_iff_order_one_or_four._proof_1_1 u hu hu1 a;
                    False.elim (OAI.CirculantHadamard.not_exists_four_mul_odd_square hul hodd hH))
                (Eq.symm right) hn hH hn1 hnlarge,
    mpr := OAI.CirculantHadamard.exists_of_order_one_or_four }
