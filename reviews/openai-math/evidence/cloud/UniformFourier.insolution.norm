OAI.PowerSaving.transform_main : OAI.PowerSaving.DFTGoal OAI.PowerSaving.convolution_main : OAI.PowerSaving.ConvGoal def OAI.ExactFourier.zeta : ℕ → ℂ := fun n => Complex.exp (2 * ↑Real.pi * Complex.I / ↑n) structure OAI.PowerSaving.Tape.{u} (α : Type u) : Type u number of parameters: 1 fields: OAI.PowerSaving.Tape.len : ℕ OAI.PowerSaving.Tape.pos : Fin self.len → α constructor: OAI.PowerSaving.Tape.mk.{u} {α : Type u} (len : ℕ) (pos : Fin len → α) : OAI.PowerSaving.Tape α def OAI.PowerSaving.Tape.empty.{u} : (α : Type u) → OAI.PowerSaving.Tape α := fun α => { len := 0, pos := Fin.elim0 } def OAI.PowerSaving.Tape.tab.{u} : {α : Type u} → ℕ → (ℕ → α) → OAI.PowerSaving.Tape α := fun {α} n f => { len := n, pos := fun i => f ↑i } def OAI.PowerSaving.Tape.look.{u} : {α : Type u} → OAI.PowerSaving.Tape α → ℕ → α → α := fun {α} v i z => if h : i < v.len then v.pos ⟨i, h⟩ else z def OAI.PowerSaving.Tape.set.{u} : {α : Type u} → OAI.PowerSaving.Tape α → ℕ → α → OAI.PowerSaving.Tape α := fun {α} v i x => { len := v.len, pos := fun j => if ↑j = i then x else v.pos j } def OAI.PowerSaving.Tape.sow.{u} : {α : Type u} → ℕ → ℕ → α → (ℕ → ℕ × α) → OAI.PowerSaving.Tape α := fun {α} len count z f => OAI.PowerSaving.Tape.sow.iter len z f count def OAI.PowerSaving.Tape.map.{u, v} : {α : Type u} → {β : Type v} → (α → β) → OAI.PowerSaving.Tape α → OAI.PowerSaving.Tape β := fun {α} {β} f v => { len := v.len, pos := fun i => f (v.pos i) } inductive OAI.PowerSaving.RAM.Paint : Type number of parameters: 0 constructors: OAI.PowerSaving.RAM.Paint.scalar : OAI.PowerSaving.RAM.Paint OAI.PowerSaving.RAM.Paint.left : OAI.PowerSaving.RAM.Paint OAI.PowerSaving.RAM.Paint.right : OAI.PowerSaving.RAM.Paint OAI.PowerSaving.RAM.Paint.both : OAI.PowerSaving.RAM.Paint inductive OAI.PowerSaving.RAM.Ty : Type number of parameters: 0 constructors: OAI.PowerSaving.RAM.Ty.w : OAI.PowerSaving.RAM.Ty OAI.PowerSaving.RAM.Ty.c : OAI.PowerSaving.RAM.Paint → OAI.PowerSaving.RAM.Ty OAI.PowerSaving.RAM.Ty.p : OAI.PowerSaving.RAM.Ty → OAI.PowerSaving.RAM.Ty → OAI.PowerSaving.RAM.Ty OAI.PowerSaving.RAM.Ty.a : OAI.PowerSaving.RAM.Ty → OAI.PowerSaving.RAM.Ty @[reducible] def OAI.PowerSaving.RAM.sc : OAI.PowerSaving.RAM.Ty := OAI.PowerSaving.RAM.Ty.c OAI.PowerSaving.RAM.Paint.scalar @[reducible] def OAI.PowerSaving.RAM.Ty.T : OAI.PowerSaving.RAM.Ty → Type := fun x => OAI.PowerSaving.RAM.Ty.brecOn x OAI.PowerSaving.RAM.Ty.T._f def OAI.PowerSaving.RAM.Ty.blank : (t : OAI.PowerSaving.RAM.Ty) → t.T := fun x => OAI.PowerSaving.RAM.Ty.brecOn x OAI.PowerSaving.RAM.Ty.blank._f structure OAI.PowerSaving.RAM.Bill.{u} (α : Type u) : Type u number of parameters: 1 fields: OAI.PowerSaving.RAM.Bill.val : α OAI.PowerSaving.RAM.Bill.work : ℕ OAI.PowerSaving.RAM.Bill.peak : ℕ OAI.PowerSaving.RAM.Bill.valid : Prop constructor: OAI.PowerSaving.RAM.Bill.mk.{u} {α : Type u} (val : α) (work peak : ℕ) (valid : Prop) : OAI.PowerSaving.RAM.Bill α def OAI.PowerSaving.RAM.Bill.pay.{u} : {α : Type u} → OAI.PowerSaving.RAM.Bill α → ℕ → ℕ → OAI.PowerSaving.RAM.Bill α := fun {α} b n m => { val := b.val, work := b.work + n, peak := max b.peak m, valid := b.valid } def OAI.PowerSaving.RAM.Bill.pass.{u, v} : {α : Type u} → {β : Type v} → OAI.PowerSaving.RAM.Bill α → (α → OAI.PowerSaving.RAM.Bill β) → OAI.PowerSaving.RAM.Bill β := fun {α} {β} b f => have d := f b.val; { val := d.val, work := b.work + d.work, peak := max b.peak d.peak, valid := b.valid ∧ d.valid } def OAI.PowerSaving.RAM.Bill.one.{u} : {α : Type u} → α → OAI.PowerSaving.RAM.Bill α := fun {α} x => { val := x, work := 1, peak := 0, valid := True } def OAI.PowerSaving.RAM.Bill.word : ℕ → OAI.PowerSaving.RAM.Bill ℕ := fun x => { val := x, work := 1, peak := x, valid := True } def OAI.PowerSaving.RAM.Bill.steps.{u} : {α : Type u} → α → (ℕ → α → OAI.PowerSaving.RAM.Bill α) → ℕ → OAI.PowerSaving.RAM.Bill α := fun {α} init f x => Nat.brecOn x (OAI.PowerSaving.RAM.Bill.steps._f init f) def OAI.PowerSaving.RAM.Bill.sow.{u} : {α : Type u} → ℕ → ℕ → α → (ℕ → OAI.PowerSaving.RAM.Bill (ℕ × α)) → OAI.PowerSaving.RAM.Bill (OAI.PowerSaving.Tape α) := fun {α} len count z f => (OAI.PowerSaving.RAM.Bill.steps (OAI.PowerSaving.Tape.tab len fun x => z) (fun i v => (f i).pass fun s => OAI.PowerSaving.RAM.Bill.one (v.set s.1 s.2)) count).pay (1 + len) len def OAI.PowerSaving.RAM.Bill.tab.{u} : {α : Type u} → ℕ → α → (ℕ → OAI.PowerSaving.RAM.Bill α) → OAI.PowerSaving.RAM.Bill (OAI.PowerSaving.Tape α) := fun {α} len z f => OAI.PowerSaving.RAM.Bill.sow len len z fun i => (f i).pass fun y => OAI.PowerSaving.RAM.Bill.one (i, y) inductive OAI.PowerSaving.RAM.NOp : Type number of parameters: 0 constructors: OAI.PowerSaving.RAM.NOp.add : OAI.PowerSaving.RAM.NOp OAI.PowerSaving.RAM.NOp.sub : OAI.PowerSaving.RAM.NOp OAI.PowerSaving.RAM.NOp.mul : OAI.PowerSaving.RAM.NOp OAI.PowerSaving.RAM.NOp.div : OAI.PowerSaving.RAM.NOp OAI.PowerSaving.RAM.NOp.mod : OAI.PowerSaving.RAM.NOp OAI.PowerSaving.RAM.NOp.lt : OAI.PowerSaving.RAM.NOp inductive OAI.PowerSaving.RAM.Atom : Bool → OAI.PowerSaving.RAM.Ty → OAI.PowerSaving.RAM.Ty → Type number of parameters: 1 constructors: OAI.PowerSaving.RAM.Atom.lit : {allow : Bool} → {a : OAI.PowerSaving.RAM.Ty} → ℕ → OAI.PowerSaving.RAM.Atom allow a OAI.PowerSaving.RAM.Ty.w OAI.PowerSaving.RAM.Atom.int : {allow : Bool} → OAI.PowerSaving.RAM.NOp → OAI.PowerSaving.RAM.Atom allow (OAI.PowerSaving.RAM.Ty.w.p OAI.PowerSaving.RAM.Ty.w) OAI.PowerSaving.RAM.Ty.w OAI.PowerSaving.RAM.Atom.cz : {allow : Bool} → (t : OAI.PowerSaving.RAM.Paint) → {a : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Atom allow a (OAI.PowerSaving.RAM.Ty.c t) OAI.PowerSaving.RAM.Atom.cone : {allow : Bool} → {a : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Atom allow a OAI.PowerSaving.RAM.sc OAI.PowerSaving.RAM.Atom.add : {allow : Bool} → (t : OAI.PowerSaving.RAM.Paint) → OAI.PowerSaving.RAM.Atom allow ((OAI.PowerSaving.RAM.Ty.c t).p (OAI.PowerSaving.RAM.Ty.c t)) (OAI.PowerSaving.RAM.Ty.c t) OAI.PowerSaving.RAM.Atom.sub : {allow : Bool} → (t : OAI.PowerSaving.RAM.Paint) → OAI.PowerSaving.RAM.Atom allow ((OAI.PowerSaving.RAM.Ty.c t).p (OAI.PowerSaving.RAM.Ty.c t)) (OAI.PowerSaving.RAM.Ty.c t) OAI.PowerSaving.RAM.Atom.scale : {allow : Bool} → (t : OAI.PowerSaving.RAM.Paint) → OAI.PowerSaving.RAM.Atom allow (OAI.PowerSaving.RAM.sc.p (OAI.PowerSaving.RAM.Ty.c t)) (OAI.PowerSaving.RAM.Ty.c t) OAI.PowerSaving.RAM.Atom.inv : {allow : Bool} → OAI.PowerSaving.RAM.Atom allow OAI.PowerSaving.RAM.sc OAI.PowerSaving.RAM.sc OAI.PowerSaving.RAM.Atom.cross : {allow : Bool} → allow = true → OAI.PowerSaving.RAM.Atom allow ((OAI.PowerSaving.RAM.Ty.c OAI.PowerSaving.RAM.Paint.left).p (OAI.PowerSaving.RAM.Ty.c OAI.PowerSaving.RAM.Paint.right)) (OAI.PowerSaving.RAM.Ty.c OAI.PowerSaving.RAM.Paint.both) OAI.PowerSaving.RAM.Atom.id : {allow : Bool} → {a : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Atom allow a a OAI.PowerSaving.RAM.Atom.fst : {allow : Bool} → {a b : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Atom allow (a.p b) a OAI.PowerSaving.RAM.Atom.snd : {allow : Bool} → {a b : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Atom allow (a.p b) b OAI.PowerSaving.RAM.Atom.len : {allow : Bool} → {s : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Atom allow s.a OAI.PowerSaving.RAM.Ty.w OAI.PowerSaving.RAM.Atom.look : {allow : Bool} → {s : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Atom allow (s.a.p OAI.PowerSaving.RAM.Ty.w) s def OAI.PowerSaving.RAM.NOp.run : OAI.PowerSaving.RAM.NOp → ℕ × ℕ → OAI.PowerSaving.RAM.Bill ℕ := fun x x_1 => match x, x_1 with | OAI.PowerSaving.RAM.NOp.add, (i, j) => OAI.PowerSaving.RAM.Bill.word (i + j) | OAI.PowerSaving.RAM.NOp.sub, (i, j) => OAI.PowerSaving.RAM.Bill.word (i - j) | OAI.PowerSaving.RAM.NOp.mul, (i, j) => OAI.PowerSaving.RAM.Bill.word (i * j) | OAI.PowerSaving.RAM.NOp.div, (i, j) => OAI.PowerSaving.RAM.Bill.word (i / j) | OAI.PowerSaving.RAM.NOp.mod, (i, j) => OAI.PowerSaving.RAM.Bill.word (i % j) | OAI.PowerSaving.RAM.NOp.lt, (i, j) => OAI.PowerSaving.RAM.Bill.word (if i < j then 1 else 0) def OAI.PowerSaving.RAM.Atom.run : {allow : Bool} → {a b : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Atom allow a b → a.T → OAI.PowerSaving.RAM.Bill b.T := fun {allow} {a b} x x_1 => match a, b, x, x_1 with | a, .(OAI.PowerSaving.RAM.Ty.w), OAI.PowerSaving.RAM.Atom.lit n, x => OAI.PowerSaving.RAM.Bill.word n | .(OAI.PowerSaving.RAM.Ty.w.p OAI.PowerSaving.RAM.Ty.w), .(OAI.PowerSaving.RAM.Ty.w), OAI.PowerSaving.RAM.Atom.int f, x => f.run x | a, .(OAI.PowerSaving.RAM.Ty.c t), OAI.PowerSaving.RAM.Atom.cz t, x => OAI.PowerSaving.RAM.Bill.one 0 | a, .(OAI.PowerSaving.RAM.sc), OAI.PowerSaving.RAM.Atom.cone, x => OAI.PowerSaving.RAM.Bill.one 1 | .((OAI.PowerSaving.RAM.Ty.c t).p (OAI.PowerSaving.RAM.Ty.c t)), .(OAI.PowerSaving.RAM.Ty.c t), OAI.PowerSaving.RAM.Atom.add t, (x, y) => OAI.PowerSaving.RAM.Bill.one (x + y) | .((OAI.PowerSaving.RAM.Ty.c t).p (OAI.PowerSaving.RAM.Ty.c t)), .(OAI.PowerSaving.RAM.Ty.c t), OAI.PowerSaving.RAM.Atom.sub t, (x, y) => OAI.PowerSaving.RAM.Bill.one (x - y) | .(OAI.PowerSaving.RAM.sc.p (OAI.PowerSaving.RAM.Ty.c t)), .(OAI.PowerSaving.RAM.Ty.c t), OAI.PowerSaving.RAM.Atom.scale t, (x, y) => OAI.PowerSaving.RAM.Bill.one (x * y) | .(OAI.PowerSaving.RAM.sc), .(OAI.PowerSaving.RAM.sc), OAI.PowerSaving.RAM.Atom.inv, x => { val := x⁻¹, work := 1, peak := 0, valid := x ≠ 0 } | .((OAI.PowerSaving.RAM.Ty.c OAI.PowerSaving.RAM.Paint.left).p (OAI.PowerSaving.RAM.Ty.c OAI.PowerSaving.RAM.Paint.right)), .(OAI.PowerSaving.RAM.Ty.c OAI.PowerSaving.RAM.Paint.both), OAI.PowerSaving.RAM.Atom.cross h, (x, y) => OAI.PowerSaving.RAM.Bill.one (x * y) | a, .(a), OAI.PowerSaving.RAM.Atom.id, x => OAI.PowerSaving.RAM.Bill.one x | .(b.p b_1), b, OAI.PowerSaving.RAM.Atom.fst, x => OAI.PowerSaving.RAM.Bill.one x.1 | .(a.p b), b, OAI.PowerSaving.RAM.Atom.snd, x => OAI.PowerSaving.RAM.Bill.one x.2 | .(s.a), .(OAI.PowerSaving.RAM.Ty.w), OAI.PowerSaving.RAM.Atom.len, x => OAI.PowerSaving.RAM.Bill.word x.len | .(s.a.p OAI.PowerSaving.RAM.Ty.w), s, OAI.PowerSaving.RAM.Atom.look, (x, i) => OAI.PowerSaving.RAM.Bill.one (OAI.PowerSaving.Tape.look x i s.blank) @[reducible] def OAI.PowerSaving.RAM.Port : Type := Option (OAI.PowerSaving.RAM.Ty × OAI.PowerSaving.RAM.Ty) inductive OAI.PowerSaving.RAM.Code : Bool → OAI.PowerSaving.RAM.Port → OAI.PowerSaving.RAM.Ty → OAI.PowerSaving.RAM.Ty → Type number of parameters: 1 constructors: OAI.PowerSaving.RAM.Code.atom : {allow : Bool} → {r : OAI.PowerSaving.RAM.Port} → {s t : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Atom allow s t → OAI.PowerSaving.RAM.Code allow r s t OAI.PowerSaving.RAM.Code.comp : {allow : Bool} → {r : OAI.PowerSaving.RAM.Port} → {s t u : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Code allow r s t → OAI.PowerSaving.RAM.Code allow r t u → OAI.PowerSaving.RAM.Code allow r s u OAI.PowerSaving.RAM.Code.fork : {allow : Bool} → {r : OAI.PowerSaving.RAM.Port} → {s t u : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Code allow r s t → OAI.PowerSaving.RAM.Code allow r s u → OAI.PowerSaving.RAM.Code allow r s (t.p u) OAI.PowerSaving.RAM.Code.ifz : {allow : Bool} → {r : OAI.PowerSaving.RAM.Port} → {s t : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Code allow r s OAI.PowerSaving.RAM.Ty.w → OAI.PowerSaving.RAM.Code allow r s t → OAI.PowerSaving.RAM.Code allow r s t → OAI.PowerSaving.RAM.Code allow r s t OAI.PowerSaving.RAM.Code.loop : {allow : Bool} → {r : OAI.PowerSaving.RAM.Port} → {s t : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Code allow r s OAI.PowerSaving.RAM.Ty.w → OAI.PowerSaving.RAM.Code allow r s t → OAI.PowerSaving.RAM.Code allow r (s.p (OAI.PowerSaving.RAM.Ty.w.p t)) t → OAI.PowerSaving.RAM.Code allow r s t OAI.PowerSaving.RAM.Code.tab : {allow : Bool} → {r : OAI.PowerSaving.RAM.Port} → {s t : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Code allow r s OAI.PowerSaving.RAM.Ty.w → OAI.PowerSaving.RAM.Code allow r (s.p OAI.PowerSaving.RAM.Ty.w) t → OAI.PowerSaving.RAM.Code allow r s t.a OAI.PowerSaving.RAM.Code.sow : {allow : Bool} → {r : OAI.PowerSaving.RAM.Port} → {s t : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Code allow r s OAI.PowerSaving.RAM.Ty.w → OAI.PowerSaving.RAM.Code allow r s OAI.PowerSaving.RAM.Ty.w → OAI.PowerSaving.RAM.Code allow r (s.p OAI.PowerSaving.RAM.Ty.w) (OAI.PowerSaving.RAM.Ty.w.p t) → OAI.PowerSaving.RAM.Code allow r s t.a OAI.PowerSaving.RAM.Code.importClosed : {allow : Bool} → {r : OAI.PowerSaving.RAM.Port} → {s t : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Code allow none s t → OAI.PowerSaving.RAM.Code allow r s t OAI.PowerSaving.RAM.Code.call : {allow : Bool} → {s t : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Code allow (some (s, t)) s t OAI.PowerSaving.RAM.Code.descend : {allow : Bool} → {r : OAI.PowerSaving.RAM.Port} → {s t : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Code allow none s t → OAI.PowerSaving.RAM.Code allow (some (s, t)) s t → OAI.PowerSaving.RAM.Code allow r (OAI.PowerSaving.RAM.Ty.w.p s) t @[reducible] def OAI.PowerSaving.RAM.Handler : OAI.PowerSaving.RAM.Port → Type := fun x => match x with | none => Unit | some (s, t) => s.T → OAI.PowerSaving.RAM.Bill t.T def OAI.PowerSaving.RAM.depthRun.{u, v} : {α : Type u} → {β : Type v} → (α → OAI.PowerSaving.RAM.Bill β) → ((α → OAI.PowerSaving.RAM.Bill β) → α → OAI.PowerSaving.RAM.Bill β) → ℕ → α → OAI.PowerSaving.RAM.Bill β := fun {α} {β} base step x x_1 => Nat.brecOn (motive := fun x => α → OAI.PowerSaving.RAM.Bill β) x (OAI.PowerSaving.RAM.depthRun._f base step) x_1 def OAI.PowerSaving.RAM.Code.run : {allow : Bool} → {r : OAI.PowerSaving.RAM.Port} → {s t : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Code allow r s t → OAI.PowerSaving.RAM.Handler r → s.T → OAI.PowerSaving.RAM.Bill t.T := fun {allow} {r} {s t} x x_1 x_2 => OAI.PowerSaving.RAM.Code.brecOn (motive := fun {r} {s t} x => OAI.PowerSaving.RAM.Handler r → s.T → OAI.PowerSaving.RAM.Bill t.T) x (@OAI.PowerSaving.RAM.Code.run._f allow) x_1 x_2 @[reducible] def OAI.PowerSaving.RAM.Prog : Bool → OAI.PowerSaving.RAM.Ty → OAI.PowerSaving.RAM.Ty → Type := fun allow s t => OAI.PowerSaving.RAM.Code allow none s t @[reducible] def OAI.PowerSaving.RAM.run : {allow : Bool} → {s t : OAI.PowerSaving.RAM.Ty} → OAI.PowerSaving.RAM.Prog allow s t → s.T → OAI.PowerSaving.RAM.Bill t.T := fun {allow} {s t} f x => OAI.PowerSaving.RAM.Code.run f () x def OAI.PowerSaving.paperM : ℝ := 1000000 def OAI.PowerSaving.paperW : ℝ := ↑2 ^ 71 def OAI.PowerSaving.paperDelta : ℝ := 6871402692000000 def OAI.PowerSaving.paperMultiplier : ℝ := OAI.PowerSaving.paperM - OAI.PowerSaving.paperDelta / OAI.PowerSaving.paperW def OAI.PowerSaving.theta : ℝ := Real.log OAI.PowerSaving.paperMultiplier / Real.log OAI.PowerSaving.paperM def OAI.PowerSaving.decimalExponent : ℝ := 1 - 1 / 10 ^ 13 def OAI.PowerSaving.paperTime : ℕ → ℝ := fun n => ↑n * Real.log ↑n ^ OAI.PowerSaving.theta * Real.log (Real.log ↑n) ^ (4 - OAI.PowerSaving.theta) def OAI.PowerSaving.decimalTime : ℕ → ℝ := fun n => ↑n * Real.log ↑n ^ OAI.PowerSaving.decimalExponent def OAI.PowerSaving.nlogn : ℕ → ℝ := fun n => ↑n * Real.log ↑n @[reducible] def OAI.PowerSaving.root : ℕ → ℂ := OAI.ExactFourier.zeta @[reducible] def OAI.PowerSaving.Vec : ℕ → Type := fun n => Fin n → ℂ def OAI.PowerSaving.dft : (n : ℕ) → OAI.PowerSaving.Vec n → OAI.PowerSaving.Vec n := fun n x j => ∑ k, OAI.PowerSaving.root n ^ (↑j * ↑k) * x k def OAI.PowerSaving.conv : (n : ℕ) → OAI.PowerSaving.Vec n → OAI.PowerSaving.Vec n → OAI.PowerSaving.Vec (2 * n - 1) := fun n x y k => ∑ r, ∑ s, if ↑r + ↑s = ↑k then x r * y s else 0 @[reducible] def OAI.PowerSaving.dftInKind : OAI.PowerSaving.RAM.Ty := OAI.PowerSaving.RAM.Ty.w.p (OAI.PowerSaving.RAM.sc.p (OAI.PowerSaving.RAM.Ty.c OAI.PowerSaving.RAM.Paint.left).a) @[reducible] def OAI.PowerSaving.dftOutKind : OAI.PowerSaving.RAM.Ty := (OAI.PowerSaving.RAM.Ty.c OAI.PowerSaving.RAM.Paint.left).a @[reducible] def OAI.PowerSaving.convInKind : OAI.PowerSaving.RAM.Ty := OAI.PowerSaving.RAM.Ty.w.p (OAI.PowerSaving.RAM.sc.p ((OAI.PowerSaving.RAM.Ty.c OAI.PowerSaving.RAM.Paint.left).a.p (OAI.PowerSaving.RAM.Ty.c OAI.PowerSaving.RAM.Paint.right).a)) @[reducible] def OAI.PowerSaving.convOutKind : OAI.PowerSaving.RAM.Ty := (OAI.PowerSaving.RAM.Ty.c OAI.PowerSaving.RAM.Paint.both).a def OAI.PowerSaving.DFTProgram : OAI.PowerSaving.RAM.Prog false OAI.PowerSaving.RAM.Ty.w OAI.PowerSaving.RAM.Ty.w → OAI.PowerSaving.RAM.Prog false OAI.PowerSaving.dftInKind OAI.PowerSaving.dftOutKind → (ℕ → ℕ) → Prop := fun order solve W => ∃ cBound, ∀ (n : ℕ), 0 < n → have cap := (n + 2) ^ cBound; have d := OAI.PowerSaving.RAM.run order n; W n + 10 * (n + 2) ≤ cap ∧ d.peak ≤ cap ∧ d.valid ∧ 0 < d.val ∧ d.val < 1024 * n ^ 3 ∧ d.val ≤ cap ∧ ∀ (x : OAI.PowerSaving.Vec n), have result := OAI.PowerSaving.RAM.run solve (n, OAI.PowerSaving.root d.val, { len := n, pos := x }); result.valid ∧ result.peak ≤ cap ∧ d.work + 1 + result.work ≤ W n ∧ result.val = { len := n, pos := OAI.PowerSaving.dft n x } def OAI.PowerSaving.ConvProgram : OAI.PowerSaving.RAM.Prog false OAI.PowerSaving.RAM.Ty.w OAI.PowerSaving.RAM.Ty.w → OAI.PowerSaving.RAM.Prog true OAI.PowerSaving.convInKind OAI.PowerSaving.convOutKind → (ℕ → ℕ) → Prop := fun order solve W => ∃ cBound, ∀ (n : ℕ), 0 < n → have cap := (n + 2) ^ cBound; have d := OAI.PowerSaving.RAM.run order n; W n + 10 * (n + 2) ≤ cap ∧ d.peak ≤ cap ∧ d.valid ∧ 0 < d.val ∧ d.val < 1024 * (2 * n - 1) ^ 3 ∧ d.val ≤ cap ∧ ∀ (x y : OAI.PowerSaving.Vec n), have result := OAI.PowerSaving.RAM.run solve (n, OAI.PowerSaving.root d.val, { len := n, pos := x }, { len := n, pos := y }); result.valid ∧ result.peak ≤ cap ∧ d.work + 1 + result.work ≤ W n ∧ result.val = { len := 2 * n - 1, pos := OAI.PowerSaving.conv n x y } def OAI.PowerSaving.TimeBounds : (ℕ → ℕ) → Prop := fun W => have W' := fun n => ↑(W n); W' =O[Filter.atTop] OAI.PowerSaving.paperTime ∧ W' =O[Filter.atTop] OAI.PowerSaving.decimalTime ∧ W' =o[Filter.atTop] OAI.PowerSaving.nlogn def OAI.PowerSaving.DFTGoal : Prop := ∃ order solve W, OAI.PowerSaving.DFTProgram order solve W ∧ OAI.PowerSaving.TimeBounds W def OAI.PowerSaving.ConvGoal : Prop := ∃ order solve W, OAI.PowerSaving.ConvProgram order solve W ∧ OAI.PowerSaving.TimeBounds W 