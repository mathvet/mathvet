OAI.DepthThreeLowerBound.exists_polynomial_time_language_depth_three_lower_bound : ∃ L M C a, 0 < C ∧ 0 < a ∧ (∀ (w : List Bool), OAI.DepthThreeLowerBound.MultiTapeHaltsIn M w (L w) (C * (w.length + 1) ^ a)) ∧ ∀ (A : ℝ), 0 < A → ∃ N, ∀ (n : ℕ), N ≤ n → ∀ (D : OAI.DepthThreeLowerBound.Circuit3 (Fin n)), (D.Computes fun x => L (List.ofFn x)) → 2 ^ (A * √↑n) < ↑D.gateCount @[reducible] def OAI.DepthThreeLowerBound.Cube.{uV} : Type uV → Type uV := fun V => V → Bool @[reducible] def OAI.DepthThreeLowerBound.Literal.{uV} : Type uV → Type (max uV 0) := fun V => V × Bool def OAI.DepthThreeLowerBound.Literal.eval.{uV} : {V : Type uV} → OAI.DepthThreeLowerBound.Literal V → OAI.DepthThreeLowerBound.Cube V → Bool := fun {V} l x => decide (x l.1 = l.2) @[reducible] def OAI.DepthThreeLowerBound.GateInput.{uV} : Type uV → Type (max uV 0) := fun V => OAI.DepthThreeLowerBound.Literal V ⊕ Bool @[reducible] def OAI.DepthThreeLowerBound.RawClause.{uV} : Type uV → Type uV := fun V => List (OAI.DepthThreeLowerBound.GateInput V) def OAI.DepthThreeLowerBound.GateInput.eval.{uV} : {V : Type uV} → OAI.DepthThreeLowerBound.GateInput V → OAI.DepthThreeLowerBound.Cube V → Bool := fun {V} x x_1 => match x, x_1 with | Sum.inl l, x => l.eval x | Sum.inr b, x => b def OAI.DepthThreeLowerBound.RawClause.eval.{uV} : {V : Type uV} → OAI.DepthThreeLowerBound.RawClause V → OAI.DepthThreeLowerBound.Cube V → Bool := fun {V} C x => decide (∃ l ∈ C, l.eval x = true) structure OAI.DepthThreeLowerBound.Circuit3.{uV} (V : Type uV) : Type uV number of parameters: 1 fields: OAI.DepthThreeLowerBound.Circuit3.bottomCount : ℕ OAI.DepthThreeLowerBound.Circuit3.middleCount : ℕ OAI.DepthThreeLowerBound.Circuit3.bottom : Fin self.bottomCount → OAI.DepthThreeLowerBound.RawClause V OAI.DepthThreeLowerBound.Circuit3.middle : Fin self.middleCount → Finset (Fin self.bottomCount) OAI.DepthThreeLowerBound.Circuit3.top : Finset (Fin self.middleCount) constructor: OAI.DepthThreeLowerBound.Circuit3.mk.{uV} {V : Type uV} (bottomCount middleCount : ℕ) (bottom : Fin bottomCount → OAI.DepthThreeLowerBound.RawClause V) (middle : Fin middleCount → Finset (Fin bottomCount)) (top : Finset (Fin middleCount)) : OAI.DepthThreeLowerBound.Circuit3 V def OAI.DepthThreeLowerBound.Circuit3.gateCount.{uV} : {V : Type uV} → OAI.DepthThreeLowerBound.Circuit3 V → ℕ := fun {V} C => C.bottomCount + C.middleCount + 1 def OAI.DepthThreeLowerBound.Circuit3.middleEval.{uV} : {V : Type uV} → (C : OAI.DepthThreeLowerBound.Circuit3 V) → Fin C.middleCount → OAI.DepthThreeLowerBound.Cube V → Bool := fun {V} C j x => decide (∀ i ∈ C.middle j, (C.bottom i).eval x = true) def OAI.DepthThreeLowerBound.Circuit3.eval.{uV} : {V : Type uV} → OAI.DepthThreeLowerBound.Circuit3 V → OAI.DepthThreeLowerBound.Cube V → Bool := fun {V} C x => decide (∃ j ∈ C.top, C.middleEval j x = true) def OAI.DepthThreeLowerBound.Circuit3.Computes.{uV} : {V : Type uV} → OAI.DepthThreeLowerBound.Circuit3 V → (OAI.DepthThreeLowerBound.Cube V → Bool) → Prop := fun {V} C f => ∀ (x : OAI.DepthThreeLowerBound.Cube V), C.eval x = f x def OAI.DepthThreeLowerBound.runSteps.{uS} : {S : Type uS} → (S → Option S) → ℕ → Option S → Option S := fun {S} step n c => (fun oc => oc.bind step)^[n] c inductive OAI.DepthThreeLowerBound.HeadMove : Type number of parameters: 0 constructors: OAI.DepthThreeLowerBound.HeadMove.left : OAI.DepthThreeLowerBound.HeadMove OAI.DepthThreeLowerBound.HeadMove.stay : OAI.DepthThreeLowerBound.HeadMove OAI.DepthThreeLowerBound.HeadMove.right : OAI.DepthThreeLowerBound.HeadMove def OAI.DepthThreeLowerBound.HeadMove.apply.{uGamma} : {Γ : Type uGamma} → [inst : Inhabited Γ] → OAI.DepthThreeLowerBound.HeadMove → Turing.Tape Γ → Turing.Tape Γ := fun {Γ} [Inhabited Γ] x x_1 => match x, x_1 with | OAI.DepthThreeLowerBound.HeadMove.left, t => Turing.Tape.move Turing.Dir.left t | OAI.DepthThreeLowerBound.HeadMove.stay, t => t | OAI.DepthThreeLowerBound.HeadMove.right, t => Turing.Tape.move Turing.Dir.right t structure OAI.DepthThreeLowerBound.MultiTapeCfg.{uK, uGamma, uQ} (K : Type uK) (Γ : Type uGamma) (Q : Type uQ) [Inhabited Γ] : Type (max (max uGamma uK) uQ) number of parameters: 4 fields: OAI.DepthThreeLowerBound.MultiTapeCfg.q : Q OAI.DepthThreeLowerBound.MultiTapeCfg.tapes : K → Turing.Tape Γ constructor: OAI.DepthThreeLowerBound.MultiTapeCfg.mk.{uK, uGamma, uQ} {K : Type uK} {Γ : Type uGamma} {Q : Type uQ} [Inhabited Γ] (q : Q) (tapes : K → Turing.Tape Γ) : OAI.DepthThreeLowerBound.MultiTapeCfg K Γ Q @[reducible] def OAI.DepthThreeLowerBound.MultiTapeCode.{uK, uGamma, uQ} : Type uK → Type uGamma → Type uQ → Type (max (max (max uGamma uK) uQ) (max uGamma uK) uQ) := fun K Γ Q => Q → (K → Γ) → Option (Q × (K → Γ) × (K → OAI.DepthThreeLowerBound.HeadMove)) def OAI.DepthThreeLowerBound.multiTapeUpdate.{uK, uGamma, uQ} : {K : Type uK} → {Γ : Type uGamma} → {Q : Type uQ} → [inst : Inhabited Γ] → OAI.DepthThreeLowerBound.MultiTapeCfg K Γ Q → Q → (K → Γ) → (K → OAI.DepthThreeLowerBound.HeadMove) → OAI.DepthThreeLowerBound.MultiTapeCfg K Γ Q := fun {K} {Γ} {Q} [Inhabited Γ] c q writes moves => { q := q, tapes := fun k => (moves k).apply (Turing.Tape.write (writes k) (c.tapes k)) } def OAI.DepthThreeLowerBound.multiTapeStep.{uK, uGamma, uQ} : {K : Type uK} → {Γ : Type uGamma} → {Q : Type uQ} → [inst : Inhabited Γ] → OAI.DepthThreeLowerBound.MultiTapeCode K Γ Q → OAI.DepthThreeLowerBound.MultiTapeCfg K Γ Q → Option (OAI.DepthThreeLowerBound.MultiTapeCfg K Γ Q) := fun {K} {Γ} {Q} [Inhabited Γ] code c => Option.map (fun out => OAI.DepthThreeLowerBound.multiTapeUpdate c out.1 out.2.1 out.2.2) (code c.q fun k => (c.tapes k).head) structure OAI.DepthThreeLowerBound.FiniteMultiTapeMachine : Type 1 number of parameters: 0 fields: OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.K : Type OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.tapeFinite : Fintype self.K OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.tapeDecidableEq : DecidableEq self.K OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.inputTape : self.K OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.Γ : Type OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.alphabetInhabited : Inhabited self.Γ OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.alphabetFinite : Fintype self.Γ OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.Q : Type OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.stateFinite : Fintype self.Q OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.initialState : self.Q OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.inputSymbol : Bool → self.Γ OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.input_injective : Function.Injective self.inputSymbol OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.input_ne_blank : ∀ (b : Bool), self.inputSymbol b ≠ default OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.code : OAI.DepthThreeLowerBound.MultiTapeCode self.K self.Γ self.Q OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.accept : self.Q → Bool constructor: OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.mk (K : Type) [tapeFinite : Fintype K] [tapeDecidableEq : DecidableEq K] (inputTape : K) (Γ : Type) [alphabetInhabited : Inhabited Γ] [alphabetFinite : Fintype Γ] (Q : Type) [stateFinite : Fintype Q] (initialState : Q) (inputSymbol : Bool → Γ) (input_injective : Function.Injective inputSymbol) (input_ne_blank : ∀ (b : Bool), inputSymbol b ≠ default) (code : OAI.DepthThreeLowerBound.MultiTapeCode K Γ Q) (accept : Q → Bool) : OAI.DepthThreeLowerBound.FiniteMultiTapeMachine @[reducible] def OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.Cfg : OAI.DepthThreeLowerBound.FiniteMultiTapeMachine → Type := fun M => OAI.DepthThreeLowerBound.MultiTapeCfg M.K M.Γ M.Q @[reducible] def OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.step : (M : OAI.DepthThreeLowerBound.FiniteMultiTapeMachine) → M.Cfg → Option M.Cfg := fun M => OAI.DepthThreeLowerBound.multiTapeStep M.code def OAI.DepthThreeLowerBound.FiniteMultiTapeMachine.init : (M : OAI.DepthThreeLowerBound.FiniteMultiTapeMachine) → List Bool → M.Cfg := fun M input => { q := M.initialState, tapes := fun k => if k = M.inputTape then Turing.Tape.mk₁ (List.map M.inputSymbol input) else Turing.Tape.mk₁ [] } def OAI.DepthThreeLowerBound.MultiTapeHaltsIn : OAI.DepthThreeLowerBound.FiniteMultiTapeMachine → List Bool → Bool → ℕ → Prop := fun M input output time => ∃ k ≤ time, ∃ c, OAI.DepthThreeLowerBound.runSteps M.step k (some (M.init input)) = some c ∧ M.step c = none ∧ M.accept c.q = output 