OAI.Problem340.exists_C1_entropy_counterexample : ∃ q, 0 < q ∧ ∃ f, ∃ (hf : OAI.Problem340.IsC1SelfMap q f), Dynamics.coverEntropy f Set.univ = 0 ∧ (∃ v, v ≠ 0 ∧ (OAI.Problem340.realHomologyMap 2 f ⋯) v = 2 • v) ∧ 0 < Real.log 2 ∧ Real.log 2 ≤ Real.log (OAI.Problem340.totalRealHomologySpectralRadius f ⋯) ∧ ¬Function.Bijective f ∧ 5 ≤ 2 * q + 3 @[reducible] def OAI.Problem340.ClockAmbient : Type := EuclideanSpace ℝ (Fin 2) @[reducible] def OAI.Problem340.SphereAmbient : Type := EuclideanSpace ℝ (Fin 3) @[reducible] def OAI.Problem340.StandardClock : Set OAI.Problem340.ClockAmbient := Metric.sphere 0 1 @[reducible] def OAI.Problem340.StandardSphere2 : Set OAI.Problem340.SphereAmbient := Metric.sphere 0 1 @[reducible] def OAI.Problem340.CounterexampleManifold : ℕ → Type := fun q => ↑OAI.Problem340.StandardClock × (Fin (q + 1) → ↑OAI.Problem340.StandardSphere2) @[reducible] def OAI.Problem340.CounterexampleAmbient : ℕ → Type := fun q => OAI.Problem340.ClockAmbient × (Fin (q + 1) → OAI.Problem340.SphereAmbient) def OAI.Problem340.standardEmbedding : (q : ℕ) → OAI.Problem340.CounterexampleManifold q → OAI.Problem340.CounterexampleAmbient q := fun q x => (↑x.1, fun i => ↑(x.2 i)) def OAI.Problem340.IsC1SelfMap : (q : ℕ) → (OAI.Problem340.CounterexampleManifold q → OAI.Problem340.CounterexampleManifold q) → Prop := fun q f => Continuous f ∧ ∀ (x : OAI.Problem340.CounterexampleManifold q), ∃ U, IsOpen U ∧ OAI.Problem340.standardEmbedding q x ∈ U ∧ ∃ F, ContDiffOn ℝ 1 F U ∧ ∀ (y : OAI.Problem340.CounterexampleManifold q), OAI.Problem340.standardEmbedding q y ∈ U → OAI.Problem340.standardEmbedding q (f y) = F (OAI.Problem340.standardEmbedding q y) def OAI.Problem340.continuousMapOf : {X Y : Type} → [inst : TopologicalSpace X] → [inst_1 : TopologicalSpace Y] → (f : X → Y) → Continuous f → C(X, Y) := fun {X Y} [TopologicalSpace X] [TopologicalSpace Y] f hf => { toFun := f, continuous_toFun := hf } @[reducible] def OAI.Problem340.RealSingularHomology : ℕ → (X : Type) → [TopologicalSpace X] → ModuleCat ℝ := fun n X [TopologicalSpace X] => ((AlgebraicTopology.singularHomologyFunctor (ModuleCat ℝ) n).obj ↧ℝ).obj ↧X def OAI.Problem340.realHomologyMap : {X Y : Type} → [inst : TopologicalSpace X] → [inst_1 : TopologicalSpace Y] → (n : ℕ) → (f : X → Y) → Continuous f → ↑(OAI.Problem340.RealSingularHomology n X) →ₗ[ℝ] ↑(OAI.Problem340.RealSingularHomology n Y) := fun {X Y} [TopologicalSpace X] [TopologicalSpace Y] n f hf => ModuleCat.Hom.hom (((AlgebraicTopology.singularHomologyFunctor (ModuleCat ℝ) n).obj ↧ℝ).map (TopCat.ofHom (OAI.Problem340.continuousMapOf f hf))) def OAI.Problem340.totalRealHomologySpectralRadius : {X : Type} → [inst : TopologicalSpace X] → (f : X → X) → Continuous f → ℝ := fun {X} [TopologicalSpace X] f hf => sSup {r | ∃ n a b u v, (u ≠ 0 ∨ v ≠ 0) ∧ (OAI.Problem340.realHomologyMap n f hf) u = a • u - b • v ∧ (OAI.Problem340.realHomologyMap n f hf) v = b • u + a • v ∧ r = √(a ^ 2 + b ^ 2)} 