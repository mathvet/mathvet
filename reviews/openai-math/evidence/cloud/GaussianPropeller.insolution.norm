OAI.GaussianPropeller.all_partitions : OAI.GaussianPropeller.AllPartitions @[reducible] def OAI.GaussianPropeller.Space : ℕ → Type := fun d => EuclideanSpace ℝ (Fin d) def OAI.GaussianPropeller.gaussian : (d : ℕ) → MeasureTheory.Measure (OAI.GaussianPropeller.Space d) := fun d => ProbabilityTheory.stdGaussian (OAI.GaussianPropeller.Space d) def OAI.GaussianPropeller.IsPartition : {d k : ℕ} → (Fin k → Set (OAI.GaussianPropeller.Space d)) → Prop := fun {d k} A => (∀ (i : Fin k), MeasurableSet (A i)) ∧ ∀ᵐ (x : OAI.GaussianPropeller.Space d) ∂OAI.GaussianPropeller.gaussian d, ∃! i, x ∈ A i def OAI.GaussianPropeller.centroid : {d : ℕ} → Set (OAI.GaussianPropeller.Space d) → OAI.GaussianPropeller.Space d := fun {d} A => ∫ (x : OAI.GaussianPropeller.Space d) in A, x ∂OAI.GaussianPropeller.gaussian d def OAI.GaussianPropeller.value : {d k : ℕ} → (Fin k → Set (OAI.GaussianPropeller.Space d)) → ℝ := fun {d k} A => ∑ i, ‖OAI.GaussianPropeller.centroid (A i)‖ ^ 2 def OAI.GaussianPropeller.coord : {d : ℕ} → ℕ → OAI.GaussianPropeller.Space d → ℝ := fun {d} j x => if h : j < d then x.ofLp ⟨j, h⟩ else 0 def OAI.GaussianPropeller.propeller : (d k : ℕ) → Fin k → Set (OAI.GaussianPropeller.Space d) := fun d k i => if ↑i = 0 then {x | |OAI.GaussianPropeller.coord 1 x| ≤ √3 * OAI.GaussianPropeller.coord 0 x} else if ↑i = 1 then {x | 0 ≤ OAI.GaussianPropeller.coord 1 x ∧ √3 * OAI.GaussianPropeller.coord 0 x ≤ OAI.GaussianPropeller.coord 1 x} else if ↑i = 2 then {x | OAI.GaussianPropeller.coord 1 x ≤ 0 ∧ √3 * OAI.GaussianPropeller.coord 0 x ≤ -OAI.GaussianPropeller.coord 1 x} else ∅ def OAI.GaussianPropeller.AllPartitions : Prop := (∀ (d k : ℕ), 0 < d → 0 < k → ∀ (A : Fin k → Set (OAI.GaussianPropeller.Space d)), OAI.GaussianPropeller.IsPartition A → OAI.GaussianPropeller.value A ≤ 9 / (8 * Real.pi)) ∧ ∀ (d k : ℕ), 2 ≤ d → 3 ≤ k → OAI.GaussianPropeller.IsPartition (OAI.GaussianPropeller.propeller d k) ∧ OAI.GaussianPropeller.value (OAI.GaussianPropeller.propeller d k) = 9 / (8 * Real.pi) 