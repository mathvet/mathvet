OAI.CubeShuffle.WeightedSweep.weighted_sweep_moments : ∃ W pStar p, (∀ (μ : YoungDiagram), 0 < W μ) ∧ 2 ≤ pStar ∧ (∀ (d : ℕ), 1 ≤ d → 2 ≤ p d ∧ p d ≤ pStar) ∧ ∀ (d : ℕ), 1 ≤ d → ∀ (μ : OAI.CubeShuffle.Specht.Shapes (2 ^ d)), OAI.CubeShuffle.WeightedSweep.dimension ↑μ ^ (3 / 4) ≤ W ↑μ ∧ W ↑μ ≤ OAI.CubeShuffle.WeightedSweep.dimension ↑μ ∧ W ↑μ * OAI.CubeShuffle.WeightedSweep.schattenNorm (OAI.CubeShuffle.WeightedSweep.fourierSweep d μ) (p d) ^ p d ≤ 1 ∧ ‖OAI.CubeShuffle.WeightedSweep.fourierSweep d μ‖ ≤ OAI.CubeShuffle.WeightedSweep.dimension ↑μ ^ (-3 / (4 * pStar)) @[reducible] def OAI.CubeShuffle.Specht.Cell : YoungDiagram → Type := fun μ => ↥μ.cells def OAI.CubeShuffle.Specht.row : {μ : YoungDiagram} → OAI.CubeShuffle.Specht.Cell μ → ℕ := fun {μ} x => (↑x).1 def OAI.CubeShuffle.Specht.col : {μ : YoungDiagram} → OAI.CubeShuffle.Specht.Cell μ → ℕ := fun {μ} x => (↑x).2 def OAI.CubeShuffle.Specht.rowIndex : {μ : YoungDiagram} → OAI.CubeShuffle.Specht.Cell μ → Fin (μ.colLen 0) := fun {μ} x => ⟨OAI.CubeShuffle.Specht.row x, ⋯⟩ @[reducible] def OAI.CubeShuffle.Specht.Tabloid : YoungDiagram → Type := fun μ => { f // ∃ p, f = OAI.CubeShuffle.Specht.rowIndex ∘ ⇑p } def OAI.CubeShuffle.Specht.baseTabloid : (μ : YoungDiagram) → OAI.CubeShuffle.Specht.Tabloid μ := fun μ => ⟨OAI.CubeShuffle.Specht.rowIndex, ⋯⟩ def OAI.CubeShuffle.Specht.tabloidAct : {μ : YoungDiagram} → Equiv.Perm (OAI.CubeShuffle.Specht.Cell μ) → Equiv.Perm (OAI.CubeShuffle.Specht.Tabloid μ) := fun {μ} p => { toFun := fun f => ⟨fun x => ↑f (p⁻¹ x), ⋯⟩, invFun := fun f => ⟨fun x => ↑f (p x), ⋯⟩, left_inv := ⋯, right_inv := ⋯ } def OAI.CubeShuffle.Specht.tabloidRep : (μ : YoungDiagram) → Representation ℂ (Equiv.Perm (OAI.CubeShuffle.Specht.Cell μ)) (OAI.CubeShuffle.Specht.Tabloid μ → ℂ) := fun μ => { toFun := fun p => { toFun := fun v f => v ((OAI.CubeShuffle.Specht.tabloidAct p⁻¹) f), map_add' := ⋯, map_smul' := ⋯ }, map_one' := ⋯, map_mul' := ⋯ } def OAI.CubeShuffle.Specht.delta : {μ : YoungDiagram} → OAI.CubeShuffle.Specht.Tabloid μ → OAI.CubeShuffle.Specht.Tabloid μ → ℂ := fun {μ} f g => if g = f then 1 else 0 def OAI.CubeShuffle.Specht.colGroup : (μ : YoungDiagram) → Subgroup (Equiv.Perm (OAI.CubeShuffle.Specht.Cell μ)) := fun μ => { carrier := {p | ∀ (x : OAI.CubeShuffle.Specht.Cell μ), OAI.CubeShuffle.Specht.col (p x) = OAI.CubeShuffle.Specht.col x}, mul_mem' := ⋯, one_mem' := ⋯, inv_mem' := ⋯ } def OAI.CubeShuffle.Specht.permSign.{u_1} : {α : Type u_1} → [Fintype α] → [DecidableEq α] → Equiv.Perm α → ℂ := fun {α} [Fintype α] [DecidableEq α] p => ↑↑(Equiv.Perm.sign p) def OAI.CubeShuffle.Specht.alternator.{u_1, u_2} : {α : Type u_1} → {V : Type u_2} → [Fintype α] → [DecidableEq α] → [inst : AddCommGroup V] → [inst_1 : Module ℂ V] → Subgroup (Equiv.Perm α) → Representation ℂ (Equiv.Perm α) V → Module.End ℂ V := fun {α} {V} [Fintype α] [DecidableEq α] [AddCommGroup V] [Module ℂ V] C ρ => ∑ c, OAI.CubeShuffle.Specht.permSign ↑c • ρ ↑c def OAI.CubeShuffle.Specht.polytabloid : (μ : YoungDiagram) → OAI.CubeShuffle.Specht.Tabloid μ → ℂ := fun μ => (OAI.CubeShuffle.Specht.alternator (OAI.CubeShuffle.Specht.colGroup μ) (OAI.CubeShuffle.Specht.tabloidRep μ)) (OAI.CubeShuffle.Specht.delta (OAI.CubeShuffle.Specht.baseTabloid μ)) def OAI.CubeShuffle.Specht.space : (μ : YoungDiagram) → Submodule ℂ (OAI.CubeShuffle.Specht.Tabloid μ → ℂ) := fun μ => Submodule.span ℂ (Set.range fun p => ((OAI.CubeShuffle.Specht.tabloidRep μ) p) (OAI.CubeShuffle.Specht.polytabloid μ)) def OAI.CubeShuffle.Specht.subrepresentation : (μ : YoungDiagram) → Subrepresentation (OAI.CubeShuffle.Specht.tabloidRep μ) := fun μ => { toSubmodule := OAI.CubeShuffle.Specht.space μ, apply_mem_toSubmodule := ⋯ } def OAI.CubeShuffle.Specht.representation : (μ : YoungDiagram) → Representation ℂ (Equiv.Perm (OAI.CubeShuffle.Specht.Cell μ)) ↥(OAI.CubeShuffle.Specht.space μ) := fun μ => (OAI.CubeShuffle.Specht.subrepresentation μ).toRepresentation @[reducible] def OAI.CubeShuffle.PermutationHilbert.H.{u_2} : (X : Type u_2) → [Fintype X] → Type u_2 := fun X [Fintype X] => EuclideanSpace ℂ X def OAI.CubeShuffle.Specht.hilbertEquiv : (μ : YoungDiagram) → (OAI.CubeShuffle.Specht.Tabloid μ → ℂ) ≃ₗ[ℂ] OAI.CubeShuffle.PermutationHilbert.H (OAI.CubeShuffle.Specht.Tabloid μ) := fun μ => (WithLp.linearEquiv 2 ℂ (OAI.CubeShuffle.Specht.Tabloid μ → ℂ)).symm def OAI.CubeShuffle.Specht.hilbertSpace : (μ : YoungDiagram) → Submodule ℂ (OAI.CubeShuffle.PermutationHilbert.H (OAI.CubeShuffle.Specht.Tabloid μ)) := fun μ => Submodule.map (↑(OAI.CubeShuffle.Specht.hilbertEquiv μ)) (OAI.CubeShuffle.Specht.space μ) def OAI.CubeShuffle.Specht.spaceHilbertEquiv : (μ : YoungDiagram) → ↥(OAI.CubeShuffle.Specht.space μ) ≃ₗ[ℂ] ↥(OAI.CubeShuffle.Specht.hilbertSpace μ) := fun μ => (OAI.CubeShuffle.Specht.hilbertEquiv μ).submoduleMap (OAI.CubeShuffle.Specht.space μ) def OAI.CubeShuffle.Specht.unitaryRepresentation : (μ : YoungDiagram) → Representation ℂ (Equiv.Perm (OAI.CubeShuffle.Specht.Cell μ)) ↥(OAI.CubeShuffle.Specht.hilbertSpace μ) := fun μ => (LinearEquiv.conjAlgEquiv ℂ (OAI.CubeShuffle.Specht.spaceHilbertEquiv μ)).toMulEquiv.toMonoidHom.comp (OAI.CubeShuffle.Specht.representation μ) def OAI.CubeShuffle.Specht.relabelledUnitary.{u_1} : {α : Type u_1} → (μ : YoungDiagram) → α ≃ OAI.CubeShuffle.Specht.Cell μ → Representation ℂ (Equiv.Perm α) ↥(OAI.CubeShuffle.Specht.hilbertSpace μ) := fun {α} μ e => MonoidHom.comp (OAI.CubeShuffle.Specht.unitaryRepresentation μ) e.permCongrHom.toMonoidHom @[reducible] def OAI.CubeShuffle.Card : ℕ → Type := fun d => Fin d → Bool def OAI.CubeShuffle.Coins : ℕ → Type := fun x => match x with | 0 => Unit | d.succ => OAI.CubeShuffle.Card d → Bool def OAI.CubeShuffle.switchFun : {d : ℕ} → (OAI.CubeShuffle.Card d → Bool) → OAI.CubeShuffle.Card (d + 1) → OAI.CubeShuffle.Card (d + 1) := fun {d} ξ x => Fin.cons (x 0 ^^ ξ (Fin.tail x)) (Fin.tail x) def OAI.CubeShuffle.pairSwitch : {d : ℕ} → (OAI.CubeShuffle.Card d → Bool) → Equiv.Perm (OAI.CubeShuffle.Card (d + 1)) := fun {d} ξ => { toFun := OAI.CubeShuffle.switchFun ξ, invFun := OAI.CubeShuffle.switchFun ξ, left_inv := ⋯, right_inv := ⋯ } def OAI.CubeShuffle.rotate : (d : ℕ) → Equiv.Perm (OAI.CubeShuffle.Card d) := fun d => { toFun := fun x i => x ((finRotate d) i), invFun := fun x i => x ((Equiv.symm (finRotate d)) i), left_inv := ⋯, right_inv := ⋯ } def OAI.CubeShuffle.step : (d : ℕ) → OAI.CubeShuffle.Coins d → Equiv.Perm (OAI.CubeShuffle.Card d) := fun x x_1 => match x, x_1 with | 0, x => 1 | d.succ, ξ => OAI.CubeShuffle.rotate (d + 1) * OAI.CubeShuffle.pairSwitch ξ def OAI.CubeShuffle.run : (d t : ℕ) → (Fin t → OAI.CubeShuffle.Coins d) → Equiv.Perm (OAI.CubeShuffle.Card d) := fun d x x_1 => Nat.brecOn (motive := fun x => (Fin x → OAI.CubeShuffle.Coins d) → Equiv.Perm (OAI.CubeShuffle.Card d)) x (OAI.CubeShuffle.run._f d) x_1 @[reducible] def OAI.CubeShuffle.Specht.Shapes : ℕ → Type := fun N => { μ // μ.card = N } def OAI.CubeShuffle.Specht.labels : {N : ℕ} → (μ : OAI.CubeShuffle.Specht.Shapes N) → OAI.CubeShuffle.Specht.Cell ↑μ ≃ Fin N := fun {N} μ => (Fintype.equivFin (OAI.CubeShuffle.Specht.Cell ↑μ)).trans (finCongr ⋯) def OAI.CubeShuffle.Specht.cardLabels : (d : ℕ) → (μ : OAI.CubeShuffle.Specht.Shapes (2 ^ d)) → OAI.CubeShuffle.Card d ≃ OAI.CubeShuffle.Specht.Cell ↑μ := fun d μ => ((Fintype.equivFin (OAI.CubeShuffle.Card d)).trans (finCongr ⋯)).trans (OAI.CubeShuffle.Specht.labels μ).symm def OAI.CubeShuffle.Specht.cardRepresentation : (d : ℕ) → (μ : OAI.CubeShuffle.Specht.Shapes (2 ^ d)) → Representation ℂ (Equiv.Perm (OAI.CubeShuffle.Card d)) ↥(OAI.CubeShuffle.Specht.hilbertSpace ↑μ) := fun d μ => OAI.CubeShuffle.Specht.relabelledUnitary (↑μ) (OAI.CubeShuffle.Specht.cardLabels d μ) def OAI.CubeShuffle.UnitaryFinite.continuousRepresentation.{u_1, u_2} : {G : Type u_1} → [inst : Group G] → {V : Type u_2} → [inst_1 : NormedAddCommGroup V] → [inst_2 : InnerProductSpace ℂ V] → [FiniteDimensional ℂ V] → Representation ℂ G V → G →* V →L[ℂ] V := fun {G} [Group G] {V} [NormedAddCommGroup V] [InnerProductSpace ℂ V] [FiniteDimensional ℂ V] ρ => { toFun := fun g => LinearMap.toContinuousLinearMap (ρ g), map_one' := ⋯, map_mul' := ⋯ } def OAI.CubeShuffle.UnitaryFinite.sampleOperator.{u_1, u_2, u_3} : {G : Type u_1} → [inst : Group G] → {V : Type u_2} → [inst_1 : NormedAddCommGroup V] → [inst_2 : InnerProductSpace ℂ V] → [FiniteDimensional ℂ V] → {Ω : Type u_3} → [Fintype Ω] → Representation ℂ G V → (Ω → G) → V →L[ℂ] V := fun {G} [Group G] {V} [NormedAddCommGroup V] [InnerProductSpace ℂ V] [FiniteDimensional ℂ V] {Ω} [Fintype Ω] ρ P => (↑(Fintype.card Ω))⁻¹ • ∑ ω, (OAI.CubeShuffle.UnitaryFinite.continuousRepresentation ρ) (P ω) def OAI.CubeShuffle.WeightedSweep.dimension : YoungDiagram → ℝ := fun μ => ↑(Module.finrank ℂ ↥(OAI.CubeShuffle.Specht.space μ)) def OAI.CubeShuffle.WeightedSweep.fourierSweep : (d : ℕ) → (μ : OAI.CubeShuffle.Specht.Shapes (2 ^ d)) → ↥(OAI.CubeShuffle.Specht.hilbertSpace ↑μ) →L[ℂ] ↥(OAI.CubeShuffle.Specht.hilbertSpace ↑μ) := fun d μ => OAI.CubeShuffle.UnitaryFinite.sampleOperator (OAI.CubeShuffle.Specht.cardRepresentation d μ) (OAI.CubeShuffle.run d d) def OAI.CubeShuffle.WeightedSweep.schattenMoment.{u_1} : {V : Type u_1} → [inst : NormedAddCommGroup V] → [inst_1 : InnerProductSpace ℂ V] → [FiniteDimensional ℂ V] → (V →L[ℂ] V) → ℝ → ℝ := fun {V} [NormedAddCommGroup V] [InnerProductSpace ℂ V] [FiniteDimensional ℂ V] A p => ∑ i, (↑A).singularValues ↑i ^ p def OAI.CubeShuffle.WeightedSweep.schattenNorm.{u_1} : {V : Type u_1} → [inst : NormedAddCommGroup V] → [inst_1 : InnerProductSpace ℂ V] → [FiniteDimensional ℂ V] → (V →L[ℂ] V) → ℝ → ℝ := fun {V} [NormedAddCommGroup V] [InnerProductSpace ℂ V] [FiniteDimensional ℂ V] A p => OAI.CubeShuffle.WeightedSweep.schattenMoment A p ^ (1 / p) 