OAI.LittleFinitistic.Main.exists_counterexample : ∃ A x x_1, FiniteDimensional ℂ A ∧ OAI.LittleFinitistic.littleFinitisticDimension A = ⊤ ∧ ∀ (m : ℕ), 0 < m → ∃ N, Module.Finite A ↑N ∧ ↑(2 * m - 2) ≤ CategoryTheory.projectiveDimension N ∧ CategoryTheory.projectiveDimension N < ⊤ def OAI.LittleFinitistic.littleFinitisticDimension.{u} : (A : Type u) → [Ring A] → WithBot ℕ∞ := fun A [Ring A] => ⨆ M, ⨆ (_ : Module.Finite A ↑M), ⨆ (_ : CategoryTheory.projectiveDimension M < ⊤), CategoryTheory.projectiveDimension M 