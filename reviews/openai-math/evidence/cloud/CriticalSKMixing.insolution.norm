OAI.CriticalSK.critical_mixing_bounds : ∀ (ε : ℝ), 0 < ε → Filter.Tendsto (fun n => ((OAI.CriticalSK.disorderLaw n) {W | ↑n ^ (2 / 3 - ε) ≤ OAI.CriticalSK.continuousMixingTime W ∧ OAI.CriticalSK.continuousMixingTime W ≤ Real.exp (ε * ↑n)}).toReal) Filter.atTop (nhds 1) ∧ Filter.Tendsto (fun n => ((OAI.CriticalSK.disorderLaw n) {W | ↑n ^ (5 / 3 - ε) ≤ ↑(OAI.CriticalSK.discreteMixingTime W) ∧ ↑(OAI.CriticalSK.discreteMixingTime W) ≤ Real.exp (ε * ↑n)}).toReal) Filter.atTop (nhds 1) @[reducible] def OAI.CriticalSK.Spin : ℕ → Type := fun n => Fin n → Bool @[reducible] def OAI.CriticalSK.Edge : ℕ → Type := fun n => { p // p.1 < p.2 } @[reducible] def OAI.CriticalSK.Disorder : ℕ → Type := fun n => OAI.CriticalSK.Edge n → ℝ def OAI.CriticalSK.spinValue : Bool → ℝ := fun b => if b = true then 1 else -1 def OAI.CriticalSK.hamiltonian : {n : ℕ} → OAI.CriticalSK.Disorder n → OAI.CriticalSK.Spin n → ℝ := fun {n} W x => ∑ e, W e * OAI.CriticalSK.spinValue (x (↑e).1) * OAI.CriticalSK.spinValue (x (↑e).2) def OAI.CriticalSK.partition : {n : ℕ} → OAI.CriticalSK.Disorder n → ℝ := fun {n} W => ∑ x, Real.exp (OAI.CriticalSK.hamiltonian W x) def OAI.CriticalSK.gibbs : {n : ℕ} → OAI.CriticalSK.Disorder n → OAI.CriticalSK.Spin n → ℝ := fun {n} W x => Real.exp (OAI.CriticalSK.hamiltonian W x) / OAI.CriticalSK.partition W def OAI.CriticalSK.disorderLaw : (n : ℕ) → MeasureTheory.Measure (OAI.CriticalSK.Disorder n) := fun n => MeasureTheory.Measure.pi fun x => ProbabilityTheory.gaussianReal 0 (↑n)⁻¹ def OAI.CriticalSK.sameExcept : {n : ℕ} → Fin n → OAI.CriticalSK.Spin n → OAI.CriticalSK.Spin n → Prop := fun {n} i x y => ∀ (j : Fin n), j ≠ i → y j = x j def OAI.CriticalSK.siteKernel : {n : ℕ} → OAI.CriticalSK.Disorder n → Fin n → Matrix (OAI.CriticalSK.Spin n) (OAI.CriticalSK.Spin n) ℝ := fun {n} W i x y => if OAI.CriticalSK.sameExcept i x y then OAI.CriticalSK.gibbs W y / ∑ z, if OAI.CriticalSK.sameExcept i x z then OAI.CriticalSK.gibbs W z else 0 else 0 def OAI.CriticalSK.discreteKernel : {n : ℕ} → OAI.CriticalSK.Disorder n → Matrix (OAI.CriticalSK.Spin n) (OAI.CriticalSK.Spin n) ℝ := fun {n} W => (↑n)⁻¹ • ∑ i, OAI.CriticalSK.siteKernel W i def OAI.CriticalSK.generator : {n : ℕ} → OAI.CriticalSK.Disorder n → Matrix (OAI.CriticalSK.Spin n) (OAI.CriticalSK.Spin n) ℝ := fun {n} W => ∑ i, (OAI.CriticalSK.siteKernel W i - 1) def OAI.CriticalSK.continuousKernel : {n : ℕ} → OAI.CriticalSK.Disorder n → ℝ → Matrix (OAI.CriticalSK.Spin n) (OAI.CriticalSK.Spin n) ℝ := fun {n} W t => NormedSpace.exp (t • OAI.CriticalSK.generator W) def OAI.CriticalSK.totalVariation : {n : ℕ} → OAI.CriticalSK.Disorder n → (OAI.CriticalSK.Spin n → ℝ) → ℝ := fun {n} W p => 1 / 2 * ∑ y, |p y - OAI.CriticalSK.gibbs W y| def OAI.CriticalSK.continuousDistance : {n : ℕ} → OAI.CriticalSK.Disorder n → ℝ → OAI.CriticalSK.Spin n → ℝ := fun {n} W t x => OAI.CriticalSK.totalVariation W (OAI.CriticalSK.continuousKernel W t x) def OAI.CriticalSK.discreteDistance : {n : ℕ} → OAI.CriticalSK.Disorder n → ℕ → OAI.CriticalSK.Spin n → ℝ := fun {n} W k x => OAI.CriticalSK.totalVariation W ((OAI.CriticalSK.discreteKernel W ^ k) x) def OAI.CriticalSK.continuousMixingTime : {n : ℕ} → OAI.CriticalSK.Disorder n → ℝ := fun {n} W => sInf {t | 0 ≤ t ∧ ∀ (x : OAI.CriticalSK.Spin n), OAI.CriticalSK.continuousDistance W t x ≤ 1 / 4} def OAI.CriticalSK.discreteMixingTime : {n : ℕ} → OAI.CriticalSK.Disorder n → ℕ := fun {n} W => sInf {k | ∀ (x : OAI.CriticalSK.Spin n), OAI.CriticalSK.discreteDistance W k x ≤ 1 / 4} 