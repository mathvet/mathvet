OAI.Paper320.quantitative_separation : ∀ (d : ℕ), 1 ≤ d → ∃ n f, 0 < n ∧ (f fun x => false) = false ∧ (∃ x y, f x ≠ f y) ∧ 2 ^ d / (4 * (↑d + 2) ^ 2) ≤ ↑(OAI.Paper320.blockSensitivity f) / ↑(OAI.Paper320.sensitivity f) ^ 2 def OAI.Paper320.flip : {I : Type} → (I → Bool) → Finset I → I → Bool := fun {I} x B i => if i ∈ B then !x i else x i def OAI.Paper320.sensitivityAt : {I : Type} → [Fintype I] → ((I → Bool) → Bool) → (I → Bool) → ℕ := fun {I} [Fintype I] f x => {i | f (OAI.Paper320.flip x {i}) ≠ f x}.card def OAI.Paper320.sensitivity : {I : Type} → [Fintype I] → ((I → Bool) → Bool) → ℕ := fun {I} [Fintype I] f => Finset.univ.sup (OAI.Paper320.sensitivityAt f) def OAI.Paper320.blockSensitivityAt : {I : Type} → [Fintype I] → ((I → Bool) → Bool) → (I → Bool) → ℕ := fun {I} [Fintype I] f x => Finset.univ.sup fun blocks => if (∀ A ∈ blocks, ∀ B ∈ blocks, A ≠ B → Disjoint A B) ∧ ∀ B ∈ blocks, B.Nonempty ∧ f (OAI.Paper320.flip x B) ≠ f x then blocks.card else 0 def OAI.Paper320.blockSensitivity : {I : Type} → [Fintype I] → ((I → Bool) → Bool) → ℕ := fun {I} [Fintype I] f => Finset.univ.sup (OAI.Paper320.blockSensitivityAt f) 