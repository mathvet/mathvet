@OAI.EuclideanRamsey.TransitiveConsequence.subset_of_finite_transitive_ramsey : ∀ {s t D : ℕ} (a : Fin s → OAI.EuclideanRamsey.Space D) (y : Fin t → OAI.EuclideanRamsey.Space D), 0 < s → Function.Injective a → Function.Injective y → (∀ (i j : Fin t), ∃ σ, (∀ (k l : Fin t), dist (y (σ k)) (y (σ l)) = dist (y k) (y l)) ∧ σ i = j) → Set.range a ⊆ Set.range y → OAI.EuclideanRamsey.Ramsey a @[reducible] def OAI.EuclideanRamsey.Space : ℕ → Type := fun d => EuclideanSpace ℝ (Fin d) def OAI.EuclideanRamsey.Congruent : {s d D : ℕ} → (Fin s → OAI.EuclideanRamsey.Space d) → (Fin s → OAI.EuclideanRamsey.Space D) → Prop := fun {s d D} a b => ∀ (i j : Fin s), dist (b i) (b j) = dist (a i) (a j) def OAI.EuclideanRamsey.Ramsey : {s d : ℕ} → (Fin s → OAI.EuclideanRamsey.Space d) → Prop := fun {s d} a => ∀ (r : ℕ), 2 ≤ r → ∃ D, 1 ≤ D ∧ ∀ (c : OAI.EuclideanRamsey.Space D → Fin r), ∃ b, OAI.EuclideanRamsey.Congruent a b ∧ ∃ k, ∀ (i : Fin s), c (b i) = k 