OAI.PlanarUnitDistances.main : ∃ C β, 0 < C ∧ 1 ≤ β ∧ β < 4 / 3 ∧ ∀ (n : ℕ), ↑(OAI.PlanarUnitDistances.u n) ≤ C * ↑n ^ β @[reducible] def OAI.PlanarUnitDistances.Plane : Type := EuclideanSpace ℝ (Fin 2) def OAI.PlanarUnitDistances.IsUnitPair : Sym2 OAI.PlanarUnitDistances.Plane → Prop := Sym2.lift ⟨fun x y => dist x y = 1, OAI.PlanarUnitDistances.IsUnitPair._proof_1⟩ def OAI.PlanarUnitDistances.unitPairCount : Finset OAI.PlanarUnitDistances.Plane → ℕ := fun X => (Finset.filter OAI.PlanarUnitDistances.IsUnitPair X.sym2).card def OAI.PlanarUnitDistances.u : ℕ → ℕ := fun n => sSup {m | ∃ X, X.card = n ∧ OAI.PlanarUnitDistances.unitPairCount X = m} 