OAI.CubicTorus.unit_cubic_isoperimetric : ∀ V ∈ Set.Ioo 0 1, (∃ E, OAI.CubicTorus.IsMinimizerAt V E) ∧ (∀ (E : Set OAI.CubicTorus.Torus), OAI.CubicTorus.IsMinimizerAt V E → OAI.CubicTorus.perimeter E = ENNReal.ofReal (OAI.CubicTorus.candidateProfile V)) ∧ ∀ (E : Set OAI.CubicTorus.Torus), OAI.CubicTorus.IsMinimizerAt V E ↔ OAI.CubicTorus.StandardRegionAt V E @[reducible] def OAI.CubicTorus.Cover : Type := EuclideanSpace ℝ (Fin 3) @[reducible] def OAI.CubicTorus.Torus : Type := PiLp 2 fun x => AddCircle 1 def OAI.CubicTorus.quotientMap : OAI.CubicTorus.Cover → OAI.CubicTorus.Torus := fun x => WithLp.toLp 2 fun i => ↑(x.ofLp i) def OAI.CubicTorus.fundamentalCube : Set OAI.CubicTorus.Cover := {x | ∀ (i : Fin 3), 0 ≤ x.ofLp i ∧ x.ofLp i < 1} def OAI.CubicTorus.torusVolume : MeasureTheory.Measure OAI.CubicTorus.Torus := MeasureTheory.Measure.map OAI.CubicTorus.quotientMap (MeasureTheory.volume.restrict OAI.CubicTorus.fundamentalCube) def OAI.CubicTorus.latticeVector : (Fin 3 → ℤ) → OAI.CubicTorus.Cover := fun n => WithLp.toLp 2 fun i => ↑(n i) def OAI.CubicTorus.AdmissibleField : (OAI.CubicTorus.Cover → OAI.CubicTorus.Cover) → Prop := fun F => ContDiff ℝ (↑⊤) F ∧ (∀ (n : Fin 3 → ℤ) (x : OAI.CubicTorus.Cover), F (x + OAI.CubicTorus.latticeVector n) = F x) ∧ ∀ (x : OAI.CubicTorus.Cover), ‖F x‖ ≤ 1 def OAI.CubicTorus.divergence : (OAI.CubicTorus.Cover → OAI.CubicTorus.Cover) → OAI.CubicTorus.Cover → ℝ := fun F x => ∑ i, ((fderiv ℝ F x) (EuclideanSpace.single i 1)).ofLp i def OAI.CubicTorus.perimeter : Set OAI.CubicTorus.Torus → ENNReal := fun E => ⨆ F, ⨆ (_ : OAI.CubicTorus.AdmissibleField F), ENNReal.ofReal (∫ (x : OAI.CubicTorus.Cover) in OAI.CubicTorus.fundamentalCube ∩ OAI.CubicTorus.quotientMap ⁻¹' E, OAI.CubicTorus.divergence F x) def OAI.CubicTorus.FinitePerimeter : Set OAI.CubicTorus.Torus → Prop := fun E => MeasureTheory.NullMeasurableSet E OAI.CubicTorus.torusVolume ∧ OAI.CubicTorus.perimeter E < ⊤ def OAI.CubicTorus.IsMinimizerAt : ℝ → Set OAI.CubicTorus.Torus → Prop := fun V E => OAI.CubicTorus.FinitePerimeter E ∧ OAI.CubicTorus.torusVolume E = ENNReal.ofReal V ∧ ∀ (F : Set OAI.CubicTorus.Torus), OAI.CubicTorus.FinitePerimeter F → OAI.CubicTorus.torusVolume F = ENNReal.ofReal V → OAI.CubicTorus.perimeter E ≤ OAI.CubicTorus.perimeter F def OAI.CubicTorus.candidateProfile : ℝ → ℝ := fun V => have v := min V (1 - V); min ((36 * Real.pi) ^ (1 / 3) * v ^ (2 / 3)) (min (2 * √(Real.pi * v)) 2) def OAI.CubicTorus.canonicalBall : ℝ → Set OAI.CubicTorus.Torus := fun V => Metric.ball 0 ((3 * V / (4 * Real.pi)) ^ (1 / 3)) def OAI.CubicTorus.canonicalTube : ℝ → Set OAI.CubicTorus.Torus := fun V => {x | ‖x.ofLp 1‖ ^ 2 + ‖x.ofLp 2‖ ^ 2 < √(V / Real.pi) ^ 2} def OAI.CubicTorus.canonicalSlab : ℝ → Set OAI.CubicTorus.Torus := fun V => {x | ‖x.ofLp 0‖ < V / 2} def OAI.CubicTorus.CongruentAE : Set OAI.CubicTorus.Torus → Set OAI.CubicTorus.Torus → Prop := fun E F => ∃ φ, E =ᵐ[OAI.CubicTorus.torusVolume] ⇑φ '' F def OAI.CubicTorus.SmallStandardRegion : ℝ → Set OAI.CubicTorus.Torus → Prop := fun V E => V ≤ 4 * Real.pi / 81 ∧ OAI.CubicTorus.CongruentAE E (OAI.CubicTorus.canonicalBall V) ∨ 4 * Real.pi / 81 ≤ V ∧ V ≤ 1 / Real.pi ∧ OAI.CubicTorus.CongruentAE E (OAI.CubicTorus.canonicalTube V) ∨ 1 / Real.pi ≤ V ∧ OAI.CubicTorus.CongruentAE E (OAI.CubicTorus.canonicalSlab V) def OAI.CubicTorus.StandardRegionAt : ℝ → Set OAI.CubicTorus.Torus → Prop := fun V E => if V ≤ 1 / 2 then OAI.CubicTorus.SmallStandardRegion V E else OAI.CubicTorus.SmallStandardRegion (1 - V) Eᶜ 