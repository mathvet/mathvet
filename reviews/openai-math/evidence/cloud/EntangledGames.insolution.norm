OAI.ThresholdParallelRepetition.threshold_parallel_repetition : ∃ κ₀, 0 < κ₀ ∧ ∀ (x y a b : ℕ) (G : OAI.ThresholdParallelRepetition.Game x y a b), OAI.ThresholdParallelRepetition.entangledValue G < 1 → ∀ (δ : ℝ), 0 < δ → δ < 1 - OAI.ThresholdParallelRepetition.entangledValue G → ∀ (k : ℕ), 1 ≤ k → (∀ (S : OAI.ThresholdParallelRepetition.RepeatedStrategy x y a b k), OAI.ThresholdParallelRepetition.thresholdProbability G δ S ≤ Real.exp (-κ₀ * δ ^ 13 / (1 + Real.log ↑((a + 1) * (b + 1))) * ↑k)) ∧ OAI.ThresholdParallelRepetition.thresholdValue G δ ≤ Real.exp (-κ₀ * δ ^ 13 / (1 + Real.log ↑((a + 1) * (b + 1))) * ↑k) structure OAI.ThresholdParallelRepetition.Game (x y a b : ℕ) : Type number of parameters: 4 fields: OAI.ThresholdParallelRepetition.Game.questionProb : Fin (x + 1) × Fin (y + 1) → ℝ OAI.ThresholdParallelRepetition.Game.questionProb_nonneg : ∀ (z : Fin (x + 1) × Fin (y + 1)), 0 ≤ self.questionProb z OAI.ThresholdParallelRepetition.Game.questionProb_sum : ∑ z, self.questionProb z = 1 OAI.ThresholdParallelRepetition.Game.accepts : Fin (x + 1) → Fin (y + 1) → Fin (a + 1) → Fin (b + 1) → Bool constructor: OAI.ThresholdParallelRepetition.Game.mk {x y a b : ℕ} (questionProb : Fin (x + 1) × Fin (y + 1) → ℝ) (questionProb_nonneg : ∀ (z : Fin (x + 1) × Fin (y + 1)), 0 ≤ questionProb z) (questionProb_sum : ∑ z, questionProb z = 1) (accepts : Fin (x + 1) → Fin (y + 1) → Fin (a + 1) → Fin (b + 1) → Bool) : OAI.ThresholdParallelRepetition.Game x y a b structure OAI.ThresholdParallelRepetition.Strategy (X Y A B : Type) [Fintype A] [Fintype B] : Type number of parameters: 6 fields: OAI.ThresholdParallelRepetition.Strategy.dimA : ℕ OAI.ThresholdParallelRepetition.Strategy.dimB : ℕ OAI.ThresholdParallelRepetition.Strategy.state : Fin (self.dimA + 1) × Fin (self.dimB + 1) → ℂ OAI.ThresholdParallelRepetition.Strategy.state_unit : ∑ i, Complex.normSq (self.state i) = 1 OAI.ThresholdParallelRepetition.Strategy.alice : X → A → Matrix (Fin (self.dimA + 1)) (Fin (self.dimA + 1)) ℂ OAI.ThresholdParallelRepetition.Strategy.bob : Y → B → Matrix (Fin (self.dimB + 1)) (Fin (self.dimB + 1)) ℂ OAI.ThresholdParallelRepetition.Strategy.alice_pos : ∀ (x : X) (a : A), (self.alice x a).PosSemidef OAI.ThresholdParallelRepetition.Strategy.bob_pos : ∀ (y : Y) (b : B), (self.bob y b).PosSemidef OAI.ThresholdParallelRepetition.Strategy.alice_total : ∀ (x : X), ∑ a, self.alice x a = 1 OAI.ThresholdParallelRepetition.Strategy.bob_total : ∀ (y : Y), ∑ b, self.bob y b = 1 constructor: OAI.ThresholdParallelRepetition.Strategy.mk {X Y A B : Type} [Fintype A] [Fintype B] (dimA dimB : ℕ) (state : Fin (dimA + 1) × Fin (dimB + 1) → ℂ) (state_unit : ∑ i, Complex.normSq (state i) = 1) (alice : X → A → Matrix (Fin (dimA + 1)) (Fin (dimA + 1)) ℂ) (bob : Y → B → Matrix (Fin (dimB + 1)) (Fin (dimB + 1)) ℂ) (alice_pos : ∀ (x : X) (a : A), (alice x a).PosSemidef) (bob_pos : ∀ (y : Y) (b : B), (bob y b).PosSemidef) (alice_total : ∀ (x : X), ∑ a, alice x a = 1) (bob_total : ∀ (y : Y), ∑ b, bob y b = 1) : OAI.ThresholdParallelRepetition.Strategy X Y A B def OAI.ThresholdParallelRepetition.Strategy.born : {X Y A B : Type} → [inst : Fintype A] → [inst_1 : Fintype B] → OAI.ThresholdParallelRepetition.Strategy X Y A B → X → Y → A → B → ℝ := fun {X Y A B} [Fintype A] [Fintype B] S x y a b => ∑ i, ∑ j, (star (S.state i) * (S.alice x a i.1 j.1 * S.bob y b i.2 j.2) * S.state j).re @[reducible] def OAI.ThresholdParallelRepetition.SingleStrategy : ℕ → ℕ → ℕ → ℕ → Type := fun x y a b => OAI.ThresholdParallelRepetition.Strategy (Fin (x + 1)) (Fin (y + 1)) (Fin (a + 1)) (Fin (b + 1)) def OAI.ThresholdParallelRepetition.successProbability : {x y a b : ℕ} → OAI.ThresholdParallelRepetition.Game x y a b → OAI.ThresholdParallelRepetition.SingleStrategy x y a b → ℝ := fun {x y a b} G S => ∑ z, G.questionProb z * ∑ w, if G.accepts z.1 z.2 w.1 w.2 = true then OAI.ThresholdParallelRepetition.Strategy.born S z.1 z.2 w.1 w.2 else 0 def OAI.ThresholdParallelRepetition.entangledValue : {x y a b : ℕ} → OAI.ThresholdParallelRepetition.Game x y a b → ℝ := fun {x y a b} G => sSup (Set.range (OAI.ThresholdParallelRepetition.successProbability G)) @[reducible] def OAI.ThresholdParallelRepetition.RepeatedStrategy : ℕ → ℕ → ℕ → ℕ → ℕ → Type := fun x y a b k => OAI.ThresholdParallelRepetition.Strategy (Fin k → Fin (x + 1)) (Fin k → Fin (y + 1)) (Fin k → Fin (a + 1)) (Fin k → Fin (b + 1)) def OAI.ThresholdParallelRepetition.wins : {x y a b k : ℕ} → OAI.ThresholdParallelRepetition.Game x y a b → (Fin k → Fin (x + 1)) → (Fin k → Fin (y + 1)) → (Fin k → Fin (a + 1)) → (Fin k → Fin (b + 1)) → ℕ := fun {x y a b k} G xs ys as bs => ∑ i, if G.accepts (xs i) (ys i) (as i) (bs i) = true then 1 else 0 def OAI.ThresholdParallelRepetition.thresholdProbability : {x y a b k : ℕ} → OAI.ThresholdParallelRepetition.Game x y a b → ℝ → OAI.ThresholdParallelRepetition.RepeatedStrategy x y a b k → ℝ := fun {x y a b k} G δ S => ∑ xs, ∑ ys, (∏ i, G.questionProb (xs i, ys i)) * ∑ as, ∑ bs, if ⌈(OAI.ThresholdParallelRepetition.entangledValue G + δ) * ↑k⌉₊ ≤ OAI.ThresholdParallelRepetition.wins G xs ys as bs then OAI.ThresholdParallelRepetition.Strategy.born S xs ys as bs else 0 def OAI.ThresholdParallelRepetition.thresholdValue : {x y a b : ℕ} → {k : ℕ} → OAI.ThresholdParallelRepetition.Game x y a b → ℝ → ℝ := fun {x y a b k} G δ => sSup (Set.range (OAI.ThresholdParallelRepetition.thresholdProbability G δ)) 