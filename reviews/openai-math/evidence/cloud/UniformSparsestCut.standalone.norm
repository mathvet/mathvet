OAI.UniformSparsestCut.mainGap : ∃ c, 0 < c ∧ ∃ n C, (∀ (j : ℕ), 2 ≤ n j) ∧ Filter.Tendsto n Filter.atTop Filter.atTop ∧ (∀ (j : ℕ), 0 < OAI.UniformSparsestCut.glValue (C j)) ∧ ∀ᶠ (j : ℕ) in Filter.atTop, c * √(Real.log ↑(n j)) / Real.log (Real.log ↑(n j)) ^ 3 ≤ OAI.UniformSparsestCut.OPT (C j) / OAI.UniformSparsestCut.glValue (C j) structure OAI.UniformSparsestCut.Capacity (n : ℕ) : Type number of parameters: 1 fields: OAI.UniformSparsestCut.Capacity.cap : Fin n → Fin n → ℝ OAI.UniformSparsestCut.Capacity.nonneg : ∀ (i j : Fin n), 0 ≤ self.cap i j OAI.UniformSparsestCut.Capacity.symm : ∀ (i j : Fin n), self.cap i j = self.cap j i OAI.UniformSparsestCut.Capacity.diagonal : ∀ (i : Fin n), self.cap i i = 0 constructor: OAI.UniformSparsestCut.Capacity.mk {n : ℕ} (cap : Fin n → Fin n → ℝ) (nonneg : ∀ (i j : Fin n), 0 ≤ cap i j) (symm : ∀ (i j : Fin n), cap i j = cap j i) (diagonal : ∀ (i : Fin n), cap i i = 0) : OAI.UniformSparsestCut.Capacity n def OAI.UniformSparsestCut.pairSum : {n : ℕ} → (Fin n → Fin n → ℝ) → ℝ := fun {n} f => ∑ i, ∑ j, if i < j then f i j else 0 def OAI.UniformSparsestCut.cutRatio : {n : ℕ} → OAI.UniformSparsestCut.Capacity n → Finset (Fin n) → ℝ := fun {n} C B => (∑ i ∈ B, ∑ j ∈ Bᶜ, C.cap i j) / (↑B.card * (↑n - ↑B.card)) def OAI.UniformSparsestCut.OPT : {n : ℕ} → OAI.UniformSparsestCut.Capacity n → ℝ := fun {n} C => sInf {r | ∃ B, B.Nonempty ∧ B ≠ Finset.univ ∧ r = OAI.UniformSparsestCut.cutRatio C B} def OAI.UniformSparsestCut.NegativeType : {n : ℕ} → (Fin n → Fin n → ℝ) → Prop := fun {n} d => (∃ x, ∀ (i j : Fin n), d i j = ‖x i - x j‖ ^ 2) ∧ ∀ (i j k : Fin n), d i k ≤ d i j + d j k def OAI.UniformSparsestCut.Feasible : {n : ℕ} → (Fin n → Fin n → ℝ) → Prop := fun {n} d => OAI.UniformSparsestCut.NegativeType d ∧ OAI.UniformSparsestCut.pairSum d = 1 def OAI.UniformSparsestCut.glValue : {n : ℕ} → OAI.UniformSparsestCut.Capacity n → ℝ := fun {n} C => sInf {r | ∃ d, OAI.UniformSparsestCut.Feasible d ∧ r = OAI.UniformSparsestCut.pairSum fun i j => C.cap i j * d i j} 