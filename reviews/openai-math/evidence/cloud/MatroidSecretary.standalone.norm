lineRule n bits → OAI.MatroidProphet.Seed bits → OAI.MatroidProphet.Weights n → OAI.MatroidProphet.Weights n → OAI.MatroidProphet.ArrivalOrder n → ℕ → Finset (Fin n) := fun {n bits} A r s v π t => {e | ↑((Equiv.symm π) e) < t ∧ OAI.MatroidProphet.decisionAt A r s v π ((Equiv.symm π) e) = true} def OAI.MatroidProphet.accepted : {n bits : ℕ} → OAI.MatroidProphet.OnlineRule n bits → OAI.MatroidProphet.Seed bits → OAI.MatroidProphet.Weights n → OAI.MatroidProphet.Weights n → OAI.MatroidProphet.ArrivalOrder n → Finset (Fin n) := fun {n bits} A r s v π => OAI.MatroidProphet.acceptedThrough A r s v π n def OAI.MatroidProphet.reward : {n bits : ℕ} → OAI.MatroidProphet.OnlineRule n bits → OAI.MatroidProphet.Seed bits → OAI.MatroidProphet.Weights n → OAI.MatroidProphet.Weights n → OAI.MatroidProphet.ArrivalOrder n → ℝ := fun {n bits} A r s v π => ∑ e ∈ OAI.MatroidProphet.accepted A r s v π, v e def OAI.MatroidProphet.optimum : {n : ℕ} → Matroid (Fin n) → OAI.MatroidProphet.Weights n → ℝ := fun {n} M v => Finset.univ.sup' ⋯ fun I => if M.Indep ↑I then ∑ e ∈ I, v e else 0 def OAI.MatroidProphet.Feasible : {n bits : ℕ} → Matroid (Fin n) → OAI.MatroidProphet.OnlineRule n bits → Prop := fun {n bits} M A => ∀ (r : OAI.MatroidProphet.Seed bits) (s v : OAI.MatroidProphet.Weights n) (π : OAI.MatroidProphet.ArrivalOrder n) (t : ℕ), (∀ (e : Fin n), 0 ≤ s e) → (∀ (e : Fin n), 0 ≤ v e) → M.Indep ↑(OAI.MatroidProphet.acceptedThrough A r s v π t) def OAI.MatroidProphet.pairedCoordinates.{u} : {n : ℕ} → {Ω : Type u} → (Ω → OAI.MatroidProphet.Weights n) → (Ω → OAI.MatroidProphet.Weights n) → Fin n × Bool → Ω → ℝ := fun {n} {Ω} S V i => if i.2 = true then fun ω => S ω i.1 else fun ω => V ω i.1 def OAI.MatroidProphet.OneSampleChallenge.{u} : Prop := ∀ (n : ℕ) (M : Matroid (Fin n)), M.E = Set.univ → ∃ bits ν, MeasureTheory.IsProbabilityMeasure ν ∧ ∃ A, OAI.MatroidProphet.Feasible M A ∧ ∀ {Ω : Type u} [inst : MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] (S V : Ω → OAI.MatroidProphet.Weights n) (R : Ω → OAI.MatroidProphet.Seed bits), Measurable S → Measurable V → Measurable R → (∀ᵐ (ω : Ω) ∂μ, ∀ (e : Fin n), 0 ≤ S ω e) → (∀ᵐ (ω : Ω) ∂μ, ∀ (e : Fin n), 0 ≤ V ω e) → ProbabilityTheory.iIndepFun (OAI.MatroidProphet.pairedCoordinates S V) μ → (∀ (e : Fin n), MeasureTheory.Measure.map (fun ω => S ω e) μ = MeasureTheory.Measure.map (fun ω => V ω e) μ) → ProbabilityTheory.IndepFun (fun ω => (S ω, V ω)) R μ → MeasureTheory.Measure.map R μ = ν → MeasureTheory.Integrable (fun ω => OAI.MatroidProphet.optimum M (V ω)) μ → ∀ (π : Ω → OAI.MatroidProphet.ArrivalOrder n), Measurable π → MeasureTheory.Integrable (fun ω => OAI.MatroidProphet.reward A (R ω) (S ω) (V ω) (π ω)) μ ∧ (2 ^ 310)⁻¹ * ∫ (ω : Ω), OAI.MatroidProphet.optimum M (V ω) ∂μ ≤ ∫ (ω : Ω), OAI.MatroidProphet.reward A (R ω) (S ω) (V ω) (π ω) ∂μ structure OAI.MatroidProphet.HiddenRule (n bits : ℕ) : Type number of parameters: 2 fields: OAI.MatroidProphet.HiddenRule.mask : OAI.MatroidProphet.Seed bits → Finset (Fin n) OAI.MatroidProphet.HiddenRule.core : OAI.MatroidProphet.OnlineRule n bits constructor: OAI.MatroidProphet.HiddenRule.mk {n bits : ℕ} (mask : OAI.MatroidProphet.Seed bits → Finset (Fin n)) (core : OAI.MatroidProphet.OnlineRule n bits) : OAI.MatroidProphet.HiddenRule n bits def OAI.MatroidProphet.observed : {n bits : ℕ} → OAI.MatroidProphet.HiddenRule n bits → OAI.MatroidProphet.Seed bits → OAI.MatroidProphet.Weights n → OAI.MatroidProphet.Weights n := fun {n bits} A r w e => if e ∈ A.mask r then w e else 0 def OAI.MatroidProphet.hiddenAcceptedThrough : {n bits : ℕ} → OAI.MatroidProphet.HiddenRule n bits → OAI.MatroidProphet.Seed bits → OAI.MatroidProphet.Weights n → OAI.MatroidProphet.ArrivalOrder n → ℕ → Finset (Fin n) := fun {n bits} A r w π t => OAI.MatroidProphet.acceptedThrough A.core r (OAI.MatroidProphet.observed A r w) w π t \ A.mask r def OAI.MatroidProphet.hiddenReward : {n bits : ℕ} → OAI.MatroidProphet.HiddenRule n bits → OAI.MatroidProphet.Seed bits → OAI.MatroidProphet.Weights n → OAI.MatroidProphet.ArrivalOrder n → ℝ := fun {n bits} A r w π => ∑ e ∈ OAI.MatroidProphet.hiddenAcceptedThrough A r w π n, w e def OAI.MatroidProphet.hiddenWorstReward : {n bits : ℕ} → OAI.MatroidProphet.HiddenRule n bits → OAI.MatroidProphet.Weights n → OAI.MatroidProphet.Seed bits → ℝ := fun {n bits} A w r => Finset.univ.inf' ⋯ (OAI.MatroidProphet.hiddenReward A r w) def OAI.MatroidProphet.HiddenVectorChallenge : Prop := ∀ (n : ℕ) (M : Matroid (Fin n)), M.E = Set.univ → ∃ bits ν, MeasureTheory.IsProbabilityMeasure ν ∧ ∃ A, (∀ (w : OAI.MatroidProphet.Weights n), (∀ (e : Fin n), 0 ≤ w e) → ∀ (r : OAI.MatroidProphet.Seed bits) (π : OAI.MatroidProphet.ArrivalOrder n) (t : ℕ), M.Indep ↑(OAI.MatroidProphet.hiddenAcceptedThrough A r w π t)) ∧ ∀ (w : OAI.MatroidProphet.Weights n), (∀ (e : Fin n), 0 ≤ w e) → (2 ^ 293)⁻¹ * OAI.MatroidProphet.optimum M w ≤ ∫ (r : OAI.MatroidProphet.Seed bits), OAI.MatroidProphet.hiddenWorstReward A w r ∂ν structure OAI.MatroidProphet.SecretaryRule.{u_1} (n : ℕ) (Q : Type u_1) [MeasurableSpace Q] : Type u_1 number of parameters: 3 fields: OAI.MatroidProphet.SecretaryRule.prefixLength : Q → Fin (n + 1) OAI.MatroidProphet.SecretaryRule.measurable_prefixLength : Measurable self.prefixLength OAI.MatroidProphet.SecretaryRule.decide : (k : Fin n) → Q → OAI.MatroidProphet.History n k → Bool OAI.MatroidProphet.SecretaryRule.measurable_decide : ∀ (k : Fin n), Measurable fun x => self.decide k x.1 x.2 constructor: OAI.MatroidProphet.SecretaryRule.mk.{u_1} {n : ℕ} {Q : Type u_1} [MeasurableSpace Q] (prefixLength : Q → Fin (n + 1)) (measurable_prefixLength : Measurable prefixLength) (decide : (k : Fin n) → Q → OAI.MatroidProphet.History n k → Bool) (measurable_decide : ∀ (k : Fin n), Measurable fun x => decide k x.1 x.2) : OAI.MatroidProphet.SecretaryRule n Q def OAI.MatroidProphet.SamePrefix : {n : ℕ} → ℕ → OAI.MatroidProphet.ArrivalOrder n → OAI.MatroidProphet.ArrivalOrder n → Prop := fun {n} K σ π => ∀ (k : Fin n), ↑k < K → σ k = π k def OAI.MatroidProphet.secretaryDecisionAt.{u_1} : {n : ℕ} → {Q : Type u_1} → [inst : MeasurableSpace Q] → OAI.MatroidProphet.SecretaryRule n Q → Q → OAI.MatroidProphet.Weights n → OAI.MatroidProphet.ArrivalOrder n → Fin n → Bool := fun {n} {Q} [MeasurableSpace Q] A q w π k => if ↑k < ↑(A.prefixLength q) then false else A.decide k q (OAI.MatroidProphet.history w π k) def OAI.MatroidProphet.secretaryAcceptedThrough.{u_1} : {n : ℕ} → {Q : Type u_1} → [inst : MeasurableSpace Q] → OAI.MatroidProphet.SecretaryRule n Q → Q → OAI.MatroidProphet.Weights n → OAI.MatroidProphet.ArrivalOrder n → ℕ → Finset (Fin n) := fun {n} {Q} [MeasurableSpace Q] A q w π t => {e | ↑((Equiv.symm π) e) < t ∧ OAI.MatroidProphet.secretaryDecisionAt A q w π ((Equiv.symm π) e) = true} def OAI.MatroidProphet.secretaryReward.{u_1} : {n : ℕ} → {Q : Type u_1} → [inst : MeasurableSpace Q] → OAI.MatroidProphet.SecretaryRule n Q → Q → OAI.MatroidProphet.Weights n → OAI.MatroidProphet.ArrivalOrder n → ℝ := fun {n} {Q} [MeasurableSpace Q] A q w π => ∑ e ∈ OAI.MatroidProphet.secretaryAcceptedThrough A q w π n, w e def OAI.MatroidProphet.SecretaryFeasible.{u_1} : {n : ℕ} → {Q : Type u_1} → [inst : MeasurableSpace Q] → Matroid (Fin n) → OAI.MatroidProphet.SecretaryRule n Q → Prop := fun {n} {Q} [MeasurableSpace Q] M A => ∀ (q : Q) (w : OAI.MatroidProphet.Weights n), (∀ (e : Fin n), 0 ≤ w e) → ∀ (π : OAI.MatroidProphet.ArrivalOrder n) (t : ℕ), M.Indep ↑(OAI.MatroidProphet.secretaryAcceptedThrough A q w π t) def OAI.MatroidProphet.Secretary.uniformArrivalLaw : (n : ℕ) → MeasureTheory.Measure (OAI.MatroidProphet.ArrivalOrder n) := fun n => (PMF.uniformOfFintype (OAI.MatroidProphet.ArrivalOrder n)).toMeasure def OAI.MatroidProphet.SecretaryChallenge.{u} : Prop := ∀ (n : ℕ) (M : Matroid (Fin n)), M.E = Set.univ → ∃ q ν, MeasureTheory.IsProbabilityMeasure ν ∧ ∃ A, OAI.MatroidProphet.SecretaryFeasible M A ∧ ∀ (w : OAI.MatroidProphet.Weights n), (∀ (e : Fin n), 0 ≤ w e) → ∀ {Ω : Type u} [inst : MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] (Q : Ω → Fin q) (σ π : Ω → OAI.MatroidProphet.ArrivalOrder n), Measurable Q → Measurable σ → Measurable π → MeasureTheory.Measure.map Q μ = ν → MeasureTheory.Measure.map σ μ = OAI.MatroidProphet.Secretary.uniformArrivalLaw n → ProbabilityTheory.IndepFun Q σ μ → (∀ᵐ (ω : Ω) ∂μ, OAI.MatroidProphet.SamePrefix (↑(A.prefixLength (Q ω))) (σ ω) (π ω)) → MeasureTheory.Integrable (fun ω => OAI.MatroidProphet.secretaryReward A (Q ω) w (π ω)) μ ∧ (2 ^ 293)⁻¹ * OAI.MatroidProphet.optimum M w ≤ ∫ (ω : Ω), OAI.MatroidProphet.secretaryReward A (Q ω) w (π ω) ∂μ 