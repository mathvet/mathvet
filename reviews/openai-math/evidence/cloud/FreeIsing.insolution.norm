OAI.Problem367.free_ising_factor_iff_threshold : ∀ (d : ℕ) (beta : ℝ), 3 ≤ d → 0 ≤ beta → (OAI.Problem367.IsFactorOfIID d (Real.tanh beta) ↔ Real.tanh beta ≤ 1 / √(↑d - 1)) @[reducible] def OAI.Problem367.TreeVertex : ℕ → Type := fun d => { word // List.IsChain (fun first second => first ≠ second) word } def OAI.Problem367.treeAdj : {d : ℕ} → OAI.Problem367.TreeVertex d → OAI.Problem367.TreeVertex d → Prop := fun {d} u v => (∃ c, ↑v = ↑u ++ [c]) ∨ ∃ c, ↑u = ↑v ++ [c] structure OAI.Problem367.TreeAut (d : ℕ) : Type number of parameters: 1 fields: OAI.Problem367.TreeAut.toEquiv : OAI.Problem367.TreeVertex d ≃ OAI.Problem367.TreeVertex d OAI.Problem367.TreeAut.map_adj : ∀ (u v : OAI.Problem367.TreeVertex d), OAI.Problem367.treeAdj (self.toEquiv u) (self.toEquiv v) ↔ OAI.Problem367.treeAdj u v constructor: OAI.Problem367.TreeAut.mk {d : ℕ} (toEquiv : OAI.Problem367.TreeVertex d ≃ OAI.Problem367.TreeVertex d) (map_adj : ∀ (u v : OAI.Problem367.TreeVertex d), OAI.Problem367.treeAdj (toEquiv u) (toEquiv v) ↔ OAI.Problem367.treeAdj u v) : OAI.Problem367.TreeAut d def OAI.Problem367.relabel.{u_1} : {d : ℕ} → {α : Type u_1} → OAI.Problem367.TreeAut d → (OAI.Problem367.TreeVertex d → α) → OAI.Problem367.TreeVertex d → α := fun {d} {α} g x v => x (g.toEquiv.symm v) inductive OAI.Problem367.IsingSpin : Type number of parameters: 0 constructors: OAI.Problem367.IsingSpin.neg : OAI.Problem367.IsingSpin OAI.Problem367.IsingSpin.pos : OAI.Problem367.IsingSpin @[reducible] protected def OAI.Problem367.IsingSpin.enumList : List OAI.Problem367.IsingSpin := [OAI.Problem367.IsingSpin.neg, OAI.Problem367.IsingSpin.pos] def OAI.Problem367.uniform01 : MeasureTheory.Measure ℝ := MeasureTheory.volume.restrict (Set.Icc 0 1) def OAI.Problem367.labelMeasure : (d : ℕ) → MeasureTheory.Measure (OAI.Problem367.TreeVertex d → ℝ) := fun d => MeasureTheory.Measure.infinitePi fun x => OAI.Problem367.uniform01 def OAI.Problem367.ConnectedFinset : {d : ℕ} → Finset (OAI.Problem367.TreeVertex d) → Prop := fun {d} D => D.Nonempty ∧ ∀ u ∈ D, ∀ v ∈ D, Relation.ReflTransGen (fun x y => x ∈ D ∧ y ∈ D ∧ OAI.Problem367.treeAdj x y) u v def OAI.Problem367.inducedEdges : {d : ℕ} → Finset (OAI.Problem367.TreeVertex d) → Finset (OAI.Problem367.TreeVertex d × OAI.Problem367.TreeVertex d) := fun {d} D => {e ∈ D.product D | OAI.Problem367.treeAdj e.1 e.2 ∧ (↑e.1).length < (↑e.2).length} def OAI.Problem367.freeCylinderWeight : {d : ℕ} → ℝ → Finset (OAI.Problem367.TreeVertex d) → (OAI.Problem367.TreeVertex d → OAI.Problem367.IsingSpin) → ENNReal := fun {d} theta D eta => ENNReal.ofReal (1 / 2 * ∏ e ∈ OAI.Problem367.inducedEdges D, (1 + if eta e.1 = eta e.2 then theta else -theta) / 2) def OAI.Problem367.HasFreeIsingLaw : {d : ℕ} → ℝ → MeasureTheory.Measure (OAI.Problem367.TreeVertex d → OAI.Problem367.IsingSpin) → Prop := fun {d} theta mu => ∀ (D : Finset (OAI.Problem367.TreeVertex d)), OAI.Problem367.ConnectedFinset D → ∀ (eta : OAI.Problem367.TreeVertex d → OAI.Problem367.IsingSpin), mu {x | ∀ v ∈ D, x v = eta v} = OAI.Problem367.freeCylinderWeight theta D eta def OAI.Problem367.IsFactorOfIID : ℕ → ℝ → Prop := fun d theta => ∃ Phi, Measurable Phi ∧ OAI.Problem367.HasFreeIsingLaw theta (MeasureTheory.Measure.map Phi (OAI.Problem367.labelMeasure d)) ∧ ∀ (g : OAI.Problem367.TreeAut d), ∀ᵐ (U : OAI.Problem367.TreeVertex d → ℝ) ∂OAI.Problem367.labelMeasure d, Phi (OAI.Problem367.relabel g U) = OAI.Problem367.relabel g (Phi U) 