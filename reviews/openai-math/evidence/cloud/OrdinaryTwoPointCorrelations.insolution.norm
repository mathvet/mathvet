OAI.OrdinaryTwoPointCorrelations.liouville_log_saving : ∃ c, 0 < c ∧ ∀ (a₁ a₂ b₁ b₂ : ℕ), 0 < a₁ → 0 < a₂ → a₁ * b₂ ≠ a₂ * b₁ → ∃ C, 0 < C ∧ ∀ (X : ℝ), 3 ≤ X → ‖OAI.TwoPointCorrelations.affineSum OAI.TwoPointCorrelations.liouville OAI.TwoPointCorrelations.liouville a₁ a₂ b₁ b₂ ⌊X⌋₊‖ ≤ C * X / (Real.log X).rpow c OAI.OrdinaryTwoPointCorrelations.binary_corrected_elliott : ∀ (f₁ f₂ : ℕ → ℂ), OAI.TwoPointCorrelations.Multiplicative f₁ → OAI.TwoPointCorrelations.Multiplicative f₂ → OAI.TwoPointCorrelations.OneBounded f₁ → OAI.TwoPointCorrelations.OneBounded f₂ → OAI.TwoPointCorrelations.UniformlyNonpretentious f₁ ∨ OAI.TwoPointCorrelations.UniformlyNonpretentious f₂ → ∀ (h₁ h₂ : ℕ), h₁ ≠ h₂ → Filter.Tendsto (fun N => OAI.TwoPointCorrelations.correlationSum f₁ f₂ h₁ h₂ N / ↑N) Filter.atTop (nhds 0) OAI.OrdinaryTwoPointCorrelations.affine_corrected_elliott : ∀ (f₁ f₂ : ℕ → ℂ), OAI.TwoPointCorrelations.Multiplicative f₁ → OAI.TwoPointCorrelations.Multiplicative f₂ → OAI.TwoPointCorrelations.OneBounded f₁ → OAI.TwoPointCorrelations.OneBounded f₂ → OAI.TwoPointCorrelations.UniformlyNonpretentious f₁ ∨ OAI.TwoPointCorrelations.UniformlyNonpretentious f₂ → ∀ (a₁ a₂ b₁ b₂ : ℕ), 0 < a₁ → 0 < a₂ → a₁ * b₂ ≠ a₂ * b₁ → Filter.Tendsto (fun N => OAI.TwoPointCorrelations.affineSum f₁ f₂ a₁ a₂ b₁ b₂ N / ↑N) Filter.atTop (nhds 0) def OAI.TwoPointCorrelations.liouville : ℕ → ℂ := fun n => ↑(ArithmeticFunction.liouville n) def OAI.TwoPointCorrelations.correlationSum : (ℕ → ℂ) → (ℕ → ℂ) → ℕ → ℕ → ℕ → ℂ := fun f g h₁ h₂ N => ∑ n ∈ Finset.Icc 1 N, f (n + h₁) * g (n + h₂) def OAI.TwoPointCorrelations.affineSum : (ℕ → ℂ) → (ℕ → ℂ) → ℕ → ℕ → ℕ → ℕ → ℕ → ℂ := fun f g a₁ a₂ b₁ b₂ N => ∑ n ∈ Finset.Icc 1 N, f (a₁ * n + b₁) * g (a₂ * n + b₂) def OAI.TwoPointCorrelations.Multiplicative : (ℕ → ℂ) → Prop := fun f => ∀ (m n : ℕ), 0 < m → 0 < n → m.Coprime n → f (m * n) = f m * f n def OAI.TwoPointCorrelations.OneBounded : (ℕ → ℂ) → Prop := fun f => ∀ (n : ℕ), 0 < n → ‖f n‖ ≤ 1 def OAI.TwoPointCorrelations.primesUpTo : ℕ → Finset ℕ := fun N => Finset.filter Nat.Prime (Finset.range (N + 1)) def OAI.TwoPointCorrelations.squaredDistance : (ℕ → ℂ) → (ℕ → ℂ) → ℕ → ℝ := fun f g N => ∑ p ∈ OAI.TwoPointCorrelations.primesUpTo N, (1 - (f p * (starRingEnd ℂ) (g p)).re) / ↑p def OAI.TwoPointCorrelations.characterTwist : {q : ℕ} → DirichletCharacter ℂ q → ℝ → ℕ → ℂ := fun {q} χ t n => χ ↑n * Complex.exp (↑(t * Real.log ↑n) * Complex.I) def OAI.TwoPointCorrelations.UniformlyNonpretentious : (ℕ → ℂ) → Prop := fun f => ∀ (q : ℕ), 0 < q → ∀ (χ : DirichletCharacter ℂ q) (K : ℝ), ∀ᶠ (N : ℕ) in Filter.atTop, ∀ (t : ℝ), |t| ≤ ↑N → K ≤ OAI.TwoPointCorrelations.squaredDistance f (OAI.TwoPointCorrelations.characterTwist χ t) N 