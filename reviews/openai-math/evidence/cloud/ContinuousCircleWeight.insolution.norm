OAI.ContinuousCircleWeight.main_theorem : OAI.ContinuousCircleWeight.MainStatement @[reducible] def OAI.ContinuousCircleWeight.CircleX : Type := AddCircle 1 @[reducible] def OAI.ContinuousCircleWeight.TracialHilbert : AddSubgroup (PreLp fun x => ℂ) := lp (fun x => ℂ) 2 @[reducible] def OAI.ContinuousCircleWeight.Operator : Type := ↥OAI.ContinuousCircleWeight.TracialHilbert →L[ℂ] ↥OAI.ContinuousCircleWeight.TracialHilbert def OAI.ContinuousCircleWeight.circleIdentification : OAI.ContinuousCircleWeight.CircleX ≃ₜ Circle := AddCircle.homeomorphCircle OAI.ContinuousCircleWeight.circleIdentification._proof_1 def OAI.ContinuousCircleWeight.circleFunction : C(OAI.ContinuousCircleWeight.CircleX, ℝ) → ℂ → ℂ := fun f z => if hz : ‖z‖ = 1 then ↑(f (OAI.ContinuousCircleWeight.circleIdentification.symm ⟨z, ⋯⟩)) else 0 def OAI.ContinuousCircleWeight.negativeLog : ℝ → ENNReal := fun t => if t = 0 then ⊤ else ENNReal.ofReal (-Real.log t) structure OAI.ContinuousCircleWeight.IsTracialRotation (θ : ℝ) (U V : ↥(unitary OAI.ContinuousCircleWeight.Operator)) (e : ↥OAI.ContinuousCircleWeight.TracialHilbert) : Prop number of parameters: 4 fields: OAI.ContinuousCircleWeight.IsTracialRotation.relation : ↑V * ↑U = Complex.exp (2 * ↑Real.pi * ↑θ * Complex.I) • (↑U * ↑V) OAI.ContinuousCircleWeight.IsTracialRotation.moments : ∀ (m n : ℤ), inner ℂ e (↑(U ^ m * V ^ n) e) = if m = 0 ∧ n = 0 then 1 else 0 OAI.ContinuousCircleWeight.IsTracialRotation.cyclic : (Submodule.span ℂ (Set.range fun mn => ↑(U ^ mn.1 * V ^ mn.2) e)).topologicalClosure = ⊤ constructor: OAI.ContinuousCircleWeight.IsTracialRotation.mk {θ : ℝ} {U V : ↥(unitary OAI.ContinuousCircleWeight.Operator)} {e : ↥OAI.ContinuousCircleWeight.TracialHilbert} (relation : ↑V * ↑U = Complex.exp (2 * ↑Real.pi * ↑θ * Complex.I) • (↑U * ↑V)) (moments : ∀ (m n : ℤ), inner ℂ e (↑(U ^ m * V ^ n) e) = if m = 0 ∧ n = 0 then 1 else 0) (cyclic : (Submodule.span ℂ (Set.range fun mn => ↑(U ^ mn.1 * V ^ mn.2) e)).topologicalClosure = ⊤) : OAI.ContinuousCircleWeight.IsTracialRotation θ U V e def OAI.ContinuousCircleWeight.rotationAlgebra : ↥(unitary OAI.ContinuousCircleWeight.Operator) → ↥(unitary OAI.ContinuousCircleWeight.Operator) → Set OAI.ContinuousCircleWeight.Operator := fun U V => {↑U, ↑V}.centralizer.centralizer def OAI.ContinuousCircleWeight.weightedRotation : ↥(unitary OAI.ContinuousCircleWeight.Operator) → ↥(unitary OAI.ContinuousCircleWeight.Operator) → C(OAI.ContinuousCircleWeight.CircleX, ℝ) → OAI.ContinuousCircleWeight.Operator := fun U V f => ↑U * cfc (OAI.ContinuousCircleWeight.circleFunction f) ↑V def OAI.ContinuousCircleWeight.MainStatement : Prop := ∃ θ f U V e, 0 < θ ∧ θ < 1 ∧ Irrational θ ∧ OAI.ContinuousCircleWeight.IsTracialRotation θ U V e ∧ (∀ (x : OAI.ContinuousCircleWeight.CircleX), 0 ≤ f x ∧ f x ≤ 1) ∧ (∃ z, ∀ (x : OAI.ContinuousCircleWeight.CircleX), f x = 0 ↔ x = z) ∧ ∫⁻ (x : OAI.ContinuousCircleWeight.CircleX), OAI.ContinuousCircleWeight.negativeLog (f x) = ⊤ ∧ ∀ p ∈ OAI.ContinuousCircleWeight.rotationAlgebra U V, IsStarProjection p → (1 - p) * OAI.ContinuousCircleWeight.weightedRotation U V f * p = 0 → p = 0 ∨ p = 1 