x) := fun {X} S x => (↑(S.projector x)).range def OAI.SplitTangent.TangentSplitting.second.{u} : {X : OAI.SplitTangent.ComplexManifold} → OAI.SplitTangent.TangentSplitting X → (x : X.Carrier) → Submodule ℂ (OAI.SplitTangent.Tangent X x) := fun {X} S x => (↑(S.projector x)).ker def OAI.SplitTangent.HolomorphicSectionOn.{u} : (X : OAI.SplitTangent.ComplexManifold) → ((x : X.Carrier) → OAI.SplitTangent.Tangent X x) → Set X.Carrier → Prop := fun X V U => ContMDiffOn (OAI.SplitTangent.ModelWithCorners X) ((OAI.SplitTangent.ModelWithCorners X).prod (modelWithCornersSelf ℂ (OAI.SplitTangent.Model X))) ⊤ (fun x => ⟨x, V x⟩) U def OAI.SplitTangent.Integrable.{u} : (X : OAI.SplitTangent.ComplexManifold) → ((x : X.Carrier) → Submodule ℂ (OAI.SplitTangent.Tangent X x)) → Prop := fun X D => ∀ (U : Set X.Carrier), IsOpen U → ∀ (V W : (x : X.Carrier) → OAI.SplitTangent.Tangent X x), OAI.SplitTangent.HolomorphicSectionOn X V U → OAI.SplitTangent.HolomorphicSectionOn X W U → (∀ x ∈ U, V x ∈ D x) → (∀ x ∈ U, W x ∈ D x) → ∀ x ∈ U, VectorField.mlieBracketWithin (OAI.SplitTangent.ModelWithCorners X) V W U x ∈ D x def OAI.SplitTangent.IntegrabilityStatement.{u} : Prop := ∀ (X : OAI.SplitTangent.ComplexManifold), ConnectedSpace X.Carrier → CompactSpace X.Carrier → 2 ≤ X.dim → ∀ (e : OAI.SplitTangent.ProjectiveEmbedding X), OAI.SplitTangent.RationallyConnected e → ∀ (S : OAI.SplitTangent.TangentSplitting X), OAI.SplitTangent.Integrable X S.first ∧ OAI.SplitTangent.Integrable X S.second 