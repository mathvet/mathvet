OAI.DeligneDrinfeld.main : OAI.DeligneDrinfeld.MainStatement @[reducible] def OAI.DeligneDrinfeld.L : Type := FreeLieAlgebra ℚ Bool def OAI.DeligneDrinfeld.x : OAI.DeligneDrinfeld.L := FreeLieAlgebra.of ℚ false def OAI.DeligneDrinfeld.y : OAI.DeligneDrinfeld.L := FreeLieAlgebra.of ℚ true def OAI.DeligneDrinfeld.eval.{u_1} : {M : Type u_1} → [inst : LieRing M] → [inst_1 : LieAlgebra ℚ M] → M → M → OAI.DeligneDrinfeld.L →ₗ⁅ℚ⁆ M := fun {M} [LieRing M] [LieAlgebra ℚ M] a b => (FreeLieAlgebra.lift ℚ) fun i => if i = true then b else a @[reducible] def OAI.DeligneDrinfeld.Edge : Type := { p // p.1 < p.2 } @[reducible] def OAI.DeligneDrinfeld.BraidFree : Type := FreeLieAlgebra ℚ OAI.DeligneDrinfeld.Edge def OAI.DeligneDrinfeld.chord : Fin 4 → Fin 4 → OAI.DeligneDrinfeld.BraidFree := fun i j => if h : i < j then FreeLieAlgebra.of ℚ ⟨(i, j), h⟩ else if h : j < i then FreeLieAlgebra.of ℚ ⟨(j, i), h⟩ else 0 def OAI.DeligneDrinfeld.braidRelations : Set OAI.DeligneDrinfeld.BraidFree := {z | (∃ i j k l, i ≠ j ∧ i ≠ k ∧ i ≠ l ∧ j ≠ k ∧ j ≠ l ∧ k ≠ l ∧ z = ⁅OAI.DeligneDrinfeld.chord i j, OAI.DeligneDrinfeld.chord k l⁆) ∨ ∃ i j k, i ≠ j ∧ i ≠ k ∧ j ≠ k ∧ z = ⁅OAI.DeligneDrinfeld.chord i j, OAI.DeligneDrinfeld.chord i k + OAI.DeligneDrinfeld.chord j k⁆} def OAI.DeligneDrinfeld.braidIdeal : LieIdeal ℚ OAI.DeligneDrinfeld.BraidFree := LieSubmodule.lieSpan ℚ OAI.DeligneDrinfeld.BraidFree OAI.DeligneDrinfeld.braidRelations @[reducible] def OAI.DeligneDrinfeld.T4 : Type := OAI.DeligneDrinfeld.BraidFree ⧸ OAI.DeligneDrinfeld.braidIdeal def OAI.DeligneDrinfeld.t : Fin 4 → Fin 4 → OAI.DeligneDrinfeld.T4 := fun i j => LieSubmodule.Quotient.mk (OAI.DeligneDrinfeld.chord i j) def OAI.DeligneDrinfeld.IsSolution : OAI.DeligneDrinfeld.L → Prop := fun p => p + (OAI.DeligneDrinfeld.eval OAI.DeligneDrinfeld.y OAI.DeligneDrinfeld.x) p = 0 ∧ p + (OAI.DeligneDrinfeld.eval OAI.DeligneDrinfeld.y (-OAI.DeligneDrinfeld.x - OAI.DeligneDrinfeld.y)) p + (OAI.DeligneDrinfeld.eval (-OAI.DeligneDrinfeld.x - OAI.DeligneDrinfeld.y) OAI.DeligneDrinfeld.x) p = 0 ∧ (OAI.DeligneDrinfeld.eval (OAI.DeligneDrinfeld.t 0 1) (OAI.DeligneDrinfeld.t 1 2 + OAI.DeligneDrinfeld.t 1 3)) p + (OAI.DeligneDrinfeld.eval (OAI.DeligneDrinfeld.t 0 2 + OAI.DeligneDrinfeld.t 1 2) (OAI.DeligneDrinfeld.t 2 3)) p = (OAI.DeligneDrinfeld.eval (OAI.DeligneDrinfeld.t 1 2) (OAI.DeligneDrinfeld.t 2 3)) p + (OAI.DeligneDrinfeld.eval (OAI.DeligneDrinfeld.t 0 1 + OAI.DeligneDrinfeld.t 0 2) (OAI.DeligneDrinfeld.t 1 3 + OAI.DeligneDrinfeld.t 2 3)) p + (OAI.DeligneDrinfeld.eval (OAI.DeligneDrinfeld.t 0 1) (OAI.DeligneDrinfeld.t 1 2)) p def OAI.DeligneDrinfeld.W : Submodule ℚ OAI.DeligneDrinfeld.L := { carrier := {p | OAI.DeligneDrinfeld.IsSolution p}, add_mem' := @OAI.DeligneDrinfeld.W._proof_2, zero_mem' := OAI.DeligneDrinfeld.W._proof_3, smul_mem' := OAI.DeligneDrinfeld.W._proof_4 } structure OAI.DeligneDrinfeld.Tangent : Type number of parameters: 0 fields: OAI.DeligneDrinfeld.Tangent.base : OAI.DeligneDrinfeld.L OAI.DeligneDrinfeld.Tangent.velocity : OAI.DeligneDrinfeld.L constructor: OAI.DeligneDrinfeld.Tangent.mk (base velocity : OAI.DeligneDrinfeld.L) : OAI.DeligneDrinfeld.Tangent def OAI.DeligneDrinfeld.Tangent.equiv : OAI.DeligneDrinfeld.Tangent ≃ OAI.DeligneDrinfeld.L × OAI.DeligneDrinfeld.L := { toFun := fun z => (z.base, z.velocity), invFun := fun z => { base := z.1, velocity := z.2 }, left_inv := OAI.DeligneDrinfeld.Tangent.equiv._proof_1, right_inv := OAI.DeligneDrinfeld.Tangent.equiv._proof_2 } def OAI.DeligneDrinfeld.tangentLift : OAI.DeligneDrinfeld.L → OAI.DeligneDrinfeld.L →ₗ⁅ℚ⁆ OAI.DeligneDrinfeld.Tangent := fun p => (FreeLieAlgebra.lift ℚ) fun i => if i = true then { base := OAI.DeligneDrinfeld.y, velocity := ⁅OAI.DeligneDrinfeld.y, p⁆ } else { base := OAI.DeligneDrinfeld.x, velocity := 0 } def OAI.DeligneDrinfeld.D : OAI.DeligneDrinfeld.L → OAI.DeligneDrinfeld.L → OAI.DeligneDrinfeld.L := fun p q => ((OAI.DeligneDrinfeld.tangentLift p) q).velocity def OAI.DeligneDrinfeld.ihara : OAI.DeligneDrinfeld.L → OAI.DeligneDrinfeld.L → OAI.DeligneDrinfeld.L := fun p q => OAI.DeligneDrinfeld.D p q - OAI.DeligneDrinfeld.D q p + ⁅p, q⁆ inductive OAI.DeligneDrinfeld.WeightedWord.{u_1} : {α : Type u_1} → (α → ℕ) → ℕ → FreeLieAlgebra ℚ α → Prop number of parameters: 2 constructors: OAI.DeligneDrinfeld.WeightedWord.generator : ∀ {α : Type u_1} {wt : α → ℕ} (a : α), OAI.DeligneDrinfeld.WeightedWord wt (wt a) (FreeLieAlgebra.of ℚ a) OAI.DeligneDrinfeld.WeightedWord.bracket : ∀ {α : Type u_1} {wt : α → ℕ} {n m : ℕ} {a b : FreeLieAlgebra ℚ α}, OAI.DeligneDrinfeld.WeightedWord wt n a → OAI.DeligneDrinfeld.WeightedWord wt m b → OAI.DeligneDrinfeld.WeightedWord wt (n + m) ⁅a, b⁆ def OAI.DeligneDrinfeld.weightPiece.{u_1} : {α : Type u_1} → (α → ℕ) → ℕ → Submodule ℚ (FreeLieAlgebra ℚ α) := fun {α} wt n => Submodule.span ℚ {p | OAI.DeligneDrinfeld.WeightedWord wt n p} @[reducible] def OAI.DeligneDrinfeld.OddFree : Type := FreeLieAlgebra ℚ ℕ def OAI.DeligneDrinfeld.oddWeight : ℕ → ℕ := fun k => 2 * k + 3 @[reducible] def OAI.DeligneDrinfeld.Fn : ℕ → Submodule ℚ (FreeLieAlgebra ℚ ℕ) := fun n => OAI.DeligneDrinfeld.weightPiece OAI.DeligneDrinfeld.oddWeight n @[reducible] def OAI.DeligneDrinfeld.Ln : ℕ → Submodule ℚ (FreeLieAlgebra ℚ Bool) := fun n => OAI.DeligneDrinfeld.weightPiece (fun x => 1) n @[reducible] def OAI.DeligneDrinfeld.Wn : ℕ → Submodule ℚ OAI.DeligneDrinfeld.L := fun n => OAI.DeligneDrinfeld.W ⊓ OAI.DeligneDrinfeld.Ln n def OAI.DeligneDrinfeld.Graded : (OAI.DeligneDrinfeld.OddFree ≃ₗ[ℚ] ↥OAI.DeligneDrinfeld.W) → Prop := fun e => ∀ (n : ℕ) (a : OAI.DeligneDrinfeld.OddFree), ↑(e a) ∈ OAI.DeligneDrinfeld.Ln n ↔ a ∈ OAI.DeligneDrinfeld.Fn n @[reducible] def OAI.DeligneDrinfeld.OddCompletion : Type := (n : ℕ) → ↥(OAI.DeligneDrinfeld.Fn n) @[reducible] def OAI.DeligneDrinfeld.WCompletion : Type := (n : ℕ) → ↥(OAI.DeligneDrinfeld.Wn n) def OAI.DeligneDrinfeld.completed : (e : OAI.DeligneDrinfeld.OddFree ≃ₗ[ℚ] ↥OAI.DeligneDrinfeld.W) → OAI.DeligneDrinfeld.Graded e → OAI.DeligneDrinfeld.OddCompletion → OAI.DeligneDrinfeld.WCompletion := fun e h a n => ⟨↑(e ↑(a n)), ⋯⟩ def OAI.DeligneDrinfeld.completedInv : (e : OAI.DeligneDrinfeld.OddFree ≃ₗ[ℚ] ↥OAI.DeligneDrinfeld.W) → OAI.DeligneDrinfeld.Graded e → OAI.DeligneDrinfeld.WCompletion → OAI.DeligneDrinfeld.OddCompletion := fun e h a n => ⟨e.symm ⟨↑(a n), ⋯⟩, ⋯⟩ def OAI.DeligneDrinfeld.MainStatement : Prop := ∃ e, ∃ (h : OAI.DeligneDrinfeld.Graded e), (∀ (a b : OAI.DeligneDrinfeld.OddFree), ↑(e ⁅a, b⁆) = OAI.DeligneDrinfeld.ihara ↑(e a) ↑(e b)) ∧ Function.LeftInverse (OAI.DeligneDrinfeld.completedInv e h) (OAI.DeligneDrinfeld.completed e h) ∧ Function.RightInverse (OAI.DeligneDrinfeld.completedInv e h) (OAI.DeligneDrinfeld.completed e h) ∧ Continuous (OAI.DeligneDrinfeld.completed e h) ∧ Continuous (OAI.DeligneDrinfeld.completedInv e h) ∧ ∀ (a b : OAI.DeligneDrinfeld.OddCompletion) (n : ℕ), ↑(e (∑ i ∈ Finset.range (n + 1), ⁅↑(a i), ↑(b (n - i))⁆)) = ∑ i ∈ Finset.range (n + 1), OAI.DeligneDrinfeld.ihara ↑(OAI.DeligneDrinfeld.completed e h a i) ↑(OAI.DeligneDrinfeld.completed e h b (n - i)) 