@OAI.MatchingEntropyBounds.Refined.pointwise_entropy : ∀ {V : Type u_1} {E : Type u_2} [inst : Fintype V] [inst_1 : Fintype E] [DecidableEq V] [inst_3 : DecidableEq E] (G : OAI.MatchingEntropyBounds.LooplessGraph V E) (m : ℕ), 0 < m → Fintype.card V = 2 * m → Nonempty G.Matching → ∀ x ∈ G.polytope, OAI.MatchingEntropyBounds.entropy x - (2 - 2 / ↑m) * OAI.MatchingEntropyBounds.Refined.complementEntropy x ≤ OAI.MatchingEntropyBounds.maxMatchingEntropy G x ∧ OAI.MatchingEntropyBounds.maxMatchingEntropy G x ≤ OAI.MatchingEntropyBounds.entropy x structure OAI.MatchingEntropyBounds.LooplessGraph.{uV, uE} (V : Type uV) (E : Type uE) : Type (max uE uV) number of parameters: 2 fields: OAI.MatchingEntropyBounds.LooplessGraph.left : E → V OAI.MatchingEntropyBounds.LooplessGraph.right : E → V OAI.MatchingEntropyBounds.LooplessGraph.loopless : ∀ (e : E), self.left e ≠ self.right e constructor: OAI.MatchingEntropyBounds.LooplessGraph.mk.{uV, uE} {V : Type uV} {E : Type uE} (left right : E → V) (loopless : ∀ (e : E), left e ≠ right e) : OAI.MatchingEntropyBounds.LooplessGraph V E def OAI.MatchingEntropyBounds.LooplessGraph.Incident.{uV, uE} : {V : Type uV} → {E : Type uE} → OAI.MatchingEntropyBounds.LooplessGraph V E → V → E → Prop := fun {V} {E} G v e => G.left e = v ∨ G.right e = v def OAI.MatchingEntropyBounds.LooplessGraph.IsPerfectMatching.{uV, uE} : {V : Type uV} → {E : Type uE} → OAI.MatchingEntropyBounds.LooplessGraph V E → Finset E → Prop := fun {V} {E} G M => ∀ (v : V), ∃! e, e ∈ M ∧ G.Incident v e @[reducible] def OAI.MatchingEntropyBounds.LooplessGraph.Matching.{uV, uE} : {V : Type uV} → {E : Type uE} → OAI.MatchingEntropyBounds.LooplessGraph V E → Type (max 0 uE) := fun {V} {E} G => { M // G.IsPerfectMatching M } def OAI.MatchingEntropyBounds.LooplessGraph.indicator.{uV, uE} : {V : Type uV} → {E : Type uE} → [DecidableEq E] → (G : OAI.MatchingEntropyBounds.LooplessGraph V E) → G.Matching → E → ℝ := fun {V} {E} [DecidableEq E] G M e => if e ∈ ↑M then 1 else 0 def OAI.MatchingEntropyBounds.LooplessGraph.polytope.{uV, uE} : {V : Type uV} → {E : Type uE} → [DecidableEq E] → OAI.MatchingEntropyBounds.LooplessGraph V E → Set (E → ℝ) := fun {V} {E} [DecidableEq E] G => (convexHull ℝ) (Set.range G.indicator) def OAI.MatchingEntropyBounds.LooplessGraph.mean.{uV, uE} : {V : Type uV} → {E : Type uE} → [Fintype E] → [DecidableEq E] → (G : OAI.MatchingEntropyBounds.LooplessGraph V E) → (G.Matching → ℝ) → E → ℝ := fun {V} {E} [Fintype E] [DecidableEq E] G p e => ∑ M, p M * G.indicator M e def OAI.MatchingEntropyBounds.probabilitySimplex.{uIndex} : (Index : Type uIndex) → [Fintype Index] → Set (Index → ℝ) := fun Index [Fintype Index] => {weights | (∀ (index : Index), 0 ≤ weights index) ∧ ∑ index, weights index = 1} def OAI.MatchingEntropyBounds.LooplessGraph.feasibleLaws.{uV, uE} : {V : Type uV} → {E : Type uE} → [Fintype E] → [DecidableEq E] → (G : OAI.MatchingEntropyBounds.LooplessGraph V E) → (E → ℝ) → Set (G.Matching → ℝ) := fun {V} {E} [Fintype E] [DecidableEq E] G y => {p | p ∈ OAI.MatchingEntropyBounds.probabilitySimplex G.Matching ∧ G.mean p = y} def OAI.MatchingEntropyBounds.entropy.{uι} : {ι : Type uι} → [Fintype ι] → (ι → ℝ) → ℝ := fun {ι} [Fintype ι] p => ∑ i, (p i).negMulLog def OAI.MatchingEntropyBounds.maxMatchingEntropy.{uV, uE} : {V : Type uV} → {E : Type uE} → [Fintype E] → [DecidableEq E] → OAI.MatchingEntropyBounds.LooplessGraph V E → (E → ℝ) → ℝ := fun {V} {E} [Fintype E] [DecidableEq E] G y => sSup (OAI.MatchingEntropyBounds.entropy '' G.feasibleLaws y) def OAI.MatchingEntropyBounds.Refined.complementEntropy.{uE} : {E : Type uE} → [Fintype E] → (E → ℝ) → ℝ := fun {E} [Fintype E] x => OAI.MatchingEntropyBounds.entropy fun e => 1 - x e 