OAI.ContinuumTemperature.main_theorem : OAI.ContinuumTemperature.MainStatement @[reducible] def OAI.ContinuumTemperature.Space : Type := EuclideanSpace ℝ (Fin 3) def OAI.ContinuumTemperature.radialPotential : (ℝ → ℝ) → OAI.ContinuumTemperature.Space → EReal := fun φ x => if x = 0 then ⊤ else ↑(φ ‖x‖) def OAI.ContinuumTemperature.energy : (ℝ → ℝ) → {N : ℕ} → (Fin N → OAI.ContinuumTemperature.Space) → EReal := fun φ {N} x => ∑ i, ∑ j with i < j, OAI.ContinuumTemperature.radialPotential φ (x i - x j) def OAI.ContinuumTemperature.Admissible : (ℝ → ℝ) → Prop := fun φ => Measurable (OAI.ContinuumTemperature.radialPotential φ) ∧ (∀ (a b : ℝ), 0 < a → a ≤ b → BddAbove (φ '' Set.Icc a b) ∧ BddBelow (φ '' Set.Icc a b)) ∧ Filter.Tendsto φ (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop ∧ (∃ r₁ r₂ a, 0 < r₁ ∧ r₁ < r₂ ∧ 0 < a ∧ ∀ r ∈ Set.Icc r₁ r₂, φ r ≤ -a) ∧ (∃ R, 0 < R ∧ MeasureTheory.IntegrableOn (fun r => r ^ 2 * |φ r|) (Set.Ioi R) MeasureTheory.volume) ∧ ∃ B, ∀ (N : ℕ) (x : Fin N → OAI.ContinuumTemperature.Space), ↑(-B * ↑N) ≤ OAI.ContinuumTemperature.energy φ x def OAI.ContinuumTemperature.cube : ℝ → Set OAI.ContinuumTemperature.Space := fun L => {x | ∀ (i : Fin 3), x.ofLp i ∈ Set.Icc (-L / 2) (L / 2)} def OAI.ContinuumTemperature.boltzmann : (ℝ → ℝ) → ℝ → {N : ℕ} → (Fin N → OAI.ContinuumTemperature.Space) → ℝ := fun φ β {N} x => if OAI.ContinuumTemperature.energy φ x = ⊤ then 0 else Real.exp (-β * (OAI.ContinuumTemperature.energy φ x).toReal) def OAI.ContinuumTemperature.partition : (ℝ → ℝ) → ℝ → ℝ → ℕ → ℝ := fun φ β L N => if N = 0 then 1 else 1 / ↑N.factorial * ∫ (x : Fin N → OAI.ContinuumTemperature.Space) in {x | ∀ (i : Fin N), x i ∈ OAI.ContinuumTemperature.cube L}, OAI.ContinuumTemperature.boltzmann φ β x def OAI.ContinuumTemperature.HasCanonicalFreeEnergy : (ℝ → ℝ) → (ℝ → ℝ → ℝ) → Prop := fun φ f => ∀ (β ρ : ℝ), 0 < β → 0 < ρ → Filter.Tendsto (fun L => L⁻¹ ^ 3 * Real.log (OAI.ContinuumTemperature.partition φ β L ⌊ρ * L ^ 3⌋₊)) Filter.atTop (nhds (-β * f β ρ)) def OAI.ContinuumTemperature.MainStatement : Prop := ∃ φ f I βc, OAI.ContinuumTemperature.Admissible φ ∧ (φ =o[Filter.atTop] fun r => r ^ (-3)) ∧ OAI.ContinuumTemperature.HasCanonicalFreeEnergy φ f ∧ IsOpen I ∧ I.OrdConnected ∧ I.Nonempty ∧ I ⊆ Set.Ioi 0 ∧ βc ∈ Set.Ioo (1 / 2) (3 / 2) ∧ ∀ ρ ∈ I, ∃ dminus dplus, HasDerivWithinAt (fun β => f β ρ) dminus (Set.Iic βc) βc ∧ HasDerivWithinAt (fun β => f β ρ) dplus (Set.Ici βc) βc ∧ dplus < dminus 