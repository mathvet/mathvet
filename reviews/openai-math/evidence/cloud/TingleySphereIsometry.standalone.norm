@OAI.Tingley.tingley_sphere_isometry_full : ∀ {X : Type u_1} {Y : Type u_2} [inst : NormedAddCommGroup X] [inst_1 : NormedSpace ℝ X] [CompleteSpace X] [inst_3 : NormedAddCommGroup Y] [inst_4 : NormedSpace ℝ Y] [CompleteSpace Y] [Nontrivial X] [Nontrivial Y] (f : OAI.Tingley.UnitSphere X → OAI.Tingley.UnitSphere Y), Isometry f → Function.Surjective f → ∃ T, (∀ (u : OAI.Tingley.UnitSphere X), T ↑u = ↑(f u)) ∧ T 0 = 0 ∧ (∀ (x : X) (hx : x ≠ 0), T x = ‖x‖ • ↑(f (OAI.Tingley.normalize x hx))) ∧ Function.Surjective ⇑T ∧ ∀ (L : X →ₗ[ℝ] Y), (∀ (u : OAI.Tingley.UnitSphere X), L ↑u = ↑(f u)) → L = ↑T.toLinearEquiv @[reducible] def OAI.Tingley.UnitSphere.{u} : (X : Type u) → [NormedAddCommGroup X] → Type (max 0 u) := fun X [NormedAddCommGroup X] => { x // ‖x‖ = 1 } def OAI.Tingley.normalize.{u} : {X : Type u} → [inst : NormedAddCommGroup X] → [NormedSpace ℝ X] → (x : X) → x ≠ 0 → OAI.Tingley.UnitSphere X := fun {X} [NormedAddCommGroup X] [NormedSpace ℝ X] x hx => ⟨‖x‖⁻¹ • x, ⋯⟩ 