OAI.TorsionFreeZeroDivisors.main : OAI.TorsionFreeZeroDivisors.MainTheorem def OAI.TorsionFreeZeroDivisors.TorsionFree : (G : Type) → [Group G] → Prop := fun G [Group G] => ∀ (g : G) (n : ℕ), 0 < n → g ^ n = 1 → g = 1 def OAI.TorsionFreeZeroDivisors.HasFiniteTwoDimensionalClassifyingSpace : (G : Type) → [Group G] → Prop := fun G [Group G] => ∃ X topX, ∃ (_ : T2Space X) (_ : PathConnectedSpace X), ∃ cw, Topology.RelCWComplex.Finite Set.univ ∧ (∀ (n : ℕ), 2 < n → IsEmpty (Topology.CWComplex.cell Set.univ n)) ∧ Nonempty (Topology.CWComplex.cell Set.univ 2) ∧ ∃ x, Nonempty (G ≃* FundamentalGroup X x) ∧ ∃ E topE, ContractibleSpace E ∧ ∃ p, IsCoveringMap p ∧ Function.Surjective p def OAI.TorsionFreeZeroDivisors.MainTheorem : Prop := ∃ G inst, Group.IsFinitelyPresented G ∧ OAI.TorsionFreeZeroDivisors.TorsionFree G ∧ OAI.TorsionFreeZeroDivisors.HasFiniteTwoDimensionalClassifyingSpace G ∧ ∃ α β, α ≠ 0 ∧ β ≠ 0 ∧ α * β = 0 