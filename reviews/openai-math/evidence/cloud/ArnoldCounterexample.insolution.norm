OAI.ArnoldCounterexample.main : ∃ φ, OAI.ArnoldCounterexample.IsHamiltonian φ ∧ (OAI.ArnoldCounterexample.fixedSet φ).encard = 3 ∧ 3 < 4 ∧ 4 ≤ OAI.ArnoldCounterexample.criticalNumber ∧ OAI.ArnoldCounterexample.HasDegenerateFixedPoint φ @[reducible] def OAI.ArnoldCounterexample.CV : Type := Fin 5 → ℂ def OAI.ArnoldCounterexample.quadricPolynomial : OAI.ArnoldCounterexample.CV → ℂ := fun z => ∑ j, z j ^ 2 def OAI.ArnoldCounterexample.normSquared : OAI.ArnoldCounterexample.CV → ℝ := fun z => ∑ j, Complex.normSq (z j) def OAI.ArnoldCounterexample.IsUnitQuadric : OAI.ArnoldCounterexample.CV → Prop := fun z => OAI.ArnoldCounterexample.normSquared z = 1 ∧ OAI.ArnoldCounterexample.quadricPolynomial z = 0 @[reducible] def OAI.ArnoldCounterexample.UnitQuadric : Type := { z // OAI.ArnoldCounterexample.IsUnitQuadric z } def OAI.ArnoldCounterexample.Q3 : Type := { q // ∃ z, ∃ (hz : z ≠ 0), Projectivization.mk ℂ z hz = q ∧ OAI.ArnoldCounterexample.quadricPolynomial z = 0 } def OAI.ArnoldCounterexample.project : OAI.ArnoldCounterexample.UnitQuadric → OAI.ArnoldCounterexample.Q3 := fun z => have hz := ⋯; ⟨Projectivization.mk ℂ (↑z) hz, ⋯⟩ def OAI.ArnoldCounterexample.Horizontal : OAI.ArnoldCounterexample.CV → OAI.ArnoldCounterexample.CV → Prop := fun z v => ∑ j, star (z j) * v j = 0 ∧ ∑ j, z j * v j = 0 def OAI.ArnoldCounterexample.omega : OAI.ArnoldCounterexample.CV → OAI.ArnoldCounterexample.CV → ℝ := fun v w => 2 * (∑ j, star (v j) * w j).im def OAI.ArnoldCounterexample.LocalFunctionLift : (OAI.ArnoldCounterexample.Q3 → ℝ) → OAI.ArnoldCounterexample.UnitQuadric → Set OAI.ArnoldCounterexample.CV → (OAI.ArnoldCounterexample.CV → ℝ) → Prop := fun h z U g => IsOpen U ∧ ↑z ∈ U ∧ ContDiffOn ℝ (↑⊤) g U ∧ ∀ (y : OAI.ArnoldCounterexample.UnitQuadric), ↑y ∈ U → g ↑y = h (OAI.ArnoldCounterexample.project y) def OAI.ArnoldCounterexample.IsSmoothFunction : (OAI.ArnoldCounterexample.Q3 → ℝ) → Prop := fun h => ∀ (z : OAI.ArnoldCounterexample.UnitQuadric), ∃ U g, OAI.ArnoldCounterexample.LocalFunctionLift h z U g structure OAI.ArnoldCounterexample.SmoothFunction : Type number of parameters: 0 fields: OAI.ArnoldCounterexample.SmoothFunction.toFun : OAI.ArnoldCounterexample.Q3 → ℝ OAI.ArnoldCounterexample.SmoothFunction.smooth : OAI.ArnoldCounterexample.IsSmoothFunction self.toFun constructor: OAI.ArnoldCounterexample.SmoothFunction.mk (toFun : OAI.ArnoldCounterexample.Q3 → ℝ) (smooth : OAI.ArnoldCounterexample.IsSmoothFunction toFun) : OAI.ArnoldCounterexample.SmoothFunction def OAI.ArnoldCounterexample.IsCritical : (OAI.ArnoldCounterexample.Q3 → ℝ) → OAI.ArnoldCounterexample.Q3 → Prop := fun h q => ∀ (z : OAI.ArnoldCounterexample.UnitQuadric), OAI.ArnoldCounterexample.project z = q → ∀ (U : Set OAI.ArnoldCounterexample.CV) (g : OAI.ArnoldCounterexample.CV → ℝ), OAI.ArnoldCounterexample.LocalFunctionLift h z U g → ∀ (v : OAI.ArnoldCounterexample.CV), OAI.ArnoldCounterexample.Horizontal (↑z) v → (fderiv ℝ g ↑z) v = 0 def OAI.ArnoldCounterexample.criticalSet : OAI.ArnoldCounterexample.SmoothFunction → Set OAI.ArnoldCounterexample.Q3 := fun h => {q | OAI.ArnoldCounterexample.IsCritical h.toFun q} def OAI.ArnoldCounterexample.criticalNumber : ℕ∞ := ⨅ h, (OAI.ArnoldCounterexample.criticalSet h).encard structure OAI.ArnoldCounterexample.HamiltonianPath (φ : OAI.ArnoldCounterexample.Q3 ≃ OAI.ArnoldCounterexample.Q3) : Type number of parameters: 1 fields: OAI.ArnoldCounterexample.HamiltonianPath.forward : ℝ × OAI.ArnoldCounterexample.CV → OAI.ArnoldCounterexample.CV OAI.ArnoldCounterexample.HamiltonianPath.backward : ℝ × OAI.ArnoldCounterexample.CV → OAI.ArnoldCounterexample.CV OAI.ArnoldCounterexample.HamiltonianPath.hamiltonian : ℝ × OAI.ArnoldCounterexample.CV → ℝ OAI.ArnoldCounterexample.HamiltonianPath.forward_smooth : ContDiff ℝ (↑⊤) self.forward OAI.ArnoldCounterexample.HamiltonianPath.backward_smooth : ContDiff ℝ (↑⊤) self.backward OAI.ArnoldCounterexample.HamiltonianPath.hamiltonian_smooth : ContDiff ℝ (↑⊤) self.hamiltonian OAI.ArnoldCounterexample.HamiltonianPath.forward_preserves : ∀ t ∈ Set.Icc 0 1, ∀ (z : OAI.ArnoldCounterexample.UnitQuadric), OAI.ArnoldCounterexample.IsUnitQuadric (self.forward (t, ↑z)) OAI.ArnoldCounterexample.HamiltonianPath.backward_preserves : ∀ t ∈ Set.Icc 0 1, ∀ (z : OAI.ArnoldCounterexample.UnitQuadric), OAI.ArnoldCounterexample.IsUnitQuadric (self.backward (t, ↑z)) OAI.ArnoldCounterexample.HamiltonianPath.forward_phase : ∀ t ∈ Set.Icc 0 1, ∀ (z : OAI.ArnoldCounterexample.UnitQuadric) (a : ℂ), Complex.normSq a = 1 → self.forward (t, a • ↑z) = a • self.forward (t, ↑z) OAI.ArnoldCounterexample.HamiltonianPath.backward_phase : ∀ t ∈ Set.Icc 0 1, ∀ (z : OAI.ArnoldCounterexample.UnitQuadric) (a : ℂ), Complex.normSq a = 1 → self.backward (t, a • ↑z) = a • self.backward (t, ↑z) OAI.ArnoldCounterexample.HamiltonianPath.hamiltonian_phase : ∀ t ∈ Set.Icc 0 1, ∀ (z : OAI.ArnoldCounterexample.UnitQuadric) (a : ℂ), Complex.normSq a = 1 → self.hamiltonian (t, a • ↑z) = self.hamiltonian (t, ↑z) OAI.ArnoldCounterexample.HamiltonianPath.left_inverse : ∀ t ∈ Set.Icc 0 1, ∀ (z : OAI.ArnoldCounterexample.UnitQuadric), self.backward (t, self.forward (t, ↑z)) = ↑z OAI.ArnoldCounterexample.HamiltonianPath.right_inverse : ∀ t ∈ Set.Icc 0 1, ∀ (z : OAI.ArnoldCounterexample.UnitQuadric), self.forward (t, self.backward (t, ↑z)) = ↑z OAI.ArnoldCounterexample.HamiltonianPath.start : ∀ (z : OAI.ArnoldCounterexample.UnitQuadric), self.forward (0, ↑z) = ↑z OAI.ArnoldCounterexample.HamiltonianPath.finish : ∀ (z : OAI.ArnoldCounterexample.UnitQuadric), OAI.ArnoldCounterexample.project ⟨self.forward (1, ↑z), ⋯⟩ = φ (OAI.ArnoldCounterexample.project z) OAI.ArnoldCounterexample.HamiltonianPath.equation : ∀ t ∈ Set.Icc 0 1, ∀ (z : OAI.ArnoldCounterexample.UnitQuadric) (v : OAI.ArnoldCounterexample.CV), OAI.ArnoldCounterexample.Horizontal (self.forward (t, ↑z)) v → OAI.ArnoldCounterexample.omega (deriv (fun s => self.forward (s, ↑z)) t) v = (fderiv ℝ (fun w => self.hamiltonian (t, w)) (self.forward (t, ↑z))) v constructor: OAI.ArnoldCounterexample.HamiltonianPath.mk {φ : OAI.ArnoldCounterexample.Q3 ≃ OAI.ArnoldCounterexample.Q3} (forward backward : ℝ × OAI.ArnoldCounterexample.CV → OAI.ArnoldCounterexample.CV) (hamiltonian : ℝ × OAI.ArnoldCounterexample.CV → ℝ) (forward_smooth : ContDiff ℝ (↑⊤) forward) (backward_smooth : ContDiff ℝ (↑⊤) backward) (hamiltonian_smooth : ContDiff ℝ (↑⊤) hamiltonian) (forward_preserves : ∀ t ∈ Set.Icc 0 1, ∀ (z : OAI.ArnoldCounterexample.UnitQuadric), OAI.ArnoldCounterexample.IsUnitQuadric (forward (t, ↑z))) (backward_preserves : ∀ t ∈ Set.Icc 0 1, ∀ (z : OAI.ArnoldCounterexample.UnitQuadric), OAI.ArnoldCounterexample.IsUnitQuadric (backward (t, ↑z))) (forward_phase : ∀ t ∈ Set.Icc 0 1, ∀ (z : OAI.ArnoldCounterexample.UnitQuadric) (a : ℂ), Complex.normSq a = 1 → forward (t, a • ↑z) = a • forward (t, ↑z)) (backward_phase : ∀ t ∈ Set.Icc 0 1, ∀ (z : OAI.ArnoldCounterexample.UnitQuadric) (a : ℂ), Complex.normSq a = 1 → backward (t, a • ↑z) = a • backward (t, ↑z)) (hamiltonian_phase : ∀ t ∈ Set.Icc 0 1, ∀ (z : OAI.ArnoldCounterexample.UnitQuadric) (a : ℂ), Complex.normSq a = 1 → hamiltonian (t, a • ↑z) = hamiltonian (t, ↑z)) (left_inverse : ∀ t ∈ Set.Icc 0 1, ∀ (z : OAI.ArnoldCounterexample.UnitQuadric), backward (t, forward (t, ↑z)) = ↑z) (right_inverse : ∀ t ∈ Set.Icc 0 1, ∀ (z : OAI.ArnoldCounterexample.UnitQuadric), forward (t, backward (t, ↑z)) = ↑z) (start : ∀ (z : OAI.ArnoldCounterexample.UnitQuadric), forward (0, ↑z) = ↑z) (finish : ∀ (z : OAI.ArnoldCounterexample.UnitQuadric), OAI.ArnoldCounterexample.project ⟨forward (1, ↑z), ⋯⟩ = φ (OAI.ArnoldCounterexample.project z)) (equation : ∀ t ∈ Set.Icc 0 1, ∀ (z : OAI.ArnoldCounterexample.UnitQuadric) (v : OAI.ArnoldCounterexample.CV), OAI.ArnoldCounterexample.Horizontal (forward (t, ↑z)) v → OAI.ArnoldCounterexample.omega (deriv (fun s => forward (s, ↑z)) t) v = (fderiv ℝ (fun w => hamiltonian (t, w)) (forward (t, ↑z))) v) : OAI.ArnoldCounterexample.HamiltonianPath φ def OAI.ArnoldCounterexample.IsHamiltonian : OAI.ArnoldCounterexample.Q3 ≃ OAI.ArnoldCounterexample.Q3 → Prop := fun φ => Nonempty (OAI.ArnoldCounterexample.HamiltonianPath φ) def OAI.ArnoldCounterexample.fixedSet : OAI.ArnoldCounterexample.Q3 ≃ OAI.ArnoldCounterexample.Q3 → Set OAI.ArnoldCounterexample.Q3 := fun φ => {q | φ q = q} def OAI.ArnoldCounterexample.HasDegenerateFixedPoint : OAI.ArnoldCounterexample.Q3 ≃ OAI.ArnoldCounterexample.Q3 → Prop := fun φ => ∃ z v, φ (OAI.ArnoldCounterexample.project z) = OAI.ArnoldCounterexample.project z ∧ v ≠ 0 ∧ OAI.ArnoldCounterexample.Horizontal (↑z) v ∧ ∃ U G, IsOpen U ∧ ↑z ∈ U ∧ ContDiffOn ℝ (↑⊤) G U ∧ G ↑z = ↑z ∧ (∀ (y : OAI.ArnoldCounterexample.UnitQuadric), ↑y ∈ U → ∃ (hy : OAI.ArnoldCounterexample.IsUnitQuadric (G ↑y)), OAI.ArnoldCounterexample.project ⟨G ↑y, hy⟩ = φ (OAI.ArnoldCounterexample.project y)) ∧ ∃ a, (fderiv ℝ G ↑z) v - v = a • Complex.I • ↑z 