OAI.Release075.main : ∃ G x, OAI.Release075.TorsionFree G ∧ OAI.Release075.WordHyperbolic G ∧ ¬Group.ResiduallyFinite G def OAI.Release075.TorsionFree.{u} : (G : Type u) → [Group G] → Prop := fun G [Group G] => ∀ (g : G) (n : ℕ), 0 < n → g ^ n = 1 → g = 1 def OAI.Release075.Geodesic.{u} : {V : Type u} → (X : SimpleGraph V) → {x y : V} → X.Walk x y → Prop := fun {V} X {x y} p => p.length = X.dist x y def OAI.Release075.SideThin.{u} : {V : Type u} → (X : SimpleGraph V) → ℕ → {x y z : V} → X.Walk x y → X.Walk y z → X.Walk z x → Prop := fun {V} X δ {x y z} p q r => ∀ a ∈ p.support, ∃ b, (b ∈ q.support ∨ b ∈ r.support) ∧ X.dist a b ≤ δ def OAI.Release075.WordHyperbolic.{u} : (G : Type u) → [Group G] → Prop := fun G [Group G] => ∃ S, S.Finite ∧ (SimpleGraph.mulCayley S).Connected ∧ ∃ δ, ∀ (x y z : G) (p : (SimpleGraph.mulCayley S).Walk x y) (q : (SimpleGraph.mulCayley S).Walk y z) (r : (SimpleGraph.mulCayley S).Walk z x), OAI.Release075.Geodesic (SimpleGraph.mulCayley S) p → OAI.Release075.Geodesic (SimpleGraph.mulCayley S) q → OAI.Release075.Geodesic (SimpleGraph.mulCayley S) r → OAI.Release075.SideThin (SimpleGraph.mulCayley S) δ p q r ∧ OAI.Release075.SideThin (SimpleGraph.mulCayley S) δ q r p ∧ OAI.Release075.SideThin (SimpleGraph.mulCayley S) δ r p q 