OAI.LeanBlast.GotsmanLinial.gotsmanLinialStatement : OAI.LeanBlast.GotsmanLinial.GotsmanLinialStatement @[reducible] def OAI.LeanBlast.GotsmanLinial.Cube : ℕ → Type := fun n => Fin n → Bool def OAI.LeanBlast.GotsmanLinial.cubeCoord : {n : ℕ} → OAI.LeanBlast.GotsmanLinial.Cube n → Fin n → ℝ := fun {n} x i => if x i = true then 1 else -1 def OAI.LeanBlast.GotsmanLinial.flip : {n : ℕ} → Fin n → OAI.LeanBlast.GotsmanLinial.Cube n → OAI.LeanBlast.GotsmanLinial.Cube n := fun {n} i x => Function.update x i !x i def OAI.LeanBlast.GotsmanLinial.thresholdSign : ℝ → ℝ := fun t => if 0 ≤ t then 1 else -1 def OAI.LeanBlast.GotsmanLinial.sensitiveVertices : {n : ℕ} → (OAI.LeanBlast.GotsmanLinial.Cube n → ℝ) → Fin n → Finset (OAI.LeanBlast.GotsmanLinial.Cube n) := fun {n} f i => {x | f x ≠ f (OAI.LeanBlast.GotsmanLinial.flip i x)} def OAI.LeanBlast.GotsmanLinial.averageSensitivity : {n : ℕ} → (OAI.LeanBlast.GotsmanLinial.Cube n → ℝ) → ℝ := fun {n} f => ∑ i, ↑(OAI.LeanBlast.GotsmanLinial.sensitiveVertices f i).card / 2 ^ n def OAI.LeanBlast.GotsmanLinial.IsMultilinear : {n : ℕ} → MvPolynomial (Fin n) ℝ → Prop := fun {n} p => ∀ m ∈ p.support, ∀ (i : Fin n), m i ≤ 1 def OAI.LeanBlast.GotsmanLinial.polynomialValue : {n : ℕ} → MvPolynomial (Fin n) ℝ → OAI.LeanBlast.GotsmanLinial.Cube n → ℝ := fun {n} p x => (MvPolynomial.eval (OAI.LeanBlast.GotsmanLinial.cubeCoord x)) p def OAI.LeanBlast.GotsmanLinial.polynomialThreshold : {n : ℕ} → MvPolynomial (Fin n) ℝ → OAI.LeanBlast.GotsmanLinial.Cube n → ℝ := fun {n} p x => OAI.LeanBlast.GotsmanLinial.thresholdSign (OAI.LeanBlast.GotsmanLinial.polynomialValue p x) def OAI.LeanBlast.GotsmanLinial.GotsmanLinialStatement : Prop := ∀ (n d : ℕ), 1 ≤ n → 1 ≤ d → d ≤ n → ∀ (p : MvPolynomial (Fin n) ℝ), OAI.LeanBlast.GotsmanLinial.IsMultilinear p → p.totalDegree ≤ d → OAI.LeanBlast.GotsmanLinial.averageSensitivity (OAI.LeanBlast.GotsmanLinial.polynomialThreshold p) ≤ 8 * ↑d * √↑n 