OAI.LeanBlast.SecondKahnKalai.secondKahnKalaiBounds : ∀ (n : ℕ) (V : Type u_1) [inst : Fintype V] (H : SimpleGraph V), 2 ≤ n → Fintype.card V ≤ n → 1 ≤ OAI.LeanBlast.SecondKahnKalai.edgeCount H → OAI.LeanBlast.SecondKahnKalai.SecondKahnKalaiBounds n H def OAI.LeanBlast.SecondKahnKalai.bernoulliWeight.{u} : {X : Type u} → [Fintype X] → [DecidableEq X] → ℝ → Finset X → ℝ := fun {X} [Fintype X] [DecidableEq X] p W => ∏ x, if x ∈ W then p else 1 - p def OAI.LeanBlast.SecondKahnKalai.bernoulliExpectation.{u} : {X : Type u} → [Fintype X] → [DecidableEq X] → ℝ → (Finset X → ℝ) → ℝ := fun {X} [Fintype X] [DecidableEq X] p f => ∑ W, OAI.LeanBlast.SecondKahnKalai.bernoulliWeight p W * f W def OAI.LeanBlast.SecondKahnKalai.bernoulliProbability.{u} : {X : Type u} → [Fintype X] → [DecidableEq X] → ℝ → (Finset X → Prop) → ℝ := fun {X} [Fintype X] [DecidableEq X] p P => ∑ W, if P W then OAI.LeanBlast.SecondKahnKalai.bernoulliWeight p W else 0 @[reducible] def OAI.LeanBlast.SecondKahnKalai.Edge : ℕ → Type := fun n => { e // ¬e.IsDiag } def OAI.LeanBlast.SecondKahnKalai.graphOfEdges : {n : ℕ} → Finset (OAI.LeanBlast.SecondKahnKalai.Edge n) → SimpleGraph (Fin n) := fun {n} W => SimpleGraph.fromEdgeSet (Subtype.val '' ↑W) def OAI.LeanBlast.SecondKahnKalai.edgeCount.{u} : {V : Type u} → SimpleGraph V → ℕ := fun {V} H => Nat.card ↑H.edgeSet def OAI.LeanBlast.SecondKahnKalai.expectedCopies.{u} : {V : Type u} → ℕ → ℝ → SimpleGraph V → ℝ := fun {V} n p H => OAI.LeanBlast.SecondKahnKalai.bernoulliExpectation p fun W => ↑((OAI.LeanBlast.SecondKahnKalai.graphOfEdges W).copyCount H) def OAI.LeanBlast.SecondKahnKalai.containmentProbability.{u} : {V : Type u} → ℕ → ℝ → SimpleGraph V → ℝ := fun {V} n p H => OAI.LeanBlast.SecondKahnKalai.bernoulliProbability p fun W => 0 < (OAI.LeanBlast.SecondKahnKalai.graphOfEdges W).copyCount H def OAI.LeanBlast.SecondKahnKalai.criticalThreshold.{u} : {V : Type u} → ℕ → SimpleGraph V → ℝ := fun {V} n H => sInf {p | p ∈ Set.Icc 0 1 ∧ 1 / 2 ≤ OAI.LeanBlast.SecondKahnKalai.containmentProbability n p H} def OAI.LeanBlast.SecondKahnKalai.expectationThreshold.{u} : {V : Type u} → ℕ → SimpleGraph V → ℝ := fun {V} n H => sInf {p | p ∈ Set.Icc 0 1 ∧ ∀ (F : H.Subgraph), 1 / 2 ≤ OAI.LeanBlast.SecondKahnKalai.expectedCopies n p F.coe} def OAI.LeanBlast.SecondKahnKalai.logTwo : ℝ → ℝ := fun x => Real.log x / Real.log 2 def OAI.LeanBlast.SecondKahnKalai.SecondKahnKalaiBounds.{u} : {V : Type u} → ℕ → SimpleGraph V → Prop := fun {V} n H => OAI.LeanBlast.SecondKahnKalai.criticalThreshold n H ≤ min 1 (2048 * Real.exp 50 * OAI.LeanBlast.SecondKahnKalai.expectationThreshold n H * (1 + OAI.LeanBlast.SecondKahnKalai.logTwo ↑(OAI.LeanBlast.SecondKahnKalai.edgeCount H))) ∧ OAI.LeanBlast.SecondKahnKalai.criticalThreshold n H ≤ 6144 * Real.exp 50 * OAI.LeanBlast.SecondKahnKalai.expectationThreshold n H * OAI.LeanBlast.SecondKahnKalai.logTwo ↑n 