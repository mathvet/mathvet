OAI.PinchedHartogs.main_theorem : OAI.PinchedHartogs.MainTheorem OAI.PinchedHartogs.controlled_potential : OAI.PinchedHartogs.ControlledPotential OAI.PinchedHartogs.metric_transfer : OAI.PinchedHartogs.MetricTransfer @[reducible] def OAI.PinchedHartogs.Base : Type := EuclideanSpace ℂ (Fin 2) @[reducible] def OAI.PinchedHartogs.Ambient : Type := OAI.PinchedHartogs.Base × ℂ @[reducible] def OAI.PinchedHartogs.Target : Type := Fin 3 → ℂ def OAI.PinchedHartogs.ball : Set OAI.PinchedHartogs.Base := {z | ‖z‖ < 1} def OAI.PinchedHartogs.hartogs : (OAI.PinchedHartogs.Base → ℝ) → Set OAI.PinchedHartogs.Ambient := fun φ => {p | p.1 ∈ OAI.PinchedHartogs.ball ∧ Real.exp (φ p.1) * ‖p.2‖ ^ 2 < 1} def OAI.PinchedHartogs.noMinorant : (OAI.PinchedHartogs.Base → ℝ) → Prop := fun φ => ¬∃ H C, AnalyticOnNhd ℂ H OAI.PinchedHartogs.ball ∧ ∀ z ∈ OAI.PinchedHartogs.ball, (H z).re ≤ C + 4 * Real.log (1 / (1 - ‖z‖)) + φ z def OAI.PinchedHartogs.coordVector : Fin 3 → OAI.PinchedHartogs.Ambient := fun j => ![(EuclideanSpace.single 0 1, 0), (EuclideanSpace.single 1 1, 0), (0, 1)] j def OAI.PinchedHartogs.jacobian : (OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.Target) → OAI.PinchedHartogs.Ambient → Matrix (Fin 3) (Fin 3) ℂ := fun F p i j => (fderiv ℂ F p) (OAI.PinchedHartogs.coordVector j) i @[reducible] def OAI.PinchedHartogs.CMatrix : Type := Matrix (Fin 3) (Fin 3) ℂ @[reducible] def OAI.PinchedHartogs.CurvatureTensor : Type := Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℂ def OAI.PinchedHartogs.coordinates : OAI.PinchedHartogs.Ambient → Fin 3 → ℂ := fun u => ![u.1.ofLp 0, u.1.ofLp 1, u.2] def OAI.PinchedHartogs.dz : (OAI.PinchedHartogs.Ambient → ℂ) → OAI.PinchedHartogs.Ambient → Fin 3 → ℂ := fun f p j => ((fderiv ℝ f p) (OAI.PinchedHartogs.coordVector j) - Complex.I * (fderiv ℝ f p) (Complex.I • OAI.PinchedHartogs.coordVector j)) / 2 def OAI.PinchedHartogs.dbar : (OAI.PinchedHartogs.Ambient → ℂ) → OAI.PinchedHartogs.Ambient → Fin 3 → ℂ := fun f p j => ((fderiv ℝ f p) (OAI.PinchedHartogs.coordVector j) + Complex.I * (fderiv ℝ f p) (Complex.I • OAI.PinchedHartogs.coordVector j)) / 2 def OAI.PinchedHartogs.hermitianValue : OAI.PinchedHartogs.CMatrix → OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.Ambient → ℂ := fun h u v => ∑ i, ∑ j, h i j * OAI.PinchedHartogs.coordinates u i * star (OAI.PinchedHartogs.coordinates v j) def OAI.PinchedHartogs.realArea : OAI.PinchedHartogs.CMatrix → OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.Ambient → ℝ := fun h u v => (OAI.PinchedHartogs.hermitianValue h u u).re * (OAI.PinchedHartogs.hermitianValue h v v).re - (OAI.PinchedHartogs.hermitianValue h u v).re ^ 2 def OAI.PinchedHartogs.tensorValue : OAI.PinchedHartogs.CurvatureTensor → OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.Ambient → ℂ := fun R u v w y => ∑ a, ∑ b, ∑ c, ∑ d, R a b c d * OAI.PinchedHartogs.coordinates u a * star (OAI.PinchedHartogs.coordinates v b) * OAI.PinchedHartogs.coordinates w c * star (OAI.PinchedHartogs.coordinates y d) def OAI.PinchedHartogs.curvature : (OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.CMatrix) → OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.CurvatureTensor := fun g p a b c d => -OAI.PinchedHartogs.dbar (fun q => OAI.PinchedHartogs.dz (fun r => g r c d) q a) p b + ∑ e, ∑ k, (g p)⁻¹ e k * OAI.PinchedHartogs.dz (fun q => g q c e) p a * OAI.PinchedHartogs.dbar (fun q => g q k d) p b def OAI.PinchedHartogs.sectional : (OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.CMatrix) → OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.Ambient → ℝ := fun g p u v => ((OAI.PinchedHartogs.tensorValue (OAI.PinchedHartogs.curvature g p) u u v v).re - (OAI.PinchedHartogs.tensorValue (OAI.PinchedHartogs.curvature g p) u v u v).re) / (2 * OAI.PinchedHartogs.realArea (g p) u v) def OAI.PinchedHartogs.IsKahlerMetric : Set OAI.PinchedHartogs.Ambient → (OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.CMatrix) → Prop := fun M g => ContDiffOn ℝ (↑⊤) g M ∧ (∀ p ∈ M, ∀ (i j : Fin 3), g p i j = star (g p j i)) ∧ (∀ p ∈ M, ∀ (u : OAI.PinchedHartogs.Ambient), u ≠ 0 → 0 < (OAI.PinchedHartogs.hermitianValue (g p) u u).re) ∧ ∀ p ∈ M, ∀ (i j k : Fin 3), OAI.PinchedHartogs.dz (fun q => g q k j) p i = OAI.PinchedHartogs.dz (fun q => g q i j) p k def OAI.PinchedHartogs.christoffel : (OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.CMatrix) → OAI.PinchedHartogs.Ambient → Fin 3 → Fin 3 → Fin 3 → ℂ := fun g p k a c => ∑ e, (g p)⁻¹ e k * OAI.PinchedHartogs.dz (fun q => g q c e) p a def OAI.PinchedHartogs.GeodesicallyComplete : Set OAI.PinchedHartogs.Ambient → (OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.CMatrix) → Prop := fun M g => ∀ p ∈ M, ∀ (v : OAI.PinchedHartogs.Ambient), ∃ γ, ContDiff ℝ (↑⊤) γ ∧ (∀ (t : ℝ), γ t ∈ M) ∧ γ 0 = p ∧ deriv γ 0 = v ∧ ∀ (t : ℝ) (k : Fin 3), OAI.PinchedHartogs.coordinates (deriv (deriv γ) t) k + ∑ a, ∑ c, OAI.PinchedHartogs.christoffel g (γ t) k a c * OAI.PinchedHartogs.coordinates (deriv γ t) a * OAI.PinchedHartogs.coordinates (deriv γ t) c = 0 def OAI.PinchedHartogs.IsNegativelyPinched : Set OAI.PinchedHartogs.Ambient → (OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.CMatrix) → ℝ → ℝ → Prop := fun M g A B => 0 < A ∧ A ≤ B ∧ ∀ p ∈ M, ∀ (u v : OAI.PinchedHartogs.Ambient), LinearIndependent ℝ ![u, v] → -B ≤ OAI.PinchedHartogs.sectional g p u v ∧ OAI.PinchedHartogs.sectional g p u v ≤ -A def OAI.PinchedHartogs.NoBoundedCoordinates : Set OAI.PinchedHartogs.Ambient → Prop := fun M => ∀ (F : OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.Target), AnalyticOnNhd ℂ F M → (∃ B, ∀ p ∈ M, ∀ (i : Fin 3), ‖F p i‖ ≤ B) → ¬∀ p ∈ M, (OAI.PinchedHartogs.jacobian F p).det ≠ 0 def OAI.PinchedHartogs.BiholomorphicToBoundedDomain : Set OAI.PinchedHartogs.Ambient → Prop := fun M => ∃ N, IsOpen N ∧ Bornology.IsBounded N ∧ ∃ F G, AnalyticOnNhd ℂ F M ∧ AnalyticOnNhd ℂ G N ∧ Set.MapsTo F M N ∧ Set.MapsTo G N M ∧ (∀ p ∈ M, G (F p) = p) ∧ ∀ q ∈ N, F (G q) = q def OAI.PinchedHartogs.MainTheorem : Prop := ∃ M g A B, IsOpen M ∧ M.Nonempty ∧ ContractibleSpace ↑M ∧ OAI.PinchedHartogs.IsKahlerMetric M g ∧ OAI.PinchedHartogs.GeodesicallyComplete M g ∧ OAI.PinchedHartogs.IsNegativelyPinched M g A B ∧ OAI.PinchedHartogs.NoBoundedCoordinates M ∧ ¬OAI.PinchedHartogs.BiholomorphicToBoundedDomain M def OAI.PinchedHartogs.psi : OAI.PinchedHartogs.Base → ℝ := fun z => -Real.log (1 - ‖z‖ ^ 2) def OAI.PinchedHartogs.metricPotential : (OAI.PinchedHartogs.Base → ℝ) → ℝ → OAI.PinchedHartogs.Ambient → ℝ := fun φ lam p => lam * OAI.PinchedHartogs.psi p.1 - Real.log (1 - Real.exp (φ p.1) * ‖p.2‖ ^ 2) def OAI.PinchedHartogs.complexHessian : (OAI.PinchedHartogs.Ambient → ℝ) → OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.CMatrix := fun f p i j => OAI.PinchedHartogs.dz (fun q => OAI.PinchedHartogs.dbar (fun r => ↑(f r)) q j) p i def OAI.PinchedHartogs.hartogsMetric : (OAI.PinchedHartogs.Base → ℝ) → ℝ → OAI.PinchedHartogs.Ambient → OAI.PinchedHartogs.CMatrix := fun φ lam => OAI.PinchedHartogs.complexHessian (OAI.PinchedHartogs.metricPotential φ lam) def OAI.PinchedHartogs.dzBase : (OAI.PinchedHartogs.Base → ℂ) → OAI.PinchedHartogs.Base → Fin 2 → ℂ := fun f z i => ((fderiv ℝ f z) (EuclideanSpace.single i 1) - Complex.I * (fderiv ℝ f z) (Complex.I • EuclideanSpace.single i 1)) / 2 def OAI.PinchedHartogs.dbarBase : (OAI.PinchedHartogs.Base → ℂ) → OAI.PinchedHartogs.Base → Fin 2 → ℂ := fun f z i => ((fderiv ℝ f z) (EuclideanSpace.single i 1) + Complex.I * (fderiv ℝ f z) (Complex.I • EuclideanSpace.single i 1)) / 2 def OAI.PinchedHartogs.baseHessian : (OAI.PinchedHartogs.Base → ℝ) → OAI.PinchedHartogs.Base → Matrix (Fin 2) (Fin 2) ℂ := fun φ z i j => OAI.PinchedHartogs.dzBase (fun q => OAI.PinchedHartogs.dbarBase (fun r => ↑(φ r)) q j) z i def OAI.PinchedHartogs.centeredChart : ℝ → (OAI.PinchedHartogs.Base ≃ₗᵢ[ℂ] OAI.PinchedHartogs.Base) → OAI.PinchedHartogs.Base → OAI.PinchedHartogs.Base := fun r U ζ => U !₂[(↑r + ζ.ofLp 0) / (1 + ↑r * ζ.ofLp 0), ↑√(1 - r ^ 2) * ζ.ofLp 1 / (1 + ↑r * ζ.ofLp 0)] def OAI.PinchedHartogs.ChartControl : (OAI.PinchedHartogs.Base → ℝ) → ℝ → ℝ → Prop := fun φ c C => ∀ (r : ℝ), 0 ≤ r → r < 1 → ∀ (U : OAI.PinchedHartogs.Base ≃ₗᵢ[ℂ] OAI.PinchedHartogs.Base) (v : OAI.PinchedHartogs.Base), c * ‖v‖ ^ 2 ≤ (∑ i, ∑ j, OAI.PinchedHartogs.baseHessian (φ ∘ OAI.PinchedHartogs.centeredChart r U) 0 i j * v.ofLp i * star (v.ofLp j)).re ∧ (∑ i, ∑ j, OAI.PinchedHartogs.baseHessian (φ ∘ OAI.PinchedHartogs.centeredChart r U) 0 i j * v.ofLp i * star (v.ofLp j)).re ≤ C * ‖v‖ ^ 2 def OAI.PinchedHartogs.ChartJets : (OAI.PinchedHartogs.Base → ℝ) → ℝ → Prop := fun φ C => ∀ (r : ℝ), 0 ≤ r → r < 1 → ∀ (U : OAI.PinchedHartogs.Base ≃ₗᵢ[ℂ] OAI.PinchedHartogs.Base) (i j k l : Fin 2), ‖OAI.PinchedHartogs.dzBase (fun z => OAI.PinchedHartogs.baseHessian (φ ∘ OAI.PinchedHartogs.centeredChart r U) z i j) 0 k‖ + ‖OAI.PinchedHartogs.dbarBase (fun z => OAI.PinchedHartogs.baseHessian (φ ∘ OAI.PinchedHartogs.centeredChart r U) z i j) 0 l‖ + ‖OAI.PinchedHartogs.dzBase (fun z => OAI.PinchedHartogs.dbarBase (fun q => OAI.PinchedHartogs.baseHessian (φ ∘ OAI.PinchedHartogs.centeredChart r U) q i j) z l) 0 k‖ ≤ C def OAI.PinchedHartogs.ControlledPotential : Prop := ∃ φ C, ContDiffOn ℝ (↑⊤) φ OAI.PinchedHartogs.ball ∧ OAI.PinchedHartogs.ChartControl φ 1 C ∧ OAI.PinchedHartogs.ChartJets φ C ∧ OAI.PinchedHartogs.noMinorant φ def OAI.PinchedHartogs.MetricTransfer : Prop := ∀ (c C : ℝ), 0 < c → c ≤ C → ∃ lam0, 0 < lam0 ∧ ∀ (φ : OAI.PinchedHartogs.Base → ℝ), ContDiffOn ℝ (↑⊤) φ OAI.PinchedHartogs.ball → OAI.PinchedHartogs.ChartControl φ c C → OAI.PinchedHartogs.ChartJets φ C → ∀ (lam : ℝ), lam0 ≤ lam → ContractibleSpace ↑(OAI.PinchedHartogs.hartogs φ) ∧ OAI.PinchedHartogs.IsKahlerMetric (OAI.PinchedHartogs.hartogs φ) (OAI.PinchedHartogs.hartogsMetric φ lam) ∧ OAI.PinchedHartogs.GeodesicallyComplete (OAI.PinchedHartogs.hartogs φ) (OAI.PinchedHartogs.hartogsMetric φ lam) ∧ ∃ A B, OAI.PinchedHartogs.IsNegativelyPinched (OAI.PinchedHartogs.hartogs φ) (OAI.PinchedHartogs.hartogsMetric φ lam) A B 