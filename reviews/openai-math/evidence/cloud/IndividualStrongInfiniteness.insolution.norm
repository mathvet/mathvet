@OAI.MainGap.Manuscript.individual_to_strong_main : ∀ {A : Type u_1} [inst : NonUnitalCStarAlgebra A], OAI.MainGap.Manuscript.PropertyP A → (∀ (a b : A), 0 ≤ a → 0 ≤ b → ∀ (c : A) (ε : ℝ), 0 < ε → ∃ s t, ‖star s * a * s - a‖ < ε ∧ ‖star t * b * t - b‖ < ε ∧ ‖star s * c * t‖ < ε) ∧ OAI.MainGap.StronglyPurelyInfinite A def OAI.MainGap.scalarCorner.{u_1} : {A : Type u_1} → A → CStarMatrix (Fin 1) (Fin 1) A := fun {A} h => CStarMatrix.ofMatrix fun x x_1 => h def OAI.MainGap.doubleCorner.{u_1} : {A : Type u_1} → [NonUnitalCStarAlgebra A] → A → CStarMatrix (Fin 2) (Fin 2) A := fun {A} [NonUnitalCStarAlgebra A] h => CStarMatrix.ofMatrix (Matrix.diagonal fun x => h) def OAI.MainGap.Diagonalization.{u_1} : {A : Type u_1} → [NonUnitalCStarAlgebra A] → A → A → A → ℝ → Prop := fun {A} [NonUnitalCStarAlgebra A] a b c ε => ∃ s t, ‖star s * a * s - a‖ < ε ∧ ‖star t * b * t - b‖ < ε ∧ ‖star s * c * t‖ < ε def OAI.MainGap.UnrestrictedDiagonalization.{u_2} : (A : Type u_2) → [NonUnitalCStarAlgebra A] → Prop := fun A [NonUnitalCStarAlgebra A] => ∀ (a b : A), 0 ≤ a → 0 ≤ b → ∀ (c : A) (ε : ℝ), 0 < ε → OAI.MainGap.Diagonalization a b c ε def OAI.MainGap.StronglyPurelyInfinite.{u_2} : (A : Type u_2) → [NonUnitalCStarAlgebra A] → Prop := fun A [NonUnitalCStarAlgebra A] => ∀ (x y : A), 0 ≤ x → 0 ≤ y → ∀ (ε : ℝ), 0 < ε → OAI.MainGap.Diagonalization (x * x) (y * y) (x * y) ε @[reducible] def OAI.MainGap.Stable.Mat.{u_2} : Type u_2 → ℕ → Type u_2 := fun A n => CStarMatrix (Fin n) (Fin n) A def OAI.MainGap.Stable.pad.{u_1} : {A : Type u_1} → [NonUnitalCStarAlgebra A] → {n m : ℕ} → n ≤ m → OAI.MainGap.Stable.Mat A n → OAI.MainGap.Stable.Mat A m := fun {A} [NonUnitalCStarAlgebra A] {n m} x x_1 => CStarMatrix.ofMatrix fun i j => if hi : ↑i < n then if hj : ↑j < n then x_1 ⟨↑i, hi⟩ ⟨↑j, hj⟩ else 0 else 0 def OAI.MainGap.Stable.padHom.{u_1} : {A : Type u_1} → [inst : NonUnitalCStarAlgebra A] → {n m : ℕ} → n ≤ m → OAI.MainGap.Stable.Mat A n →⋆ₙₐ[ℂ] OAI.MainGap.Stable.Mat A m := fun {A} [NonUnitalCStarAlgebra A] {n m} h => { toFun := OAI.MainGap.Stable.pad h, map_smul' := ⋯, map_zero' := ⋯, map_add' := ⋯, map_mul' := ⋯, map_star' := ⋯ } @[reducible] def OAI.MainGap.Stable.Algebraic.{u_2} : (A : Type u_2) → [NonUnitalCStarAlgebra A] → Type u_2 := fun A [NonUnitalCStarAlgebra A] => DirectLimit (OAI.MainGap.Stable.Mat A) fun x x_1 h => OAI.MainGap.Stable.padHom h def OAI.MainGap.Stable.cornerAlg.{u_1} : {A : Type u_1} → [inst : NonUnitalCStarAlgebra A] → (n : ℕ) → OAI.MainGap.Stable.Mat A n →⋆ₙₐ[ℂ] OAI.MainGap.Stable.Algebraic A := fun {A} [NonUnitalCStarAlgebra A] n => let __spread.0 := DirectLimit.NonUnitalAlgebra.of (OAI.MainGap.Stable.Mat A) (fun x x_1 h => OAI.MainGap.Stable.padHom h) n; { toNonUnitalAlgHom := __spread.0, map_star' := ⋯ } @[reducible] def OAI.MainGap.Stable.Stabilization.{u_2} : (A : Type u_2) → [NonUnitalCStarAlgebra A] → Type u_2 := fun A [NonUnitalCStarAlgebra A] => UniformSpace.Completion (OAI.MainGap.Stable.Algebraic A) @[instance_reducible] def OAI.MainGap.Stable.stabilizationCStarAlgebra.{u_1} : {A : Type u_1} → [inst : NonUnitalCStarAlgebra A] → NonUnitalCStarAlgebra (OAI.MainGap.Stable.Stabilization A) := fun {A} [NonUnitalCStarAlgebra A] => { toNonUnitalNormedRing := OAI.MainGap.Stable.instNonUnitalNormedRingStabilization, toStarRing := OAI.MainGap.Stable.instStarRingStabilization, toCompleteSpace := ⋯, toCStarRing := ⋯, toNormedSpace := UniformSpace.Completion.instNormedSpace ℂ (OAI.MainGap.Stable.Algebraic A), toIsScalarTower := ⋯, toSMulCommClass := ⋯, toStarModule := ⋯ } def OAI.MainGap.Stable.corner.{u_1} : {A : Type u_1} → [inst : NonUnitalCStarAlgebra A] → (n : ℕ) → OAI.MainGap.Stable.Mat A n →⋆ₙₐ[ℂ] OAI.MainGap.Stable.Stabilization A := fun {A} [NonUnitalCStarAlgebra A] n => { toFun := fun x => ↑((OAI.MainGap.Stable.cornerAlg n) x), map_smul' := ⋯, map_zero' := ⋯, map_add' := ⋯, map_mul' := ⋯, map_star' := ⋯ } def OAI.MainGap.Manuscript.CuntzLE.{u_1} : {A : Type u_1} → [inst : NonUnitalCStarAlgebra A] → OAI.MainGap.Stable.Stabilization A → OAI.MainGap.Stable.Stabilization A → Prop := fun {A} [NonUnitalCStarAlgebra A] d v => ∃ r, Filter.Tendsto (fun j => star (r j) * v * r j) Filter.atTop (nhds d) def OAI.MainGap.Manuscript.ProperlyInfinite.{u_1} : {A : Type u_1} → [NonUnitalCStarAlgebra A] → A → Prop := fun {A} [NonUnitalCStarAlgebra A] h => OAI.MainGap.Manuscript.CuntzLE ↑(⟦⟨2, OAI.MainGap.doubleCorner h⟩⟧) ↑(⟦⟨1, OAI.MainGap.scalarCorner h⟩⟧) def OAI.MainGap.Manuscript.PropertyP.{u_2} : (A : Type u_2) → [NonUnitalCStarAlgebra A] → Prop := fun A [NonUnitalCStarAlgebra A] => ∀ (h : A), 0 ≤ h → OAI.MainGap.Manuscript.ProperlyInfinite h 