OAI.TriangularCovering.main : OAI.TriangularCovering.A_min = OAI.TriangularCovering.H ∧ OAI.TriangularCovering.MainAsymptotic ∧ OAI.TriangularCovering.NormalizedCounterexample @[reducible] def OAI.TriangularCovering.Space : Type := EuclideanSpace ℝ (Fin 3) def OAI.TriangularCovering.H : ℝ := √2 def OAI.TriangularCovering.point : ℝ → ℝ → ℝ → OAI.TriangularCovering.Space := fun x y t => !₂[x, y, OAI.TriangularCovering.H * t] def OAI.TriangularCovering.K : Set OAI.TriangularCovering.Space := {z | ∃ x y t, 0 ≤ t ∧ t ≤ 1 ∧ |x| ≤ 1 - t ∧ |y| ≤ t ∧ z = OAI.TriangularCovering.point x y t} def OAI.TriangularCovering.projection : OAI.TriangularCovering.Space → OAI.TriangularCovering.Space → OAI.TriangularCovering.Space := fun u z => z - inner ℝ u z • u def OAI.TriangularCovering.area : Set OAI.TriangularCovering.Space → ℝ := fun B => ((MeasureTheory.Measure.euclideanHausdorffMeasure 2) B).toReal def OAI.TriangularCovering.shadowArea : OAI.TriangularCovering.Space → ℝ := fun u => OAI.TriangularCovering.area (OAI.TriangularCovering.projection u '' OAI.TriangularCovering.K) def OAI.TriangularCovering.A_min : ℝ := sInf {a | ∃ u, ‖u‖ = 1 ∧ a = OAI.TriangularCovering.shadowArea u} structure OAI.TriangularCovering.TriCylinder : Type number of parameters: 0 fields: OAI.TriangularCovering.TriCylinder.axis : OAI.TriangularCovering.Space OAI.TriangularCovering.TriCylinder.base : Set OAI.TriangularCovering.Space OAI.TriangularCovering.TriCylinder.unit_axis : ‖self.axis‖ = 1 OAI.TriangularCovering.TriCylinder.perpendicular : ∀ z ∈ self.base, inner ℝ self.axis z = 0 OAI.TriangularCovering.TriCylinder.triangular : ∃ v, AffineIndependent ℝ v ∧ self.base = (convexHull ℝ) (Set.range v) OAI.TriangularCovering.TriCylinder.compact : IsCompact self.base OAI.TriangularCovering.TriCylinder.convex : Convex ℝ self.base OAI.TriangularCovering.TriCylinder.measurable : MeasurableSet self.base OAI.TriangularCovering.TriCylinder.finite_area : (MeasureTheory.Measure.euclideanHausdorffMeasure 2) self.base ≠ ⊤ constructor: OAI.TriangularCovering.TriCylinder.mk (axis : OAI.TriangularCovering.Space) (base : Set OAI.TriangularCovering.Space) (unit_axis : ‖axis‖ = 1) (perpendicular : ∀ z ∈ base, inner ℝ axis z = 0) (triangular : ∃ v, AffineIndependent ℝ v ∧ base = (convexHull ℝ) (Set.range v)) (compact : IsCompact base) (convex : Convex ℝ base) (measurable : MeasurableSet base) (finite_area : (MeasureTheory.Measure.euclideanHausdorffMeasure 2) base ≠ ⊤) : OAI.TriangularCovering.TriCylinder def OAI.TriangularCovering.TriCylinder.carrier : OAI.TriangularCovering.TriCylinder → Set OAI.TriangularCovering.Space := fun c => {z | ∃ b ∈ c.base, ∃ r, z = b + r • c.axis} def OAI.TriangularCovering.Covers : {m : ℕ} → (Fin m → OAI.TriangularCovering.TriCylinder) → Prop := fun {m} c => ∀ z ∈ OAI.TriangularCovering.K, ∃ i, z ∈ (c i).carrier def OAI.TriangularCovering.totalArea : {m : ℕ} → (Fin m → OAI.TriangularCovering.TriCylinder) → ℝ := fun {m} c => ∑ i, OAI.TriangularCovering.area (c i).base def OAI.TriangularCovering.relativeCost : {m : ℕ} → (Fin m → OAI.TriangularCovering.TriCylinder) → ℝ := fun {m} c => ∑ i, OAI.TriangularCovering.area (c i).base / OAI.TriangularCovering.shadowArea (c i).axis def OAI.TriangularCovering.n : ℝ → ℕ := fun ε => ⌈2 / ε ^ 2⌉₊ def OAI.TriangularCovering.MainAsymptotic : Prop := ∃ δ C, 0 < δ ∧ 0 < C ∧ ∀ (ε : ℝ), 0 < ε → ε < δ → ∃ c, OAI.TriangularCovering.Covers c ∧ |OAI.TriangularCovering.totalArea c / OAI.TriangularCovering.H - (1 / 2 - 13 / 6000 * ε ^ 2)| ≤ C * ε ^ 4 ∧ OAI.TriangularCovering.totalArea c < OAI.TriangularCovering.A_min / 2 def OAI.TriangularCovering.NormalizedCounterexample : Prop := ∃ m c, OAI.TriangularCovering.Covers c ∧ OAI.TriangularCovering.relativeCost c < 1 / 2 