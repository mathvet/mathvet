OAI.Problem326.global_bounded_persistent_solution : ∀ (d : ℕ) (N : OAI.Problem326.ReactionNetwork d) (κ : OAI.Problem326.Reaction N → ℝ), 0 < d → OAI.Problem326.WeaklyReversible N → (∀ (e : OAI.Problem326.Reaction N), 0 < κ e) → ∀ (x0 : Fin d → ℝ), OAI.Problem326.PositiveState x0 → ∃ ε, 0 < ε ∧ ε < 1 ∧ (∃ x, OAI.Problem326.IsGlobalForwardSolution N κ x0 x) ∧ ∀ (x : ℝ → Fin d → ℝ), OAI.Problem326.IsGlobalForwardSolution N κ x0 x → ∀ (t : ℝ), 0 ≤ t → ∀ (i : Fin d), ε ≤ x t i ∧ x t i ≤ ε⁻¹ structure OAI.Problem326.ReactionNetwork (d : ℕ) : Type number of parameters: 1 fields: OAI.Problem326.ReactionNetwork.complexes : Finset (Fin d → ℕ) OAI.Problem326.ReactionNetwork.reactions : Finset ((Fin d → ℕ) × (Fin d → ℕ)) OAI.Problem326.ReactionNetwork.source_mem : ∀ e ∈ self.reactions, e.1 ∈ self.complexes OAI.Problem326.ReactionNetwork.target_mem : ∀ e ∈ self.reactions, e.2 ∈ self.complexes OAI.Problem326.ReactionNetwork.source_ne_target : ∀ e ∈ self.reactions, e.1 ≠ e.2 constructor: OAI.Problem326.ReactionNetwork.mk {d : ℕ} (complexes : Finset (Fin d → ℕ)) (reactions : Finset ((Fin d → ℕ) × (Fin d → ℕ))) (source_mem : ∀ e ∈ reactions, e.1 ∈ complexes) (target_mem : ∀ e ∈ reactions, e.2 ∈ complexes) (source_ne_target : ∀ e ∈ reactions, e.1 ≠ e.2) : OAI.Problem326.ReactionNetwork d @[reducible] def OAI.Problem326.Reaction : {d : ℕ} → OAI.Problem326.ReactionNetwork d → Type := fun {d} N => ↥N.reactions def OAI.Problem326.HasReaction : {d : ℕ} → OAI.Problem326.ReactionNetwork d → (Fin d → ℕ) → (Fin d → ℕ) → Prop := fun {d} N y z => (y, z) ∈ N.reactions def OAI.Problem326.WeaklyReversible : {d : ℕ} → OAI.Problem326.ReactionNetwork d → Prop := fun {d} N => ∀ (e : OAI.Problem326.Reaction N), Relation.TransGen (OAI.Problem326.HasReaction N) (↑e).2 (↑e).1 def OAI.Problem326.monomial : {d : ℕ} → (Fin d → ℝ) → (Fin d → ℕ) → ℝ := fun {d} x y => ∏ i, x i ^ y i def OAI.Problem326.massAction : {d : ℕ} → (N : OAI.Problem326.ReactionNetwork d) → (OAI.Problem326.Reaction N → ℝ) → (Fin d → ℝ) → Fin d → ℝ := fun {d} N κ x i => ∑ e, κ e * OAI.Problem326.monomial x (↑e).1 * (↑((↑e).2 i) - ↑((↑e).1 i)) def OAI.Problem326.PositiveState : {d : ℕ} → (Fin d → ℝ) → Prop := fun {d} x => ∀ (i : Fin d), 0 < x i def OAI.Problem326.IsGlobalForwardSolution : {d : ℕ} → (N : OAI.Problem326.ReactionNetwork d) → (OAI.Problem326.Reaction N → ℝ) → (Fin d → ℝ) → (ℝ → Fin d → ℝ) → Prop := fun {d} N κ x0 x => x 0 = x0 ∧ ∀ (t : ℝ), 0 ≤ t → HasDerivAt x (OAI.Problem326.massAction N κ (x t)) t 