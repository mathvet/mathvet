→ NNReal → ℂ) → MeasureTheory.Measure Ω → Prop := fun {Ω} [MeasurableSpace Ω] κ γ P => (∀ (t : NNReal), Measurable fun ω => γ ω t) ∧ ∃ B, ProbabilityTheory.IsBrownianReal B P ∧ ∀ᵐ (ω : Ω) ∂P, OAI.SLEExactGauge.IsCapacityTwoTrace (fun t => √κ * B t ω) (γ ω) structure OAI.SLEExactGauge.IsGauge (h : ℝ → ℝ) : Prop number of parameters: 1 fields: OAI.SLEExactGauge.IsGauge.continuousOn : ContinuousOn h (Set.Ici 0) OAI.SLEExactGauge.IsGauge.monotoneOn : MonotoneOn h (Set.Ici 0) OAI.SLEExactGauge.IsGauge.zero : h 0 = 0 OAI.SLEExactGauge.IsGauge.positive : ∀ (r : ℝ), 0 < r → 0 < h r constructor: OAI.SLEExactGauge.IsGauge.mk {h : ℝ → ℝ} (continuousOn : ContinuousOn h (Set.Ici 0)) (monotoneOn : MonotoneOn h (Set.Ici 0)) (zero : h 0 = 0) (positive : ∀ (r : ℝ), 0 < r → 0 < h r) : OAI.SLEExactGauge.IsGauge h def OAI.SLEExactGauge.hFormula : ℝ → ℝ → ℝ := fun κ r => r ^ OAI.SLEExactGauge.dimension κ * Real.log (Real.log (1 / r)) ^ (OAI.SLEExactGauge.codimension κ / ↑2) def OAI.SLEExactGauge.HasSmallRadiusFormula : (ℝ → ℝ) → (ℝ → ℝ) → Prop := fun h f => h =ᶠ[nhdsWithin 0 (Set.Ioi 0)] f def OAI.SLEExactGauge.extendedGauge : (ℝ → ℝ) → ENNReal → ENNReal := fun h r => ENNReal.ofReal (h r.toReal) def OAI.SLEExactGauge.hausdorffGauge : (ℝ → ℝ) → MeasureTheory.Measure ℂ := fun h => MeasureTheory.Measure.mkMetric (OAI.SLEExactGauge.extendedGauge h) def OAI.SLEExactGauge.segment : (NNReal → ℂ) → NNReal → NNReal → Set ℂ := fun γ s t => γ '' Set.Icc s t def OAI.SLEExactGauge.SourceLowerMainTarget.{v_lower} : Prop := ∀ (Ω : Type v_lower) (x : MeasurableSpace Ω) (P : MeasureTheory.Measure Ω), MeasureTheory.IsProbabilityMeasure P → ∀ (κ : ℝ), 0 < κ → κ < ↑8 → ∀ (γ : Ω → NNReal → ℂ), OAI.SLEExactGauge.IsOrdinaryChordalSLE κ γ P → ∀ (h : ℝ → ℝ), OAI.SLEExactGauge.IsGauge h → OAI.SLEExactGauge.HasSmallRadiusFormula h (OAI.SLEExactGauge.hFormula κ) → ∀ᵐ (ω : Ω) ∂P, ∀ (s t : NNReal), 0 < s → s < t → 0 < (OAI.SLEExactGauge.hausdorffGauge h) (OAI.SLEExactGauge.segment (γ ω) s t) 