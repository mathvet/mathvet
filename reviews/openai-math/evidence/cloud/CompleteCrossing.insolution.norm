OAI.Paper170.complete_graph_crossing_number : ∀ (order : ℕ), 3 ≤ order → OAI.Paper170.ordinaryCrossingNumber (OAI.Paper170.completeGraph order) = OAI.Paper170.hill order @[reducible] def OAI.Paper170.Plane : Type := ℝ × ℝ structure OAI.Paper170.Graph (Vertex Edge : Type) : Type number of parameters: 2 fields: OAI.Paper170.Graph.src : Edge → Vertex OAI.Paper170.Graph.dst : Edge → Vertex OAI.Paper170.Graph.loopless : ∀ (edge : Edge), self.src edge ≠ self.dst edge OAI.Paper170.Graph.simple : ∀ (edge other : Edge), self.src edge = self.src other ∧ self.dst edge = self.dst other ∨ self.src edge = self.dst other ∧ self.dst edge = self.src other → edge = other constructor: OAI.Paper170.Graph.mk {Vertex Edge : Type} (src dst : Edge → Vertex) (loopless : ∀ (edge : Edge), src edge ≠ dst edge) (simple : ∀ (edge other : Edge), src edge = src other ∧ dst edge = dst other ∨ src edge = dst other ∧ dst edge = src other → edge = other) : OAI.Paper170.Graph Vertex Edge @[reducible] def OAI.Paper170.CompleteEdge : ℕ → Type := fun order => { pair // pair.1 < pair.2 } def OAI.Paper170.completeGraph : (order : ℕ) → OAI.Paper170.Graph (Fin order) (OAI.Paper170.CompleteEdge order) := fun order => { src := fun edge => (↑edge).1, dst := fun edge => (↑edge).2, loopless := ⋯, simple := ⋯ } structure OAI.Paper170.ContinuousDrawing {Vertex Edge : Type} (graph : OAI.Paper170.Graph Vertex Edge) : Type number of parameters: 3 fields: OAI.Paper170.ContinuousDrawing.vertex : Vertex → OAI.Paper170.Plane OAI.Paper170.ContinuousDrawing.vertex_injective : Function.Injective self.vertex OAI.Paper170.ContinuousDrawing.edge : (edge : Edge) → Path (self.vertex (graph.src edge)) (self.vertex (graph.dst edge)) OAI.Paper170.ContinuousDrawing.edge_injective : ∀ (selected : Edge), Function.Injective ⇑(self.edge selected) OAI.Paper170.ContinuousDrawing.interior_avoids_vertices : ∀ (selected : Edge), ∀ time ∈ Set.Ioo 0 1, ∀ (other : Vertex), (self.edge selected) time ≠ self.vertex other constructor: OAI.Paper170.ContinuousDrawing.mk {Vertex Edge : Type} {graph : OAI.Paper170.Graph Vertex Edge} (vertex : Vertex → OAI.Paper170.Plane) (vertex_injective : Function.Injective vertex) (edge : (edge : Edge) → Path (vertex (graph.src edge)) (vertex (graph.dst edge))) (edge_injective : ∀ (selected : Edge), Function.Injective ⇑(edge selected)) (interior_avoids_vertices : ∀ (selected : Edge), ∀ time ∈ Set.Ioo 0 1, ∀ (other : Vertex), (edge selected) time ≠ vertex other) : OAI.Paper170.ContinuousDrawing graph def OAI.Paper170.edgeInterior : {Vertex Edge : Type} → {graph : OAI.Paper170.Graph Vertex Edge} → OAI.Paper170.ContinuousDrawing graph → Edge → Set OAI.Paper170.Plane := fun {Vertex Edge} {graph} drawing edge => ⇑(drawing.edge edge) '' Set.Ioo 0 1 structure OAI.Paper170.ProperCrossing (first second : Set OAI.Paper170.Plane) (point : OAI.Paper170.Plane) : Prop number of parameters: 3 fields: OAI.Paper170.ProperCrossing.chart_exists : ∃ chart, point ∈ chart.source ∧ ↑chart point = (0, 0) ∧ ↑chart '' (chart.source ∩ first) = chart.target ∩ {image | image.2 = 0} ∧ ↑chart '' (chart.source ∩ second) = chart.target ∩ {image | image.1 = 0} constructor: OAI.Paper170.ProperCrossing.mk {first second : Set OAI.Paper170.Plane} {point : OAI.Paper170.Plane} (chart_exists : ∃ chart, point ∈ chart.source ∧ ↑chart point = (0, 0) ∧ ↑chart '' (chart.source ∩ first) = chart.target ∩ {image | image.2 = 0} ∧ ↑chart '' (chart.source ∩ second) = chart.target ∩ {image | image.1 = 0}) : OAI.Paper170.ProperCrossing first second point def OAI.Paper170.crossingPoints : {Vertex Edge : Type} → {graph : OAI.Paper170.Graph Vertex Edge} → OAI.Paper170.ContinuousDrawing graph → Set OAI.Paper170.Plane := fun {Vertex Edge} {graph} drawing => {point | ∃ edge other, edge ≠ other ∧ point ∈ OAI.Paper170.edgeInterior drawing edge ∧ point ∈ OAI.Paper170.edgeInterior drawing other} structure OAI.Paper170.AdmissibleDrawing {Vertex Edge : Type} (graph : OAI.Paper170.Graph Vertex Edge) : Type number of parameters: 3 parents: OAI.Paper170.AdmissibleDrawing.toContinuousDrawing : OAI.Paper170.ContinuousDrawing graph fields: OAI.Paper170.ContinuousDrawing.vertex : Vertex → OAI.Paper170.Plane OAI.Paper170.ContinuousDrawing.vertex_injective : Function.Injective self.vertex OAI.Paper170.ContinuousDrawing.edge : (edge : Edge) → Path (self.vertex (graph.src edge)) (self.vertex (graph.dst edge)) OAI.Paper170.ContinuousDrawing.edge_injective : ∀ (selected : Edge), Function.Injective ⇑(self.edge selected) OAI.Paper170.ContinuousDrawing.interior_avoids_vertices : ∀ (selected : Edge), ∀ time ∈ Set.Ioo 0 1, ∀ (other : Vertex), (self.edge selected) time ≠ self.vertex other OAI.Paper170.AdmissibleDrawing.crossings_finite : (OAI.Paper170.crossingPoints self.toContinuousDrawing).Finite OAI.Paper170.AdmissibleDrawing.crossings_proper : ∀ (edge other : Edge), edge ≠ other → ∀ point ∈ OAI.Paper170.edgeInterior self.toContinuousDrawing edge, point ∈ OAI.Paper170.edgeInterior self.toContinuousDrawing other → OAI.Paper170.ProperCrossing (OAI.Paper170.edgeInterior self.toContinuousDrawing edge) (OAI.Paper170.edgeInterior self.toContinuousDrawing other) point OAI.Paper170.AdmissibleDrawing.no_triples : ∀ (first second third : Edge), first ≠ second → first ≠ third → second ≠ third → OAI.Paper170.edgeInterior self.toContinuousDrawing first ∩ OAI.Paper170.edgeInterior self.toContinuousDrawing second ∩ OAI.Paper170.edgeInterior self.toContinuousDrawing third = ∅ constructor: OAI.Paper170.AdmissibleDrawing.mk {Vertex Edge : Type} {graph : OAI.Paper170.Graph Vertex Edge} (toContinuousDrawing : OAI.Paper170.ContinuousDrawing graph) (crossings_finite : (OAI.Paper170.crossingPoints toContinuousDrawing).Finite) (crossings_proper : ∀ (edge other : Edge), edge ≠ other → ∀ point ∈ OAI.Paper170.edgeInterior toContinuousDrawing edge, point ∈ OAI.Paper170.edgeInterior toContinuousDrawing other → OAI.Paper170.ProperCrossing (OAI.Paper170.edgeInterior toContinuousDrawing edge) (OAI.Paper170.edgeInterior toContinuousDrawing other) point) (no_triples : ∀ (first second third : Edge), first ≠ second → first ≠ third → second ≠ third → OAI.Paper170.edgeInterior toContinuousDrawing first ∩ OAI.Paper170.edgeInterior toContinuousDrawing second ∩ OAI.Paper170.edgeInterior toContinuousDrawing third = ∅) : OAI.Paper170.AdmissibleDrawing graph field notation resolution order: OAI.Paper170.AdmissibleDrawing, OAI.Paper170.ContinuousDrawing def OAI.Paper170.crossingCount : {Vertex Edge : Type} → {graph : OAI.Paper170.Graph Vertex Edge} → OAI.Paper170.AdmissibleDrawing graph → ℕ := fun {Vertex Edge} {graph} drawing => ⋯.toFinset.card def OAI.Paper170.ordinaryCrossingNumber : {Vertex Edge : Type} → OAI.Paper170.Graph Vertex Edge → ℕ := fun {Vertex Edge} graph => sInf (Set.range OAI.Paper170.crossingCount) def OAI.Paper170.hill : ℕ → ℕ := fun order => order / 2 * ((order - 1) / 2) * ((order - 2) / 2) * ((order - 3) / 2) / 4 