OAI.FiniteAlgebraicEnvelopes.main : ∀ (GroupType : Type u_1) [inst : Group GroupType] [Group.FG GroupType], OAI.FiniteAlgebraicEnvelopes.HasDecidableWordProblem GroupType ↔ OAI.FiniteAlgebraicEnvelopes.EmbedsInFinitelyPresentedSimpleGroup GroupType @[reducible] def OAI.FiniteAlgebraicEnvelopes.Word : ℕ → Type := fun generatorCount => List (Fin generatorCount × Bool) def OAI.FiniteAlgebraicEnvelopes.evalWord.{u} : {GroupType : Type u} → [Group GroupType] → {generatorCount : ℕ} → (Fin generatorCount → GroupType) → OAI.FiniteAlgebraicEnvelopes.Word generatorCount → GroupType := fun {GroupType} [Group GroupType] {generatorCount} generators word => (List.map (fun letter => if letter.2 = true then generators letter.1 else (generators letter.1)⁻¹) word).prod def OAI.FiniteAlgebraicEnvelopes.HasDecidableWordProblem.{u} : (GroupType : Type u) → [Group GroupType] → Prop := fun GroupType [Group GroupType] => ∃ generatorCount generators, Subgroup.closure (Set.range generators) = ⊤ ∧ ComputablePred fun word => OAI.FiniteAlgebraicEnvelopes.evalWord generators word = 1 def OAI.FiniteAlgebraicEnvelopes.EmbedsInFinitelyPresentedSimpleGroup.{u} : (GroupType : Type u) → [Group GroupType] → Prop := fun GroupType [Group GroupType] => ∃ TargetGroup x, Group.IsFinitelyPresented TargetGroup ∧ IsSimpleGroup TargetGroup ∧ ∃ embedding, Function.Injective ⇑embedding 