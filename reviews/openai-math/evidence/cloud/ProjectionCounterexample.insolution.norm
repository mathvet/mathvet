OAI.ProjectionCounterexample.universal_simplex_upper_bound_false : ¬∀ (P : Set (OAI.ProjectionCounterexample.E 20)), OAI.ProjectionCounterexample.IsConvexBody P → OAI.ProjectionCounterexample.ratio P ≤ OAI.ProjectionCounterexample.ratio (OAI.ProjectionCounterexample.simplex 20) @[reducible] def OAI.ProjectionCounterexample.E : ℕ → Type := fun d => EuclideanSpace ℝ (Fin d) def OAI.ProjectionCounterexample.simplex : (d : ℕ) → Set (OAI.ProjectionCounterexample.E d) := fun d => (convexHull ℝ) (insert 0 (Set.range fun i => EuclideanSpace.single i 1)) def OAI.ProjectionCounterexample.IsConvexBody : {d : ℕ} → Set (OAI.ProjectionCounterexample.E d) → Prop := fun {d} P => IsCompact P ∧ Convex ℝ P ∧ (interior P).Nonempty def OAI.ProjectionCounterexample.project : {d : ℕ} → OAI.ProjectionCounterexample.E d → OAI.ProjectionCounterexample.E d →L[ℝ] OAI.ProjectionCounterexample.E d := fun {d} u => (ℝ ∙ u)ᗮ.starProjection def OAI.ProjectionCounterexample.projectionVolume : {d : ℕ} → Set (OAI.ProjectionCounterexample.E d) → OAI.ProjectionCounterexample.E d → ℝ := fun {d} P u => ((MeasureTheory.Measure.euclideanHausdorffMeasure (d - 1)) (⇑(OAI.ProjectionCounterexample.project u) '' P)).toReal def OAI.ProjectionCounterexample.projectionBody : {d : ℕ} → Set (OAI.ProjectionCounterexample.E d) → Set (OAI.ProjectionCounterexample.E d) := fun {d} P => {x | ∀ (u : OAI.ProjectionCounterexample.E d), ‖u‖ = 1 → inner ℝ u x ≤ OAI.ProjectionCounterexample.projectionVolume P u} def OAI.ProjectionCounterexample.bodyVolume : {d : ℕ} → Set (OAI.ProjectionCounterexample.E d) → ℝ := fun {d} P => (MeasureTheory.volume P).toReal def OAI.ProjectionCounterexample.ratio : {d : ℕ} → Set (OAI.ProjectionCounterexample.E d) → ℝ := fun {d} P => OAI.ProjectionCounterexample.bodyVolume (OAI.ProjectionCounterexample.projectionBody P) / OAI.ProjectionCounterexample.bodyVolume P ^ (d - 1) 