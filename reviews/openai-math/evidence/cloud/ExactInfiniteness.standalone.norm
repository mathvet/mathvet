(π.rightRep b)).completion, ⋯⟩ def OAI.WeakPureInfiniteness.minimalTensorSubalgebra.{u, v} : (A : Type u) → (B : Type v) → [inst : NonUnitalCStarAlgebra A] → [inst_1 : NonUnitalCStarAlgebra B] → NonUnitalStarSubalgebra ℂ (OAI.WeakPureInfiniteness.SpatialAmbient A B) := fun A B [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B] => (NonUnitalStarAlgebra.adjoin ℂ (Set.range fun p => OAI.WeakPureInfiniteness.spatialElementary p.1 p.2)).topologicalClosure @[reducible] def OAI.WeakPureInfiniteness.MinimalTensor.{u, v} : (A : Type u) → (B : Type v) → [inst : NonUnitalCStarAlgebra A] → [inst_1 : NonUnitalCStarAlgebra B] → NonUnitalStarSubalgebra ℂ (OAI.WeakPureInfiniteness.SpatialAmbient A B) := fun A B [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B] => OAI.WeakPureInfiniteness.minimalTensorSubalgebra A B def OAI.WeakPureInfiniteness.SpatialRepresentation.precompRight.{u, v} : {A : Type u} → {C D : Type v} → [inst : NonUnitalCStarAlgebra A] → [inst_1 : NonUnitalCStarAlgebra C] → [inst_2 : NonUnitalCStarAlgebra D] → OAI.WeakPureInfiniteness.SpatialRepresentation A D → (C →⋆ₙₐ[ℂ] D) → OAI.WeakPureInfiniteness.SpatialRepresentation A C := fun {A} {C D} [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra C] [NonUnitalCStarAlgebra D] π q => { left := π.left, right := π.right, leftRep := π.leftRep, rightRep := π.rightRep.comp q } def OAI.WeakPureInfiniteness.tensorKernelIdeal.{u, v} : {A : Type u} → {C D : Type v} → [inst : NonUnitalCStarAlgebra A] → [inst_1 : NonUnitalCStarAlgebra C] → [inst_2 : NonUnitalCStarAlgebra D] → (C →⋆ₙₐ[ℂ] D) → NonUnitalStarSubalgebra ℂ (OAI.WeakPureInfiniteness.SpatialAmbient A C) := fun {A} {C D} [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra C] [NonUnitalCStarAlgebra D] q => (NonUnitalStarAlgebra.adjoin ℂ {z | ∃ a c, q c = 0 ∧ z = OAI.WeakPureInfiniteness.spatialElementary a c}).topologicalClosure def OAI.WeakPureInfiniteness.Exact.{u} : (A : Type u) → [NonUnitalCStarAlgebra A] → Prop := fun A [NonUnitalCStarAlgebra A] => ∀ (C D : Type u) [inst_