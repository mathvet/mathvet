OAI.EilenbergGanea.source_main : Group.FG ↥OAI.EilenbergGanea.SourceGroup ∧ Group.ResiduallyFinite ↥OAI.EilenbergGanea.SourceGroup ∧ OAI.EilenbergGanea.cohomologicalDimension ↥OAI.EilenbergGanea.SourceGroup = 2 ∧ OAI.EilenbergGanea.HasClassifyingSpace (↥OAI.EilenbergGanea.SourceGroup) 3 ∧ ¬OAI.EilenbergGanea.HasClassifyingSpace (↥OAI.EilenbergGanea.SourceGroup) 2 def OAI.EilenbergGanea.seedWord : Bool → List (Bool × Bool) := fun x => match x with | false => [(false, true), (false, true), (true, false), (true, false), (true, false), (true, false), (true, false)] | true => [(false, true), (false, true), (true, true), (false, false), (true, true), (false, false), (true, true), (false, false)] def OAI.EilenbergGanea.boundaryLength : Bool → ℕ := fun relation => 3 * (OAI.EilenbergGanea.seedWord relation).length @[reducible] def OAI.EilenbergGanea.RoseVertex : Type := Option (Bool × Fin 2) @[reducible] def OAI.EilenbergGanea.SeedVertex : Type := OAI.EilenbergGanea.RoseVertex ⊕ Bool @[reducible] def OAI.EilenbergGanea.CircleEdge : Type := Bool × Fin 3 @[reducible] def OAI.EilenbergGanea.Sector : Type := (relation : Bool) × Fin (OAI.EilenbergGanea.boundaryLength relation) @[reducible] def OAI.EilenbergGanea.SeedEdge : Type := OAI.EilenbergGanea.CircleEdge ⊕ OAI.EilenbergGanea.Sector @[reducible] def OAI.EilenbergGanea.SeedCell : Type := OAI.EilenbergGanea.SeedVertex ⊕ OAI.EilenbergGanea.SeedEdge ⊕ OAI.EilenbergGanea.Sector def OAI.EilenbergGanea.circleStart : OAI.EilenbergGanea.CircleEdge → OAI.EilenbergGanea.RoseVertex := fun edge => ![none, some (edge.1, 0), some (edge.1, 1)] edge.2 def OAI.EilenbergGanea.circleEnd : OAI.EilenbergGanea.CircleEdge → OAI.EilenbergGanea.RoseVertex := fun edge => ![some (edge.1, 0), some (edge.1, 1), none] edge.2 def OAI.EilenbergGanea.sectorLetter : OAI.EilenbergGanea.Sector → Bool × Bool := fun sector => (OAI.EilenbergGanea.seedWord sector.fst).get ⟨↑sector.snd / 3, ⋯⟩ def OAI.EilenbergGanea.sectorCircleEdge : OAI.EilenbergGanea.Sector → OAI.EilenbergGanea.CircleEdge := fun sector => ((OAI.EilenbergGanea.sectorLetter sector).1, if (OAI.EilenbergGanea.sectorLetter sector).2 = true then ⟨↑sector.snd % 3, ⋯⟩ else ⟨2 - ↑sector.snd % 3, ⋯⟩) def OAI.EilenbergGanea.sectorStart : OAI.EilenbergGanea.Sector → OAI.EilenbergGanea.RoseVertex := fun sector => if (OAI.EilenbergGanea.sectorLetter sector).2 = true then OAI.EilenbergGanea.circleStart (OAI.EilenbergGanea.sectorCircleEdge sector) else OAI.EilenbergGanea.circleEnd (OAI.EilenbergGanea.sectorCircleEdge sector) def OAI.EilenbergGanea.nextSector : OAI.EilenbergGanea.Sector → OAI.EilenbergGanea.Sector := fun sector => ⟨sector.fst, ⟨(↑sector.snd + 1) % OAI.EilenbergGanea.boundaryLength sector.fst, ⋯⟩⟩ def OAI.EilenbergGanea.edgeVertices : OAI.EilenbergGanea.SeedEdge → Finset OAI.EilenbergGanea.SeedVertex := fun x => match x with | Sum.inl edge => {Sum.inl (OAI.EilenbergGanea.circleStart edge), Sum.inl (OAI.EilenbergGanea.circleEnd edge)} | Sum.inr sector => {Sum.inr sector.fst, Sum.inl (OAI.EilenbergGanea.sectorStart sector)} def OAI.EilenbergGanea.sectorEdges : OAI.EilenbergGanea.Sector → Finset OAI.EilenbergGanea.SeedEdge := fun sector => {Sum.inl (OAI.EilenbergGanea.sectorCircleEdge sector), Sum.inr sector, Sum.inr (OAI.EilenbergGanea.nextSector sector)} def OAI.EilenbergGanea.sectorVertices : OAI.EilenbergGanea.Sector → Finset OAI.EilenbergGanea.SeedVertex := fun sector => (OAI.EilenbergGanea.sectorEdges sector).biUnion OAI.EilenbergGanea.edgeVertices def OAI.EilenbergGanea.properFace : OAI.EilenbergGanea.SeedCell → OAI.EilenbergGanea.SeedCell → Prop := fun x x_1 => match x, x_1 with | Sum.inl vertex, Sum.inr (Sum.inl edge) => vertex ∈ OAI.EilenbergGanea.edgeVertices edge | Sum.inl vertex, Sum.inr (Sum.inr sector) => vertex ∈ OAI.EilenbergGanea.sectorVertices sector | Sum.inr (Sum.inl edge), Sum.inr (Sum.inr sector) => edge ∈ OAI.EilenbergGanea.sectorEdges sector | x, x_2 => False def OAI.EilenbergGanea.seedGraph : SimpleGraph OAI.EilenbergGanea.SeedCell := { Adj := fun first second => OAI.EilenbergGanea.properFace first second ∨ OAI.EilenbergGanea.properFace second first, symm := OAI.EilenbergGanea.seedGraph._proof_1, loopless := OAI.EilenbergGanea.seedGraph._proof_2 } def OAI.EilenbergGanea.artinRelations.{u_1} : {Vertex : Type u_1} → SimpleGraph Vertex → Set (FreeGroup Vertex) := fun {Vertex} graph => {word | ∃ first second, graph.Adj first second ∧ word = FreeGroup.of first * FreeGroup.of second * (FreeGroup.of first)⁻¹ * (FreeGroup.of second)⁻¹} @[reducible] def OAI.EilenbergGanea.ArtinGroup.{u_1} : {Vertex : Type u_1} → SimpleGraph Vertex → Type u_1 := fun {Vertex} graph => PresentedGroup (OAI.EilenbergGanea.artinRelations graph) def OAI.EilenbergGanea.height.{u_1} : {Vertex : Type u_1} → (graph : SimpleGraph Vertex) → OAI.EilenbergGanea.ArtinGroup graph →* Multiplicative ℤ := fun {Vertex} graph => PresentedGroup.toGroup ⋯ @[reducible] def OAI.EilenbergGanea.SourceGroup : Subgroup (OAI.EilenbergGanea.ArtinGroup OAI.EilenbergGanea.seedGraph) := (OAI.EilenbergGanea.height OAI.EilenbergGanea.seedGraph).ker def OAI.EilenbergGanea.cohomologicalDimension.{u_1} : (GroupType : Type u_1) → [Group GroupType] → WithBot ℕ∞ := fun GroupType [Group GroupType] => CategoryTheory.projectiveDimension ↧(Representation.trivial ℤ GroupType ℤ).asModule def OAI.EilenbergGanea.HasClassifyingSpace.{u, u_1} : (GroupType : Type u_1) → [Group GroupType] → ℕ → Prop := fun GroupType [Group GroupType] dimension => ∃ Space x, ∃ (_ : T2Space Space), ∃ x_2, (∀ (degree : ℕ), dimension < degree → IsEmpty (Topology.CWComplex.cell Set.univ degree)) ∧ PathConnectedSpace Space ∧ ∃ basepoint, Nonempty (FundamentalGroup Space basepoint ≃* GroupType) ∧ ∃ Cover x_3, ContractibleSpace Cover ∧ ∃ projection, IsCoveringMap projection ∧ Function.Surjective projection 