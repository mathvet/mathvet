OAI.RyserOdd.eventualOddFailures_and_infinite : (∃ primeThreshold, ∀ (prime : ℕ), primeThreshold ≤ prime → Nat.Prime prime → prime % 3 = 2 → ∃ degreeThreshold, 3 ≤ degreeThreshold ∧ ∀ (degree : ℕ), degreeThreshold ≤ degree → Odd degree → OAI.RyserOdd.Specification.ExplicitFailureAt (prime ^ degree + 1)) ∧ {rank | OAI.RyserOdd.Specification.ExplicitFailureAt rank}.Infinite @[reducible] def OAI.RyserCoveringCounterexample.Hypergraph.{u_1} : Type u_1 → Type u_1 := fun Vertex => Finset (Finset Vertex) def OAI.RyserCoveringCounterexample.IsCover.{u_1} : {Vertex : Type u_1} → OAI.RyserCoveringCounterexample.Hypergraph Vertex → Finset Vertex → Prop := fun {Vertex} hypergraph cover => ∀ edge ∈ hypergraph, ∃ vertex ∈ cover, vertex ∈ edge def OAI.RyserCoveringCounterexample.Intersecting.{u_1} : {Vertex : Type u_1} → [DecidableEq Vertex] → OAI.RyserCoveringCounterexample.Hypergraph Vertex → Prop := fun {Vertex} [DecidableEq Vertex] hypergraph => ∀ edge ∈ hypergraph, ∀ other ∈ hypergraph, edge ≠ other → (edge ∩ other).Nonempty def OAI.RyserCoveringCounterexample.matchings.{u_1} : {Vertex : Type u_1} → OAI.RyserCoveringCounterexample.Hypergraph Vertex → Finset (OAI.RyserCoveringCounterexample.Hypergraph Vertex) := fun {Vertex} hypergraph => {matching ∈ Finset.powerset hypergraph | (↑matching).Pairwise Disjoint} def OAI.RyserCoveringCounterexample.matchingNumber.{u_1} : {Vertex : Type u_1} → OAI.RyserCoveringCounterexample.Hypergraph Vertex → ℕ := fun {Vertex} hypergraph => (OAI.RyserCoveringCounterexample.matchings hypergraph).sup Finset.card def OAI.RyserCoveringCounterexample.coverCardinalities.{u_1} : {Vertex : Type u_1} → OAI.RyserCoveringCounterexample.Hypergraph Vertex → Set ℕ := fun {Vertex} hypergraph => {size | ∃ cover, OAI.RyserCoveringCounterexample.IsCover hypergraph cover ∧ cover.card = size} def OAI.RyserCoveringCounterexample.coverNumber.{u_1} : {Vertex : Type u_1} → OAI.RyserCoveringCounterexample.Hypergraph Vertex → ℕ := fun {Vertex} hypergraph => sInf (OAI.RyserCoveringCounterexample.coverCardinalities hypergraph) def OAI.RyserCoveringCounterexample.Uniform.{u_1} : {Vertex : Type u_1} → ℕ → OAI.RyserCoveringCounterexample.Hypergraph Vertex → Prop := fun {Vertex} rank hypergraph => ∀ edge ∈ hypergraph, edge.card = rank def OAI.RyserCoveringCounterexample.PartiteUniform.{u_1, u_2} : {Vertex : Type u_1} → {Index : Type u_2} → (Vertex → Index) → OAI.RyserCoveringCounterexample.Hypergraph Vertex → Prop := fun {Vertex} {Index} part hypergraph => ∀ edge ∈ hypergraph, ∀ (index : Index), ∃! vertex, vertex ∈ edge ∧ part vertex = index def OAI.RyserCoveringCounterexample.RPartiteUniform.{u_1} : {Vertex : Type u_1} → ℕ → OAI.RyserCoveringCounterexample.Hypergraph Vertex → Prop := fun {Vertex} rank hypergraph => ∃ part, OAI.RyserCoveringCounterexample.PartiteUniform part hypergraph def OAI.RyserOdd.Specification.ExplicitFailureAt : ℕ → Prop := fun rank => ∃ Vertex finiteVertices decidableVertices hypergraph, 0 < rank ∧ Finset.Nonempty hypergraph ∧ OAI.RyserCoveringCounterexample.RPartiteUniform rank hypergraph ∧ OAI.RyserCoveringCounterexample.Uniform rank hypergraph ∧ OAI.RyserCoveringCounterexample.Intersecting hypergraph ∧ (∃ cover, OAI.RyserCoveringCounterexample.IsCover hypergraph cover) ∧ OAI.RyserCoveringCounterexample.matchingNumber hypergraph = 1 ∧ OAI.RyserCoveringCounterexample.coverNumber hypergraph = rank ∧ (rank - 1) * OAI.RyserCoveringCounterexample.matchingNumber hypergraph < OAI.RyserCoveringCounterexample.coverNumber hypergraph 