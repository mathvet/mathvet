OAI.Ostmann.inverseGoldbach : OAI.Ostmann.InverseGoldbach OAI.Ostmann.twoInfiniteSummandsImpossible : OAI.Ostmann.TwoInfiniteSummandsImpossible def OAI.Ostmann.primes : Set ℕ := {n | Nat.Prime n} @[reducible] def OAI.Ostmann.sumset : Set ℕ → Set ℕ → Set ℕ := fun A B => A + B def OAI.Ostmann.EventuallyPrimeSumset : Set ℕ → Set ℕ → Prop := fun A B => ∃ N, ∀ (n : ℕ), N ≤ n → (n ∈ OAI.Ostmann.sumset A B ↔ Nat.Prime n) def OAI.Ostmann.TwoInfiniteSummandsImpossible : Prop := ∀ (A B : Set ℕ), A.Infinite → B.Infinite → ¬OAI.Ostmann.EventuallyPrimeSumset A B def OAI.Ostmann.InverseGoldbach : Prop := ∀ (A B : Set ℕ), A.Nontrivial → B.Nontrivial → (symmDiff (OAI.Ostmann.sumset A B) OAI.Ostmann.primes).Infinite 